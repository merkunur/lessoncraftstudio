  "strings": {
    "G1-307": {
      "title": "Antónimos: escribe la palabra contraria",
      "instruction": "Lee la palabra de cada tarjeta. Busca su antónimo en el banco de palabras y escríbelo en la línea."
    },
    "K-351": {
      "title": "Antónimos con dibujos: une los contrarios",
      "instruction": "Traza una línea desde cada dibujo hasta el dibujo y la palabra que muestran su contrario."
    },
    "G1-335": {
      "title": "Antónimos en oraciones",
      "instruction": "Lee cada oración. Escribe en la línea el antónimo de la palabra que va después de \"no\". El banco de palabras te ayuda."
    },
    "G1-336": {
      "title": "Forma las parejas de antónimos",
      "instruction": "Encuentra las dos palabras que son contrarias. Escribe cada pareja en una línea, una palabra a cada lado de la flecha."
    },
    "G1-337": {
      "title": "¿Sinónimo o antónimo? Rodea el antónimo",
      "instruction": "Lee la palabra. De las tres palabras de abajo, una significa lo contrario. Rodéala, no la que significa lo mismo."
    },
    "G2-320": {
      "title": "Antónimos con prefijos: in-, im- y des-",
      "instruction": "Agrega el prefijo a cada palabra y escribe en la línea la nueva palabra contraria."
    }
  }
