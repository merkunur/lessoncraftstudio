        }
      ],
      "narration": [
        {
          "text": "Bo dragged the big square crate under the cart to try it as a wheel."
        },
        {
          "text": "Bump, bump, bump — the crate would not roll at all."
        },
        {
          "characterId": "bo",
          "text": "\"Square things just sit flat,\" puffed Bo."
        },
        {
          "characterId": "pip",
          "text": "\"Round things roll,\" said Pip. \"Which shape is round, like the wheel?\""
        }
      ],
