  "strings": {
    "K-318": {
      "title": "Lydkasser: skriv lyd for lyd",
      "instruction": "Sig ordet til billedet langsomt. Skriv én lyd i hver kasse. En bred kasse med en bue under rummer to bogstaver, der giver én lyd."
    },
    "K-329": {
      "title": "Tæl lydene i ordet",
      "instruction": "Sig ordet langsomt. Tegn én prik i den lange kasse for hver lyd, du hører. Skriv så antallet i den lille kasse."
    },
    "K-330": {
      "title": "Lydkasser med den første lyd givet",
      "instruction": "Den første lyd er skrevet. Sig ordet langsomt, og skriv én lyd i hver tom kasse. En bred kasse rummer to bogstaver til én lyd."
    },
    "G1-312": {
      "title": "Lydstrimmel: hvor mange lyde?",
      "instruction": "Sig ordet langsomt. Skriv én lyd i hver kasse fra venstre. Lad de kasser stå tomme, som du ikke skal bruge."
    },
    "G1-313": {
      "title": "Stavelser og lyde",
      "instruction": "Klap ordets stavelser. Sig så hver stavelse langsomt, og skriv én lyd i hver kasse under buen."
    },
    "G1-314": {
      "title": "Lyd ordet sammen, og find billedet",
      "instruction": "Læs lydene i kasserne, og lyd dem sammen til et ord. Sæt en ring om det billede, der passer."
    }
  }
