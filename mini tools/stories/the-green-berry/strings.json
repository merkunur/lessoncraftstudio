  "p01-l01": {
    "en": "The Meadow Fair was coming, and Bramble the bear was making jam.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l02": {
    "en": "Three jars with bright lids waited on his table: red, blue, and yellow.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l03": {
    "en": "\"One jar for every color,\" said Bramble proudly.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l04": {
    "en": "Then his big foot caught a root. BUMP! The fruit basket tumbled everywhere!",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l05": {
    "en": "\"Oh my,\" said Pip. \"Colors will help us. Every fruit has a color home.\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l01": {
    "en": "Red strawberries were hiding in the tall green grass.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l02": {
    "en": "\"Red goes with red,\" said Bramble, holding up the red jar.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l03": {
    "en": "Some blueberries were hiding there too. Those are not red!",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l04": {
    "en": "Can you find every red strawberry?",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l01": {
    "en": "One round blueberry rolled all the way to Pip's feet.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l02": {
    "en": "\"Blue belongs with blue,\" said Pip.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l03": {
    "en": "The blue jar waited on the shelf, right above the red one.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l04": {
    "en": "Can you put the blueberry into the blue jar?",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l01": {
    "en": "Bramble stirred a big pot and did not look up.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l02": {
    "en": "\"Lemon, please!\" he called. \"The YELLOW one!\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l03": {
    "en": "Two fruits sat by the pot: a sunny lemon and a red strawberry.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l04": {
    "en": "\"Listen well,\" giggled Pip. \"Which one does Bramble need?\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l01": {
    "en": "Bramble reached for the last strawberries in the grass.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l02": {
    "en": "But wait. One of them did not look like the others.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l03": {
    "en": "\"How funny,\" said Bramble. \"One strawberry is not red at all.\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l04": {
    "en": "\"Find it,\" whispered Pip. \"Which one is green?\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l01": {
    "en": "\"It fits no jar,\" sighed Bramble. \"Where does it belong?\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l02": {
    "en": "\"It is not red YET,\" said Pip. \"Little green berries are still growing.\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l03": {
    "en": "The strawberry plant stood in the warmest, sunniest corner of the garden.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l04": {
    "en": "Can you put the green berry back on its sunny plant?",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l01": {
    "en": "Back at the table, the jam pot bubbled and steamed.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l02": {
    "en": "\"The last red strawberries go in the pot,\" said Bramble.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l03": {
    "en": "\"Red with red, one by one,\" said Pip.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l04": {
    "en": "Tap every red strawberry into the pot!",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l01": {
    "en": "At last it was Meadow Fair day.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l02": {
    "en": "Three bright jars stood in a row: red, blue, and yellow.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l03": {
    "en": "Friends came from every path to taste the jam.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l04": {
    "en": "\"Mmm-mm!\" said Bramble, patting his tummy. \"Every color found its home.\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l01": {
    "en": "That evening, the sun set soft and golden over the garden.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l02": {
    "en": "\"Look,\" said Pip softly, and led him to the plant.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l03": {
    "en": "The little green berry had turned rosy red at last.",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l04": {
    "en": "\"Every berry finds its color,\" smiled Bramble, \"in its own time.\"",
    "de": "",
    "fr": "",
    "es": "",
    "pt": "",
    "it": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
