      "title": "Motsatsord: skriv motsatsen",
      "instruction": "Läs ordet på varje kort. Hitta motsatsordet i ordbanken och skriv det på raden."
    },
    "K-351": {
      "title": "Motsatser med bilder: para ihop",
      "instruction": "Dra ett streck från varje bild till den bild och det ord som visar motsatsen."
    },
    "G1-335": {
      "title": "Motsatsord i meningar",
      "instruction": "Läs varje mening. Skriv motsatsen till ordet efter \"inte\" på raden. Ordbanken hjälper dig."
    },
    "G1-336": {
      "title": "Para ihop motsatsorden",
      "instruction": "Hitta de två ord som är motsatser. Skriv varje par på en rad, ett ord på varje sida om pilen."
    },
    "G1-337": {
      "title": "Motsats eller samma sak? Ringa in motsatsen",
      "instruction": "Läs ordet. Ett av de tre orden under betyder motsatsen. Ringa in det, inte det som betyder samma sak."
    },
    "G2-320": {
      "title": "Motsatsord med förstavelsen o-",
      "instruction": "Sätt o- framför varje ord och skriv det nya motsatsordet på raden."
