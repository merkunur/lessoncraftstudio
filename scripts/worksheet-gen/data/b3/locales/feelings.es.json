      "title": "Las emociones: une cada cara con su palabra",
      "instruction": "Traza una línea desde cada cara hasta la palabra que dice cómo se siente."
    },
    "K-331": {
      "title": "¿Cómo te sientes? Rodea la cara",
      "instruction": "Mira el dibujo, piensa cómo te sentirías tú y rodea la cara que corresponde."
    },
    "K-332": {
      "title": "Dibuja la cara de la emoción",
      "instruction": "Lee la palabra y dibuja en el círculo vacío una cara que muestre esa emoción."
    },
    "K-333": {
      "title": "¿Agradable o desagradable? Clasifica las caras",
      "instruction": "Traza una línea desde cada cara hasta la caja que dice si esa emoción se siente agradable o desagradable."
    },
    "K-334": {
      "title": "¿Qué cara muestra la emoción?",
      "instruction": "Lee la palabra y rodea la única cara de la fila que muestra esa emoción."
    },
    "K-335": {
      "title": "¿Cómo me siento hoy?",
      "instruction": "Rodea la cara que muestra cómo te sientes hoy y después dibuja tu propia cara."
    }
