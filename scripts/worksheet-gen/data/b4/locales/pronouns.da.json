    "anaphora": {
      "title": "Hvem menes der? Stedord i sætninger",
      "instruction": "Læs sætningerne. Tegn en streg fra hvert ord i en kasse til det navn, det står for."
    },
    "possessive": {
      "title": "Ejestedord: hans, hendes eller deres",
      "instruction": "Se hvem tingen tilhører. Sæt ring om det ord, der viser, at den hører til den person."
    },
    "sort": {
      "title": "Sortér navnene: han, hun eller de",
      "instruction": "Læs hvert navnekort. Skriv navnet under det ord, vi bruger om den person."
    },
    "rewrite": {
      "title": "Skriv sætningen om med et stedord",
