    "K-319": {
      "title": "Les émotions : relie chaque visage à son mot",
      "instruction": "Trace un trait de chaque visage jusqu'au mot qui dit ce qu'il ressent."
    },
    "K-331": {
      "title": "Comment te sens-tu ? Entoure le visage",
      "instruction": "Regarde l'image, pense à ce que tu ressentirais, puis entoure le visage qui correspond."
    },
    "K-332": {
      "title": "Dessine le visage de l'émotion",
      "instruction": "Lis le mot de l'émotion et dessine, dans le rond vide, un visage qui la montre."
    },
    "K-333": {
      "title": "Agréable ou désagréable ? Trie les visages",
      "instruction": "Relie chaque visage à la boîte qui dit si l'émotion est agréable ou désagréable."
    },
    "K-334": {
      "title": "Quel visage montre l'émotion ?",
      "instruction": "Lis le mot de l'émotion et entoure, dans la ligne, le seul visage qui la montre."
    },
    "K-335": {
      "title": "Comment je me sens aujourd'hui ?",
      "instruction": "Entoure le visage qui montre comment tu te sens aujourd'hui, puis dessine ton propre visage."
    }
