  "strings": {
    "base": {
      "title": "I pronomi personali soggetto",
      "instruction": "Guarda la persona e leggi il nome. Cerchia la parola che usiamo al posto del nome.",
      "note": "Il pannello sceglie lui / lei / loro, le forme che un bambino di classe prima e seconda usa davvero; egli / ella restano una nota di grammatica per la scuola secondaria e non compaiono in nessuna pagina."
    },
    "replace": {
      "title": "Sostituisci il nome con un pronome",
      "instruction": "Leggi la frase. Scrivi la parola del riquadro che sostituisce il nome nella seconda frase.",
      "bankWord": "riquadro"
    },
    "anaphora": {
      "title": "Chi è? Il pronome nella frase",
      "instruction": "Leggi le frasi. Unisci con una linea ogni parola nella casella al nome che rappresenta."
    },
    "possessive": {
      "title": "Suo, sua o loro?",
      "instruction": "Guarda di chi è la cosa. Cerchia la parola che mostra a chi appartiene."
    },
    "sort": {
      "title": "Ordina i nomi: lui, lei o loro",
      "instruction": "Leggi ogni cartellino con il nome. Scrivi il nome sotto la parola che usiamo per quella persona."
    },
    "rewrite": {
      "title": "Riscrivi la frase con un pronome",
      "instruction": "Leggi la frase. Riscrivila sulle righe, ma usa un pronome al posto del nome."
    }
  }
}
