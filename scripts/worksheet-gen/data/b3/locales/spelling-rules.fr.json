  "strings": {
    "G2-315": {
      "title": "Règles d'orthographe : {UNIT}",
      "instruction": "Lis la règle dans le cadre. Dis le mot de chaque image, puis écris les lettres qui manquent dans les cases en pointillés."
    },
    "G2-324": {
      "title": "Complète avec {UNIT}",
      "instruction": "Regarde l'image et lis le mot. Entoure la bonne lettre sous le mot, puis écris-la dans la case en pointillés."
    },
    "G2-325": {
      "title": "Entoure la règle : {UNIT}",
      "instruction": "Lis chaque mot. Trouve les lettres de la règle, entoure-les dans le mot, puis recopie-les dans la petite case."
    },
    "G2-326": {
      "title": "Trie les mots : {UNIT}",
      "instruction": "Dis le mot de chaque image. Écris-le dans la colonne de son orthographe, un mot par ligne."
    },
    "G2-327": {
      "title": "Écris le mot entier : {UNIT}",
      "instruction": "Les lettres de la règle sont écrites en orange. Dis le mot de l'image et écris toutes les autres lettres dans les cases."
    },
    "G2-328": {
      "title": "{UNIT} : bateau, bateaux",
      "instruction": "Lis le mot au singulier. Écris le mot au pluriel dans les cases : au pluriel, l'orthographe change."
    }
