  "strings": {
    "G1-309": {
      "title": "Mots qui riment : entoure et écris",
      "instruction": "Dis le nom de la première image. Entoure l'image qui rime avec elle, puis écris son nom sur la ligne."
    },
    "K-352": {
      "title": "Les rimes en maternelle : ça rime ou pas ?",
      "instruction": "Dis les deux mots à voix haute. S'ils riment, entoure la coche. S'ils ne riment pas, entoure la croix."
    },
    "G1-343": {
      "title": "Familles de rimes : trie les images",
      "instruction": "Dis le nom de chaque image de la banque. Trouve la grande image qui rime avec elle et écris son nom sur une ligne dessous."
    },
    "G1-344": {
      "title": "Complète la comptine : trouve la rime",
      "instruction": "Lis les deux vers à voix haute. Regarde l'image, écoute la rime et écris le mot qui manque sur la ligne."
    },
    "G1-345": {
      "title": "Chaînes de rimes : deux mots qui riment",
      "instruction": "Dis le nom de chaque image. Trouve dans la banque les deux mots qui riment avec elle et écris-les. Certains mots ne vont nulle part."
    },
    "G1-346": {
      "title": "Trouve tes rimes : écris deux mots",
      "instruction": "Lis le mot à côté de chaque image. Pense à deux mots qui riment avec lui et écris-en un sur chaque ligne."
    }
  }
