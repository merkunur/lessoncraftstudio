  "strings": {
    "G2-315": {
      "title": "Staveregler: {UNIT}",
      "instruction": "Læs reglen i kassen. Sig ordet til hvert billede, og skriv så de bogstaver, reglen handler om, i de stiplede kasser."
    },
    "G2-324": {
      "title": "Hvilken stavemåde? {UNIT}",
      "instruction": "Se på billedet, og læs ordet. Sæt ring om de rigtige bogstaver under det, og skriv dem i den stiplede kasse."
    },
    "G2-325": {
      "title": "Stavedetektiv: {UNIT}",
      "instruction": "Læs hvert ord. Find regelbogstaverne, sæt ring om dem i ordet, og skriv dem så i den lille kasse."
    },
    "G2-326": {
      "title": "Sortér efter staveregel: {UNIT}",
      "instruction": "Sig ordet til hvert billede. Skriv det i kassen med dets stavemåde, ét ord på hver linje."
    },
    "G2-327": {
      "title": "Skriv hele ordet: {UNIT}",
      "instruction": "Regelbogstaverne står med orange. Sig ordet til billedet, og skriv alle de andre bogstaver i kasserne."
    },
    "G2-328": {
      "title": "Flertal ændrer stavemåden: {UNIT}",
      "instruction": "Læs ordet for én. Skriv ordet for flere i kasserne. Flertallet ændrer stavemåden."
    }
  }
