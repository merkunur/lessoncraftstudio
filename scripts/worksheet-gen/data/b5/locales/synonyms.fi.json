  "strings": {
    "base": {
      "title": "Synonyymit: rengasta sana, joka tarkoittaa samaa",
      "instruction": "Lue jokaisen kortin iso sana ja rengasta sen alta sana, joka tarkoittaa samaa."
    },
    "pictures": {
      "title": "Synonyymit kuvien avulla: kaksi sanaa, yksi kuva",
      "instruction": "Katso jokaista kuvaa ja rengasta sen alta kaksi sanaa, jotka tarkoittavat samaa ja sopivat kuvaan."
    },
    "pairs": {
      "title": "Synonyymiparit: yhdistä samaa tarkoittavat sanat",
      "instruction": "Yhdistä viivalla jokainen vasemman puolen sana siihen oikean puolen sanaan, joka tarkoittaa samaa."
    },
    "shades": {
      "title": "Sanojen voimakkuus: heikoimmasta voimakkaimpaan",
      "instruction": "Lue rivin kolme sanaa ja kirjoita ruutuihin 1, 2 ja 3 heikoimmasta sanasta voimakkaimpaan."
    },
    "say": {
      "title": "Sanoi-sanan synonyymit: valitse sopiva sana",
      "instruction": "Lue jokainen lause ja kirjoita ruutuun puhekuplasta se sana, joka sopii parhaiten sanan sanoi tilalle."
    },
    "fields": {
      "title": "Mennä ja katsoa: lajittele synonyymit",
      "instruction": "Lue kymmenen sanaa ja kirjoita jokainen sana joko mennä-kenttään tai katsoa-kenttään sen mukaan, mihin se kuuluu."
    }
  }
