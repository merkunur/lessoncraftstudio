  "blankTitle": "Vorlage",
  "strings": {
    "G2-318": {
      "title": "Tiersteckbrief: {U}",
      "instruction": "Finde heraus, was du über dieses Tier weißt. Schreibe in jede Zeile des Steckbriefs eine Angabe und fülle den Rest der Seite mit Bild oder Wörtern."
    },
    "G2-339": {
      "title": "Steckbrief {U}: Kreuze an, was stimmt",
      "instruction": "Lies die Auswahl in jeder Zeile und kreise das ein, was für dieses Tier stimmt. Zeichne dann, wo es lebt, und vervollständige den Satz."
    },
    "G2-340": {
      "title": "Steckbrief {U} mit Wortliste",
      "instruction": "Suche jede richtige Angabe in der Wortliste und schreibe sie in die passende Zeile des Steckbriefs. Vervollständige dann den Satz unten."
    },
    "G2-341": {
      "title": "Steckbrief {U}: Schreibe drei Sätze",
      "instruction": "Lies den Steckbrief. Vervollständige die drei Sätze mit Angaben daraus und schreibe auf die letzte Linie eine eigene Angabe."
    },
    "G2-342": {
      "title": "Zwei Tiere vergleichen: gleich oder verschieden?",
      "instruction": "Lies beide Steckbriefe. Kreise bei jeder Angabe gleich oder verschieden ein. Schreibe dann zwei Gemeinsamkeiten und zwei Unterschiede."
    },
    "G2-343": {
      "title": "Wer bin ich? Das Rätseltier",
      "instruction": "Lies die fünf Hinweise auf jeder Karte. Finde das Tier in der Bildleiste, schreibe seinen Namen auf die Linie und zeichne es in den Kasten."
    }
  }
}
