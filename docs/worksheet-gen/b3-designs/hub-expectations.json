 "notes": {
  "letter-of-the-week": "F3 fi = syllable mode; F5 units per locale (≥3 or refuse)",
  "sound-boxes": "da G1-313 refused (panel: \"én lyd = én kasse\" — a double consonant is ONE box, so the TeX boundary cannot print); da K faces ship on 2 themes (strict pool)",
  "syllable-split": "en: Scramble + Vowel King refused (no TeX boundaries / silent e); fr: Vowel King refused (mute e)",
  "syllable-reading": "fr Complex = one page; no/da/sv base seed-only",
  "spelling-rules": "F6 plural refused de (Umlaut changes the stem, not the ending), nl (plural IS the base), sv, no (inflection, below floor)",
  "opposites": "contingent: F4 if `syn` < 8; F5 if prefix items < 8",
  "compound-words": "F1 joint (G2-329) refused en/es/pt/it/nl/sv/fi (fi: no joining letter, the -n is a genitive) (no linking letter in family form; nl only 5 under the cap); F3 match (G2-331) refused fr/it/pt/es (the second part is a suffix without a picture); pt F2 cut (G2-330) refused (7 pictured augment./dimin., floor 8); F5 default refused fr",
  "verb-forms": "nl F2 (G2-336) refused by the panel: zijn/hebben have only three present forms that differ from the infinitive",
  "read-and-do": "sv/da/no `def` (+`defPl`) tables authored by the panels — all six faces ship",
  "rhyming-words": "de F4 ships (the panel authored a 4th class by sound); it F4 (G1-345) refused: Italian rhyme words run 7–10 letters, the 12-word box measures 1427 px",
  "feelings": "global syringe veto changes F1's card count, not the row",
  "animal-fact-file": "PREREQUISITE `animal-facts.json`; sv/da/no/fi need one exemplar `def`/`ade`; a wave theme with <4 verifiable animals drops F6",
  "hundreds-chart-puzzles": "none (F3 is language-free)",
  "division-with-remainder": "none; F3 lowers only where a panel refuses `exactWord`",
  "ordinal-numbers": "none; F5 racers themes only (8)",
  "days-and-months": "none",
  "all-about-me": "none; F1 pools clear the global 96 px gate (colours 7 everywhere)",
  "seasons": "pt-BR F5 re-targets to `figure:'frame'` or refuses",
  "logic-puzzles": "none designed",
  "picture-word-cards": "fi F3 article cards refused (no articles); no F3 ships on the K-288 no ruling (confirmed K-324 §7)"
