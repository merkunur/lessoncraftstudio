  "strings": {
    "G2-317": {
      "title": "Werkwoorden in de tegenwoordige tijd: ik, jij, hij, wij",
      "instruction": "Kijk naar het plaatje en lees het werkwoord. Schrijf de vormen bij ik, jij, hij en wij in de stippelvakjes en maak daarna de zinnen af."
    },
    "F2": {
      "title": "Welke vorm hoort bij ik, jij en wij?",
      "instruction": "Lees elk werkwoord links. Trek een lijn naar de vorm rechts die erbij hoort, één lijn per werkwoord."
    },
    "F3": {
      "title": "Werkwoordsvormen in zinnen met plaatjes",
      "instruction": "Kijk naar het plaatje en lees het werkwoord in het vakje. Schrijf de vorm die in de zin past in het stippelvakje."
    },
    "F4": {
      "title": "Zijn en hebben: de vormen van ik tot zij",
      "instruction": "Deze werkwoorden veranderen veel. Schrijf bij elke persoon de goede vorm in de stippelvakjes."
    },
    "F5": {
      "title": "Kies de goede werkwoordsvorm",
      "instruction": "Lees de zin. Onder de zin staan drie vormen van het werkwoord. Omcirkel de vorm die past."
    },
    "F6": {
      "title": "Zoek het werkwoord en schrijf het hele werkwoord",
      "instruction": "Onderstreep het werkwoord in elke zin. Schrijf daarna het hele werkwoord in het stippelvakje."
    }
  }
}
