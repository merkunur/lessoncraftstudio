  "strings": {
    "G1-309": {
      "title": "Parole in rima: trova la rima e scrivila",
      "instruction": "Di' il nome del disegno grande. Fra i tre disegni cerchia quello che fa rima con il primo e scrivi la sua parola sulla riga."
    },
    "K-352": {
      "title": "Fanno rima o no?",
      "instruction": "Di' ad alta voce i nomi dei due disegni. Se fanno rima cerchia il segno di spunta, se non fanno rima cerchia la croce."
    },
    "G1-343": {
      "title": "Famiglie di rime: scrivi ogni parola sotto la sua rima",
      "instruction": "Di' il nome di ogni disegno in alto. Trova il disegno grande con cui fa rima e scrivi la parola su una riga sotto quel disegno."
    },
    "G1-344": {
      "title": "Completa la filastrocca con la parola in rima",
      "instruction": "Leggi i due versi ad alta voce. Guarda il disegno, ascolta la rima e scrivi sulla riga la parola che manca."
    },
    "G1-345": {
      "title": "Catene di rime: due parole per ogni disegno",
      "instruction": "Di' il nome di ogni disegno. Cerca nella scatola le due parole che fanno rima con il disegno e scrivile sulle righe. Alcune parole non vanno bene."
    },
    "G1-346": {
      "title": "Inventa le tue rime",
      "instruction": "Leggi la parola accanto a ogni disegno. Pensa a due parole che fanno rima con quella e scrivine una su ogni riga."
    }
  }
