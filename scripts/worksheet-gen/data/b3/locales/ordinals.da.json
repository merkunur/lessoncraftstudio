  "strings": {
    "K-320": {
      "title": "Ordenstal: find pladsen i rækken",
      "instruction": "Start ved flaget. Tæl hen til tallet på hver brik, og lav det mærke, brikken viser."
    },
    "F1": {
      "title": "Skriv de manglende ordenstal",
      "instruction": "Nogle pladser er allerede skrevet. Skriv de ordenstal, der mangler, i de tomme kasser. Tæl fra flaget."
    },
    "F2": {
      "title": "Ordenstal med ord: tegn en streg til billedet",
      "instruction": "Læs hvert ordenstal, og tegn en streg til det billede, der står på den plads. Tæl fra flaget."
    },
    "F3": {
      "title": "Hvilken plads? Skriv ordenstallet",
      "instruction": "Find hvert lille billede i sin række, og skriv, hvilken plads det står på. Tæl fra flaget."
    },
    "F4": {
      "title": "Ordenstal fra begge sider: start ved flaget",
      "instruction": "Find først flaget: det kan stå i begge ender. Start dér, tæl hen til tallet på hver brik, og lav det mærke, den viser."
    },
    "F5": {
      "title": "Hvem vinder løbet? Skriv pladsen",
      "instruction": "Se, hvor tæt hver løber er på målstregen. Den nærmeste er nr. 1. Skriv 1., 2., 3., 4., 5. og 6."
    }
  }
