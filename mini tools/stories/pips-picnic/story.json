      "narration": {
        "gate": "end",
        "cues": [
          { "id": "p01-l01", "characterId": "pip", "pauseAfterMs": 250 },
          { "id": "p01-l02", "characterId": "pip" }
        ]
      },
      "interaction": {
        "moduleType": "sb-choice-board",
        "zone": { "x": 520, "y": 200, "w": 760, "h": 600 },
        "completionMode": "check",
        "hintKey": "p01-hint",
        "taskData": {
          "targetKey": "three",
          "options": [
            { "key": "two",   "group": { "image": "img.apple", "count": 2 } },
            { "key": "three", "group": { "image": "img.apple", "count": 3 } },
            { "key": "five",  "group": { "image": "img.apple", "count": 5 } }
          ]
        }
      },
      "success": {
        "celebration": "burst",
        "sticker": "img.apple",
