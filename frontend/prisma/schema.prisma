// ==========================================
// WARRIORPLUS LICENSE & SALES SYSTEM
// ==========================================

model LicenseKey {
  id         String  @id @default(cuid())
  licenseKey String  @unique @map("license_key")
  email      String
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")

  // Product access
  productTier String   @map("product_tier") // "single-app", "category-bundle", "full-access", "commercial", "agency"
  productId   String   @map("product_id") // e.g. "math-bundle", "mega-bundle", "addition"
  appsAccess  String[] @default([]) @map("apps_access") // List of app IDs this license grants access to

  // Source tracking
  source        String  @default("warriorplus") // "warriorplus", "gumroad", "direct"
  transactionId String? @unique @map("transaction_id") // WarriorPlus or other platform transaction ID

  // Status
  status       String    @default("active") // "active", "revoked", "expired", "suspended"
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")

  // Usage
  activationsCount Int       @default(0) @map("activations_count")
  maxActivations   Int       @default(3) @map("max_activations") // Max devices
  lastUsedAt       DateTime? @map("last_used_at")
  lastUsedIp       String?   @map("last_used_ip")

  // Validity
  expiresAt DateTime? @map("expires_at") // null = lifetime access
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // User link (set when user activates license in member portal)
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([licenseKey])
  @@index([email])
  @@index([transactionId])
  @@index([status])
  @@index([productTier])
  @@index([userId])
  @@map("license_keys")
}

model LicenseDevice {
  id         String   @id @default(cuid())
  email      String
  ipAddress  String   @map("ip_address")
  userAgent  String?  @map("user_agent")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([email, ipAddress])
  @@index([email])
  @@index([lastSeenAt])
  @@map("license_devices")
}

model LSWebhookEvent {
  id           String   @id @default(cuid())
  eventId      String   @unique @map("event_id")
  eventType    String   @map("event_type")
  orderId      String?  @map("order_id")
  processedAt  DateTime @default(now()) @map("processed_at")
  status       String   @default("processed")
  errorMessage String?  @map("error_message") @db.Text
  payload      Json?

  @@index([eventId])
  @@index([eventType])
  @@map("ls_webhook_events")
}

// ============================================================
// Design Elements Library
// Decorative SVG elements (patterns, frames, corners, banners,
// dividers, badges, accents, etc.) available to all 33 worksheet
// apps through the shared design-elements-loader.
// Parallel to ImageLibraryItem but simpler (no themes — categories
// are fixed: patterns|textures|frames|corners|banners|dividers|
// badges|title-banners|accents|scatter-packs|footers).
// Color palettes live in /var/www/lcs-media/design-elements/palettes.json
// (not in this table — they're color arrays, not files).
// ============================================================
model DesignElement {
  id               String   @id @default(cuid())
  slug             String   @unique
  category         String // patterns|textures|frames|corners|banners|dividers|badges|title-banners|accents|scatter-packs|footers
  filename         String // e.g. "scalloped.svg"
  filePath         String   @map("file_path") // relative, e.g. "frames/scalloped.svg"
  fileSize         Int?     @map("file_size")
  mimeType         String   @default("image/svg+xml") @map("mime_type")
  translations     Json     @default("{}") // {en: "Scalloped", de: "Gewellt", ...}
  tags             String[] @default([]) // searchable tags
  defaultPlacement String?  @map("default_placement") // center|top|bottom|full-frame|divider
  defaultScale     Float?   @map("default_scale") // 0.50, 0.85, etc.
  tintable         Boolean  @default(true) // apply palette color via BlendColor filter
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([category, isActive, sortOrder])
  @@index([tags])
  @@map("design_elements")
}

// =====================================================================
// CATALOG DOMAIN (Brief B Phase 1 — Deck table only; v1)
//
// Other catalog-domain tables per CLAUDE.md §8.1 (DeckEnrichment, Topic,
// LessonPlan, ParentNote, PlayLink, Collection, CollectionDeck,
// DeckFavorite, EmbedConfig) defer to their respective consumer briefs
// per §3.1 additive principle. They are NOT in Brief B.
//
// content_family_id is reserved per §17.8.7 (always null in v1; v2's
// translate-this-deck workflow populates it for cross-language sibling
// tracking and hreflang re-injection).
// =====================================================================

model Deck {
  id              String    @id @default(cuid())
  slug            String // NOT @unique at column level; compound below
  title           Json // {en: "...", de: "...", ...}
  description     Json
  exerciseType    String    @map("exercise_type")
  exerciseMode    String?   @map("exercise_mode")
  language        String // ISO 639-1
  subjectTags     String[]  @default([]) @map("subject_tags")
  topicSlugs      String[]  @default([]) @map("topic_slugs")
  ageRange        String    @map("age_range") // "3-5" | "5-7" | "6-8" | "7-9" | "8-10"
  htmlUrl         String    @map("html_url")
  pdfUrl          String    @map("pdf_url")
  answerKeyUrl    String?   @map("answer_key_url")
  thumbnailUrl    String    @map("thumbnail_url")
  manifestUrl     String    @map("manifest_url")
  publishedAt     DateTime? @map("published_at")
  status          String    @default("draft") // "draft" | "published" | "archived"
  createdBy       String    @map("created_by")
  version         Int       @default(1)
  contentFamilyId String?   @map("content_family_id") // §17.8.7 reserved nullable
  // Phase 2 doctrine §1+§2 uniqueness invariants (deck-page SEO arc Phase 3a).
  // sha256 hashes of rendered post-substitution title + meta description; nullable
  // for pre-Phase-4a-retrofit decks (backfilled at retrofit pass per Phase 4a
  // mutable-regions contract extension). Compound unique constraint below
  // structurally enforces same-locale title uniqueness per Phase 2 §1 invariant.
  titleHash       String?   @map("title_hash")
  descriptionHash String?   @map("description_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Catalog-side back-relations (commission pass — §8.1 models). Prisma virtual; emit no SQL.
  enrichment            DeckEnrichment?
  playLinks             PlayLink[]
  favorites             DeckFavorite[]
  collectionMemberships CollectionDeck[]
  embedConfigs          EmbedConfig[]
  bundleMemberships     BundleDeck[]

  @@unique([language, slug]) // §17.8.5 compound unique (Drift D2)
  @@unique([language, titleHash], map: "decks_language_title_hash_key") // Phase 2 §1 uniqueness invariant
  @@index([status, publishedAt])
  @@index([exerciseType, language])
  // Catalog-scale read-path indexes per project_mass_publish_recon.md §B4.
  // GIN supports `subjectTags: { has: axisKey }` (compiles to @>) used by
  // fetchDecksForAxis theme-axis filter at frontend/lib/topic-decks.ts:62.
  // Compound indexes serve educational-level + exercise-type axis filters
  // with the status='published' branch in one index lookup.
  @@index([subjectTags], type: Gin)
  @@index([language, status, ageRange])
  @@index([language, status, exerciseType])
  @@map("decks")
}

// =====================================================================
// Catalog-side §8.1 models (commission pass)
//
// Per CLAUDE.md §8.1 stated-intent shapes. CREATE-only; zero blast radius
// on extant tables. Three families:
//   A. catalog-enrichment: DeckEnrichment, Topic, LessonPlan, ParentNote
//   B. player-embeds:      EmbedConfig, PlayLink
//   C. workspace:          Collection, CollectionDeck, DeckFavorite
//
// Migration files split by family per recon's A/B/C topological order.
// Topic.ageRange = String matches shipped Deck convention; AgeRange enum
// retrofit deferred per project_deferred_items_queue.md (covers Deck +
// Topic together).
// =====================================================================

// Family A — catalog enrichment

// AI-generated enrichment payload for each Deck. 1:1 with Deck (deckId is
// both PK and FK). embedding is the serialized vector for §16.1
// embedding-similarity (deck-level); Mac Studio AI service per §4.5
// generates and writes. enrichmentVersion bumps when prompts/model change.
model DeckEnrichment {
  deckId             String   @id @map("deck_id")
  embedding          Bytes
  longDescription    Json     @map("long_description")
  learningObjectives Json     @map("learning_objectives")
  aiTags             String[] @default([]) @map("ai_tags")
  enrichedAt         DateTime @default(now()) @map("enriched_at")
  enrichmentVersion  Int      @default(1) @map("enrichment_version")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("deck_enrichments")
}

// Cross-product topic record per CLAUDE.md §16.1 (subject × topic × age ×
// language). slug is the cross-product cluster key, distinct from the
// per-axis-key single-axis topic-page slugs in topics-taxonomy.json.
//
// embedding column per H1 authorization — used by §16.1 embedding-similarity
// topic resolution (the "top hit above a threshold" step). Mac Studio AI
// service per §4.5 generates per-topic embeddings asynchronously; nullable
// because rows can exist before AI catches up.
//
// ageRange = String matches shipped Deck convention; §8.1 line 414 closing
// guidance about AgeRange enum is deferred per project_deferred_items_queue.md.
model Topic {
  slug           String   @id
  title          Json
  description    Json
  subject        String
  ageRange       String   @map("age_range")
  language       String
  curriculumTags String[] @default([]) @map("curriculum_tags")
  parentSlug     String?  @map("parent_slug")
  isHighPriority Boolean  @default(false) @map("is_high_priority")
  embedding      Bytes?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lessonPlans LessonPlan[]
  parentNotes ParentNote[]

  @@index([subject, language])
  @@map("topics")
}

// Per-locale lesson plan rows (one per (topic, language) combination per the
// @@unique below). content-only library per docs/SUBSCRIPTION-SCOPE.md
// Pillar 1 — no plan-builder. AI-generated; structure JSON carries the
// pedagogical-stance-shaped content (pedagogical stance is open decision #1
// in SUBSCRIPTION-SCOPE.md, schema-shape-independent).
model LessonPlan {
  id                    String   @id @default(cuid())
  topicSlug             String   @map("topic_slug")
  language              String
  durationMinutes       Int      @map("duration_minutes")
  structure             Json
  recommendedDeckIds    String[] @default([]) @map("recommended_deck_ids")
  recommendedPdfDeckIds String[] @default([]) @map("recommended_pdf_deck_ids")
  generatedBy           String   @map("generated_by")
  generatedAt           DateTime @default(now()) @map("generated_at")
  generationVersion     Int      @default(1) @map("generation_version")

  topic             Topic              @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)
  bundleMemberships BundleLessonPlan[]
  teachingPackages  TeachingPackage[]

  @@unique([topicSlug, language])
  @@map("lesson_plans")
}

// v1 deferred per docs/SUBSCRIPTION-SCOPE.md (parent-communication templates
// moved to deferred features at §7); reserved for forward-compatibility per
// CLAUDE.md §17.8.7 reservation pattern. Schema is created at this pass to
// avoid a future migration when feature reactivates. AI service generation
// (§4.5) currently does NOT include parent-note generation; resumes on
// feature reactivation.
model ParentNote {
  id                String   @id @default(cuid())
  topicSlug         String   @map("topic_slug")
  language          String
  body              String   @db.Text
  tone              String
  generatedBy       String   @map("generated_by")
  generatedAt       DateTime @default(now()) @map("generated_at")
  generationVersion Int      @default(1) @map("generation_version")

  topic Topic @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)

  @@unique([topicSlug, language, tone])
  @@map("parent_notes")
}

// Family B — player + embeds

// Platform-infrastructure model (free for all users per CLAUDE.md §3
// acquisition flywheel + docs/SUBSCRIPTION-SCOPE.md). Not subscription-gated.
// Each EmbedConfig is a per-teacher per-deck iframe configuration — width,
// height, optional allowedOrigins restriction. Embedding itself is free.
model EmbedConfig {
  id             String   @id @default(cuid())
  teacherId      String   @map("teacher_id")
  deckId         String   @map("deck_id")
  width          String?
  height         String?
  allowedOrigins String[] @default([]) @map("allowed_origins")
  createdAt      DateTime @default(now()) @map("created_at")

  teacher   User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  deck      Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  playLinks PlayLink[]

  @@index([teacherId])
  @@map("embed_configs")
}

// Student-facing share-link route per CLAUDE.md §4.4. linkId is a 10-char
// random alphanumeric public ID (≈3.6 quadrillion combinations,
// unguessable). Optionally bound to an EmbedConfig when the link backs an
// iframe embed; allowedOrigins enforcement happens at link resolution time.
model PlayLink {
  id            String   @id @default(cuid())
  linkId        String   @unique @map("link_id") @db.VarChar(10)
  deckId        String   @map("deck_id")
  teacherId     String   @map("teacher_id")
  embedConfigId String?  @map("embed_config_id")
  createdAt     DateTime @default(now()) @map("created_at")

  deck        Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  teacher     User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  embedConfig EmbedConfig? @relation(fields: [embedConfigId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@map("play_links")
}

// Family C — workspace

// Subscriber-only feature per docs/SUBSCRIPTION-SCOPE.md Pillar 3 Tool 1.
// Teachers organize favorited decks into named collections. Foundation for
// Tool 2 (workspace home), Tool 5 (bulk operations).
model Collection {
  id          String   @id @default(cuid())
  teacherId   String   @map("teacher_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  decks   CollectionDeck[]

  @@index([teacherId])
  @@map("collections")
}

// Collection ↔ Deck join with ordering position. Composite PK on
// (collectionId, deckId).
model CollectionDeck {
  collectionId String   @map("collection_id")
  deckId       String   @map("deck_id")
  position     Int
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  deck       Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([collectionId, deckId])
  @@index([collectionId, position])
  @@map("collection_decks")
}

// Free-tier feature: teachers favorite decks (saved for later) without
// organization. Trigger for the collections-feature CTA after fifth favorite
// (per CLAUDE.md §7 conversion mechanics). Composite PK on (teacherId, deckId).
model DeckFavorite {
  teacherId   String   @map("teacher_id")
  deckId      String   @map("deck_id")
  favoritedAt DateTime @default(now()) @map("favorited_at")

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  deck    Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([teacherId, deckId])
  @@index([teacherId, favoritedAt])
  @@map("deck_favorites")
}

// =====================================================================
// Family D — Pillar 2 themed bundles (commission pass)
//
// Per docs/SUBSCRIPTION-SCOPE.md Feature Area 2 + the b57e26f7 Option A
// lock (7 themes × 2 locales = 14 bundles for launch trigger clause (b)).
// Schema-only substrate; tables ship empty. Authoring follows the
// cooperation pattern Pillar 1 used at e912b805.
//
// themeAxisKey is a soft FK by convention into topics-taxonomy.json
// axes.theme.<key> (matching how Deck.subjectTags references the same
// taxonomy without a DB-level FK; themes live in config + image_themes).
//
// Bundle.@@unique([themeAxisKey, language]) is load-bearing for the 7×2
// launch shape. Bundle.@@unique([language, slug]) mirrors Deck §17.8.5.
//
// BundleDeck + BundleLessonPlan are M2M joins. Cascade on Bundle deletion
// is correct (deleting a bundle removes its memberships); NO cascade on
// Deck or LessonPlan deletion (deleting either parent must fail loudly
// rather than silently mutate bundles — operator removes BundleDeck /
// BundleLessonPlan rows explicitly first).
// =====================================================================

model Bundle {
  id           String    @id @default(cuid())
  slug         String // NOT @unique at column level; compound below per Deck §17.8.5 precedent
  themeAxisKey String    @map("theme_axis_key") // soft FK into topics-taxonomy.json axes.theme.<key>
  language     String // ISO 639-1; one Bundle row = one locale
  title        Json // {en: "...", de: "...", ...}
  description  Json
  thumbnailUrl String    @map("thumbnail_url")
  status       String    @default("draft") // "draft" | "published" | "archived"
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  decks            BundleDeck[]
  lessonPlans      BundleLessonPlan[]
  teachingPackages BundleTeachingPackage[]

  @@unique([themeAxisKey, language]) // 7×2 launch shape
  @@unique([language, slug]) // slug uniqueness per locale (mirrors Deck §17.8.5)
  @@index([status, publishedAt])
  @@index([language, status])
  @@map("bundles")
}

// Bundle ↔ Deck join with ordering position. Composite PK on
// (bundleId, deckId). Cascade on Bundle deletion only; Deck deletion
// must fail loudly until BundleDeck rows are removed explicitly.
model BundleDeck {
  bundleId String   @map("bundle_id")
  deckId   String   @map("deck_id")
  position Int
  addedAt  DateTime @default(now()) @map("added_at")

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  deck   Deck   @relation(fields: [deckId], references: [id])

  @@id([bundleId, deckId])
  @@index([bundleId, position])
  @@map("bundle_decks")
}

// Bundle ↔ LessonPlan join. Bundles ship with at least one paired
// lesson plan (SUBSCRIPTION-SCOPE.md Feature Area 2 "bundle/lesson-plan
// pairing"); enforced at authoring time, not schema. Cascade on Bundle
// deletion only; LessonPlan deletion must fail loudly.
model BundleLessonPlan {
  bundleId     String @map("bundle_id")
  lessonPlanId String @map("lesson_plan_id")

  bundle     Bundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id])

  @@id([bundleId, lessonPlanId])
  @@map("bundle_lesson_plans")
}

// Teaching package — sibling table to LessonPlan, keyed on pedagogical learning
// targets (frontend/config/learning-targets.json) rather than topics-taxonomy
// axis-keys. Per docs/lesson-plans/existing-plan-substrate.md §7-8 Option B
// lock at Phase 1 surface gate (commit 3b33fe1d, 2026-05-06).
//
// Two keying spaces coexist:
//   - LessonPlan.topicSlug → Topic.slug (axis-keys: addition / sudoku / animals / kindergarten)
//   - TeachingPackage.targetSlug → frontend/config/learning-targets.json (pedagogical
//     learning targets: identify-and-name-10-farm-animals / count-quantities-to-10 / ...)
//
// Optional lessonPlanId FK lets a TeachingPackage wrap an existing LessonPlan
// for the text-plan portion; null when the package authors its own structure.
//
// composedExercises Json shape:
//   [{appName, exerciseMode, customizationParameters, ordering, pedagogicalRole}]
// materials Json shape:
//   [{materialSlug, customizationParameters, ordering, pedagogicalRole}]
// assessmentCriteria Json shape:
//   {<locale>: <success-criteria text>}
model TeachingPackage {
  id                    String    @id @default(cuid())
  targetSlug            String    @map("target_slug")
  language              String
  title                 Json
  description           Json
  durationMinutes       Int       @map("duration_minutes")
  structure             Json
  composedExercises     Json      @map("composed_exercises")
  materials             Json
  curriculumStandards   String[]  @default([]) @map("curriculum_standards")
  assessmentCriteria    Json      @map("assessment_criteria")
  recommendedDeckIds    String[]  @default([]) @map("recommended_deck_ids")
  recommendedPdfDeckIds String[]  @default([]) @map("recommended_pdf_deck_ids")
  lessonPlanId          String?   @map("lesson_plan_id")
  status                String    @default("draft")
  publishedAt           DateTime? @map("published_at")
  generatedBy           String    @map("generated_by")
  generatedAt           DateTime  @default(now()) @map("generated_at")
  generationVersion     Int       @default(1) @map("generation_version")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  lessonPlan        LessonPlan?             @relation(fields: [lessonPlanId], references: [id])
  bundleMemberships BundleTeachingPackage[]

  @@unique([targetSlug, language])
  @@index([status, publishedAt])
  @@index([targetSlug])
  @@map("teaching_packages")
}

// Bundle ↔ TeachingPackage join. Reserved per §17.8.7 reservation pattern; no
// Pillar 2 consumers in v1, schema landed now to avoid a future migration.
// Cascade on Bundle deletion only; TeachingPackage deletion must fail loudly.
model BundleTeachingPackage {
  bundleId          String @map("bundle_id")
  teachingPackageId String @map("teaching_package_id")

  bundle          Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  teachingPackage TeachingPackage @relation(fields: [teachingPackageId], references: [id])

  @@id([bundleId, teachingPackageId])
  @@map("bundle_teaching_packages")
}

// Notify-me email captures for the pre-launch home page.
// Per HOMEPAGE-IMPLEMENTATION-PROMPT.md §9 launch readiness item 1 + T5 default.
// HOMEPAGE_SUBSCRIBE_MODE=notify_me writes here; emails sit until the operator
// runs the launch blast manually. Standalone table — no FK to User.
model SubscriptionInterest {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("subscription_interest")
}
