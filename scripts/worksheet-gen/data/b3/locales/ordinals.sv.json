  "strings": {
    "K-320": {
      "title": "Ordningstal: hitta platsen i raden",
      "instruction": "Börja vid flaggan. Räkna fram till talet på varje bricka och gör det märke som brickan visar."
    },
    "F1": {
      "title": "Skriv de ordningstal som saknas",
      "instruction": "Några platser är redan skrivna. Skriv ordningstalen som saknas i de tomma rutorna. Räkna från flaggan."
    },
    "F2": {
      "title": "Ordningstal med bokstäver: dra ett streck till bilden",
      "instruction": "Läs varje ordningstal och dra ett streck till bilden som står på den platsen. Räkna från flaggan."
    },
    "F3": {
      "title": "Vilken plats? Skriv ordningstalet",
      "instruction": "Hitta varje liten bild i sin rad och skriv vilken plats den står på. Räkna från flaggan."
    },
    "F4": {
      "title": "Ordningstal från andra hållet: börja vid flaggan",
      "instruction": "Leta först upp flaggan: den kan stå i vilken ände som helst. Börja där, räkna till talet på brickan och gör märket som brickan visar."
    },
    "F5": {
      "title": "Vem vinner loppet? Skriv placeringen",
      "instruction": "Titta hur nära mållinjen varje löpare är. Den närmaste är 1:a. Skriv 1:a, 2:a, 3:e, 4:e, 5:e och 6:e."
    }
  }
