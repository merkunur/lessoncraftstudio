  "strings": {
    "K-324": {
      "title": "Kuvakortit ja sanakortit",
      "instruction": "Leikkaa kortit irti katkoviivoja pitkin. Sano jokaisen kuvan nimi ja lue sitten sen sana."
    },
    "twin": {
      "title": "Kuvakortit ja sanakortit: parit",
      "instruction": "Leikkaa kuusitoista korttia irti. Aseta sanakortit niiden kuvien viereen, joita ne nimeävät, tai käännä kaikki nurin ja pelatkaa muistipeliä."
    },
    "plural": {
      "title": "Yksi ja monta: yksikkö- ja monikkokortit",
      "instruction": "Leikkaa kortit irti. Sano yhden sana ja monen sana ja yhdistä sitten jokainen pari."
    },
    "bilingual": {
      "title": "Kaksikieliset kuvakortit: suomi ja englanti",
      "instruction": "Leikkaa kahdeksan korttia irti. Sano sana ensin suomeksi ja sitten englanniksi ja säilytä kortit sanaseinää varten."
    },
    "syllable": {
      "title": "Tavukortit: lue sana tavu kerrallaan",
      "instruction": "Leikkaa kahdeksan korttia irti. Lue jokainen sana tavu kerrallaan ja sano sitten koko sana."
    }
  }
