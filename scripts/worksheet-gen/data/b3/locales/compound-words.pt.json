  "strings": {
    "G2-316": {
      "title": "Diminutivo e aumentativo: raiz e sufixo",
      "instruction": "Olhe a figura e leia o sufixo. Escreva na linha a palavra no diminutivo ou no aumentativo."
    },
    "G2-329": {
      "title": "O que vai no meio? Junte a raiz e o sufixo",
      "instruction": "Leia a raiz e o sufixo. Escreva no quadradinho a letra que liga as duas partes e depois a palavra inteira."
    },
    "G2-331": {
      "title": "Ligue as metades das palavras",
      "instruction": "Ligue cada figura da esquerda à figura da direita que forma uma palavra da mesma família e escreva a palavra."
    },
    "G2-332": {
      "title": "Detetive do diminutivo e do aumentativo",
      "instruction": "Circule as palavras que estão no diminutivo ou no aumentativo e escreva a raiz e o sufixo. Cuidado com as que só parecem."
    },
    "G2-333": {
      "title": "Diminutivo e aumentativo: -inho e -ão",
      "instruction": "Repare no tamanho da figura. Se ela é pequena, escreva a palavra com -inho; se é grande, escreva com -ão."
    }
  }
