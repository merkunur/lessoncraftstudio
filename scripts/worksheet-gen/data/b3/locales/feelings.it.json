    "K-319": {
      "title": "Le emozioni: collega la faccia alla parola",
      "instruction": "Collega con una linea ogni faccia alla parola che dice come si sente."
    },
    "K-331": {
      "title": "Come ti senti? Cerchia la faccia",
      "instruction": "Guarda il disegno, pensa a come ti sentiresti tu e cerchia la faccia giusta."
    },
    "K-332": {
      "title": "Disegna la faccia dell'emozione",
      "instruction": "Leggi la parola e disegna nel cerchio vuoto una faccia che mostra quell'emozione."
    },
    "K-333": {
      "title": "Piacevole o spiacevole? Ordina le facce",
      "instruction": "Collega con una linea ogni faccia alla scatola che dice se l'emozione è piacevole o spiacevole."
    },
    "K-334": {
      "title": "Quale faccia mostra l'emozione?",
      "instruction": "Leggi la parola e cerchia l'unica faccia della fila che mostra quell'emozione."
    },
    "K-335": {
      "title": "Come mi sento oggi?",
      "instruction": "Cerchia la faccia che mostra come ti senti oggi, poi disegna la tua faccia."
    }
