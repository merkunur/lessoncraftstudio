  "strings": {
    "G1-307": {
      "title": "Les contraires : écris le mot de sens contraire",
      "instruction": "Lis le mot de chaque carte. Cherche son contraire dans la banque de mots et écris-le sur la ligne."
    },
    "K-351": {
      "title": "Les contraires en images : relie les contraires",
      "instruction": "Relie chaque image au dessin et au mot qui montrent son contraire."
    },
    "G1-335": {
      "title": "Les contraires dans une phrase",
      "instruction": "Lis chaque phrase. Écris sur la ligne le contraire du mot qui vient après « pas ». La banque de mots t'aide."
    },
    "G1-336": {
      "title": "Retrouve les paires de contraires",
      "instruction": "Trouve les deux mots qui sont contraires. Écris chaque paire sur une ligne, un mot de chaque côté de la flèche."
    },
    "G1-337": {
      "title": "Contraire ou synonyme ? Entoure le contraire",
      "instruction": "Lis le mot. Un des trois mots en dessous veut dire le contraire. Entoure-le, pas celui qui veut dire la même chose."
    },
    "G2-320": {
      "title": "Le contraire avec un préfixe : in-, im-, mal-, dé-",
      "instruction": "Ajoute le préfixe devant chaque mot et écris le nouveau mot, son contraire, sur la ligne."
    }
  }
