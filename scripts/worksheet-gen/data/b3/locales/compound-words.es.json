  "strings": {
    "G2-316": {
      "title": "Familias de palabras: raíz y sufijo",
      "instruction": "Mira el dibujo y lee el sufijo. Escribe la nueva palabra de la familia en la línea."
    },
    "G2-329": {
      "title": "¿Qué va en medio? Une la raíz y el sufijo",
      "instruction": "Lee la raíz y el sufijo. Escribe en la caja la letra que une las dos partes y después la palabra completa."
    },
    "G2-330": {
      "title": "Divide la palabra: encuentra la raíz",
      "instruction": "Lee la palabra completa. Traza una rayita donde termina la raíz y empieza el sufijo."
    },
    "G2-331": {
      "title": "Une las mitades de las palabras",
      "instruction": "Une cada dibujo de la izquierda con el de la derecha que forma una palabra de su familia y escríbela en la línea."
    },
    "G2-332": {
      "title": "Detective de familias de palabras",
      "instruction": "Rodea las palabras que pertenecen a una familia de palabras y escribe su raíz y su sufijo. Cuidado con las que solo lo parecen."
    },
    "G2-333": {
      "title": "Diminutivos y aumentativos: -ito y -ote",
      "instruction": "Fíjate en el tamaño del dibujo. Si es pequeño, escribe la palabra con -ito; si es grande, escríbela con -ote."
    }
  }
