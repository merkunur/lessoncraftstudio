  "strings": {
    "G1-308": {
      "title": "Lees en doe: volg de opdrachten",
      "instruction": "Kijk naar de rij plaatjes en begin bij de vlag. Lees elke zin en doe precies wat er staat met je potlood. Zet daarna een vinkje in het kleine hokje."
    },
    "F1": {
      "title": "Lees en omcirkel",
      "instruction": "Lees elke zin. Zoek in de rij het plaatje of de plaatjes die erin staan en zet er een cirkel omheen. Zet daarna een vinkje in het hokje."
    },
    "F2": {
      "title": "Lees en doe: opdrachten met twee stappen",
      "instruction": "Elke zin zegt twee dingen die je moet doen. Lees de zin helemaal voordat je begint en doe dan allebei de stappen in de rij plaatjes."
    },
    "F3": {
      "title": "Lees en doe: eerste, tweede, tussen",
      "instruction": "Begin bij de vlag en tel langs de rij. Zoek het plaatje op zijn plaats en doe dan met je potlood wat de zin zegt."
    },
    "F4": {
      "title": "Lees en controleer: waar of niet waar?",
      "instruction": "Lees elke zin en kijk naar de rij plaatjes. Is de zin waar of niet waar? Omcirkel het goede woord."
    },
    "F5": {
      "title": "Lees en teken",
      "instruction": "Lees elke zin goed. Teken dan in het vak precies wat er staat."
    }
  }
