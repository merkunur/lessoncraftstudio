  "strings": {
    "base": {
      "title": "Synonymer: ringa in ordet som betyder samma sak",
      "instruction": "Läs det stora ordet på varje kort och ringa in det ord under som betyder samma sak."
    },
    "pictures": {
      "title": "Synonymer med bilder: två ord till en bild",
      "instruction": "Titta på varje bild och ringa in de två ord under den som betyder samma sak och passar till bilden."
    },
    "pairs": {
      "title": "Synonympar: para ihop ord som betyder samma sak",
      "instruction": "Dra ett streck från varje ord till vänster till det ord till höger som betyder samma sak."
    },
    "shades": {
      "title": "Ordens styrka: från lite till mycket",
      "instruction": "Läs de tre orden i varje rad och skriv 1, 2 och 3 i rutorna, från det svagaste ordet till det starkaste."
    },
    "say": {
      "title": "Synonymer till sa: välj ordet som passar",
      "instruction": "Läs varje mening och skriv det ord från pratbubblan som passar bäst i rutan i stället för sa."
    },
    "fields": {
      "title": "Synonymer till gå och titta: sortera orden",
      "instruction": "Läs de tio orden och skriv varje ord i fältet gå eller i fältet titta, där det hör hemma."
    }
  }
