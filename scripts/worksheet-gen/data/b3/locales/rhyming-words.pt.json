  "strings": {
    "G1-309": {
      "title": "Palavras que rimam: circule e escreva",
      "instruction": "Fale o nome da primeira figura. Circule a figura que rima com ela e depois escreva a palavra na linha."
    },
    "K-352": {
      "title": "Rima ou não rima?",
      "instruction": "Fale o nome das duas figuras em voz alta. Se as duas palavras rimam, circule o certo. Se não rimam, circule o xis."
    },
    "G1-343": {
      "title": "Separe as rimas",
      "instruction": "Fale o nome de cada figura do banco. Ache a figura grande com que ela rima e escreva a palavra em uma linha embaixo dessa figura."
    },
    "G1-344": {
      "title": "Complete a rima",
      "instruction": "Leia os dois versos em voz alta. Olhe a figura, escute a rima e escreva na linha a palavra que rima e está faltando."
    },
    "G1-345": {
      "title": "Cadeia de rimas: duas palavras para cada figura",
      "instruction": "Fale o nome de cada figura. Ache no banco as duas palavras que rimam com ela e escreva nas linhas. Algumas palavras não cabem em nenhuma."
    },
    "G1-346": {
      "title": "Invente as suas rimas",
      "instruction": "Leia a palavra ao lado de cada figura. Pense em duas palavras que rimam com ela e escreva uma em cada linha."
    }
  }
}
