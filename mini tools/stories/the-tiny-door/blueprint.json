      "narration": [
        {
          "text": "Deep in the forest stood the old oak tree, taller than tall."
        },
        {
          "text": "Down among its roots, Hazel found a tiny little door."
        },
        {
          "characterId": "hazel",
          "text": "\"Look!\" gasped Hazel. \"And up on the hill — a great big door!\""
        },
        {
          "text": "Two doors meant two new neighbors, one big and one tiny."
        },
        {
          "characterId": "hazel",
          "text": "\"Let's say hello!\" said Hazel, clapping her paws."
        }
      ],
