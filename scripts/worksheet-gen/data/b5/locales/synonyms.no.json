  "strings": {
    "base": {
      "title": "Synonymer: ring rundt ordet som betyr det samme",
      "instruction": "Les det store ordet på hvert kort og ring rundt ordet under som betyr det samme."
    },
    "pictures": {
      "title": "Synonymer med bilder: to ord til ett bilde",
      "instruction": "Se på hvert bilde og ring rundt de to ordene under som betyr det samme og passer til bildet."
    },
    "pairs": {
      "title": "Synonympar: finn ordene som betyr det samme",
      "instruction": "Trekk en strek fra hvert ord til venstre til ordet til høyre som betyr det samme."
    },
    "shades": {
      "title": "Ordenes styrke: fra litt til mye",
      "instruction": "Les de tre ordene i hver rad og skriv 1, 2 og 3 i rutene, fra det svakeste ordet til det sterkeste."
    },
    "say": {
      "title": "Synonymer for sa: velg ordet som passer",
      "instruction": "Les hver setning og skriv ordet fra snakkeboblen som passer best i ruten i stedet for sa."
    },
    "fields": {
      "title": "Synonymer for gå og se: sorter ordene",
      "instruction": "Les de ti ordene og skriv hvert ord i feltet gå eller i feltet se, der det hører hjemme."
    }
  }
