    "G1-307": {
      "title": "Motsetninger: Skriv det motsatte ordet",
      "instruction": "Les ordet på hvert kort. Finn det motsatte ordet i ordbanken og skriv det på linja."
    },
    "K-351": {
      "title": "Motsetninger med bilder: Finn parene",
      "instruction": "Tegn en strek fra hvert bilde til bildet og ordet som viser det motsatte."
    },
    "G1-335": {
      "title": "Motsetninger i setninger",
      "instruction": "Les hver setning. Skriv det motsatte av ordet etter «ikke» på linja. Ordbanken hjelper deg."
    },
    "G1-336": {
      "title": "Finn ordparene som er motsetninger",
      "instruction": "Finn de to ordene som er motsetninger. Skriv hvert par på en linje, ett ord på hver side av pila."
    },
    "G1-337": {
      "title": "Motsatt eller det samme? Sett ring rundt det motsatte",
      "instruction": "Les ordet. Ett av de tre ordene under betyr det motsatte. Sett ring rundt det, ikke rundt ordet som betyr det samme."
    },
    "G2-320": {
      "title": "Motsetninger med forstavelsen u-",
      "instruction": "Sett forstavelsen u- foran hvert ord og skriv det nye, motsatte ordet på linja."
    }
