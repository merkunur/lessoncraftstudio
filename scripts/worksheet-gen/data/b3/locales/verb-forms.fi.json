  "strings": {
    "G2-317": {
      "title": "Verbin persoonamuodot: minä, sinä, hän",
      "instruction": "Katso kuvaa ja lue verbi. Kirjoita sen persoonamuodot katkoviivaruutuihin ja täydennä sitten lauseet."
    },
    "F2": {
      "title": "Yhdistä persoona ja verbimuoto",
      "instruction": "Lue vasemmalta persoonapronomini. Piirrä viiva siihen verbimuotoon, joka kuuluu sille: yksi viiva jokaista pronominia kohti."
    },
    "F3": {
      "title": "Verbimuodot lauseissa kuvien avulla",
      "instruction": "Katso kuvaa ja lue verbi laatikosta. Kirjoita lauseeseen sopiva persoonamuoto katkoviivaruutuun."
    },
    "F4": {
      "title": "Olla, tulla, mennä: taivuta verbit",
      "instruction": "Nämä verbit taipuvat eri tavalla kuin muut. Kirjoita jokaiselle persoonalle oikea muoto katkoviivaruutuun."
    },
    "F5": {
      "title": "Valitse oikea verbimuoto",
      "instruction": "Lue lause. Sen alla on kolme saman verbin muotoa. Ympyröi se muoto, joka sopii lauseeseen."
    },
    "F6": {
      "title": "Etsi verbi ja kirjoita perusmuoto",
      "instruction": "Alleviivaa lauseen verbi. Kirjoita sitten sen perusmuoto katkoviivaruutuun."
    }
  }
