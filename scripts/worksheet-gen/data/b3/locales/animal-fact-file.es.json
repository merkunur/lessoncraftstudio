  "strings": {
    "G2-318": {
      "title": "Datos de un animal: {U}",
      "instruction": "Investiga sobre este animal. Escribe un dato en cada fila y completa el resto de la página con tu dibujo o tus palabras."
    },
    "G2-339": {
      "title": "{U}: marca los datos correctos",
      "instruction": "Lee las opciones de cada fila y rodea la que es verdadera para este animal. Luego dibuja dónde vive y completa la oración."
    },
    "G2-340": {
      "title": "{U}: datos con banco de palabras",
      "instruction": "Busca cada dato verdadero en el banco de palabras y cópialo en la fila correcta. Luego completa la oración de abajo."
    },
    "G2-341": {
      "title": "{U}: escribe tres oraciones",
      "instruction": "Lee los datos del animal. Completa las tres oraciones con esos datos y escribe un dato más en la última línea."
    },
    "G2-342": {
      "title": "Compara dos animales: igual y diferente",
      "instruction": "Lee los datos de los dos animales. En cada fila rodea igual o diferente. Luego escribe dos cosas iguales y dos diferentes."
    },
    "G2-343": {
      "title": "¿Quién soy? El animal misterioso",
      "instruction": "Lee las cinco pistas de cada tarjeta. Busca el animal en el banco de dibujos, escribe su nombre en la línea y dibújalo en el recuadro."
    }
