  "strings": {
    "base": {
      "title": "Les synonymes : entoure le mot qui veut dire la même chose",
      "instruction": "Lis le grand mot de chaque carte et entoure, en dessous, le mot qui veut dire la même chose."
    },
    "pictures": {
      "title": "Les synonymes en images : deux mots pour une image",
      "instruction": "Regarde chaque image et entoure, en dessous, les deux mots qui veulent dire la même chose et qui décrivent l’image."
    },
    "pairs": {
      "title": "Relier les synonymes deux à deux",
      "instruction": "Trace un trait pour relier chaque mot de gauche au mot de droite qui veut dire la même chose."
    },
    "shades": {
      "title": "Les nuances de sens : du plus faible au plus fort",
      "instruction": "Lis les trois mots de chaque ligne et écris 1, 2 et 3 dans les cases, du mot le plus faible au mot le plus fort."
    },
    "say": {
      "title": "Les synonymes du verbe dire : choisis le mot juste",
      "instruction": "Lis chaque phrase et écris dans la case le mot de la bulle qui convient le mieux à la place de « dit »."
    },
    "fields": {
      "title": "Champ lexical : les mots pour aller et pour regarder",
      "instruction": "Lis les dix mots et écris chacun dans le champ du verbe dont il est le plus proche par le sens."
    }
  }
}
