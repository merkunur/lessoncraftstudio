  "strings": {
    "G2-316": {
      "title": "Mots de la même famille : image + terminaison",
      "instruction": "Dis le nom de l'image, c'est le radical. Ajoute la terminaison et écris le nouveau mot sur la ligne."
    },
    "G2-329": {
      "title": "La lettre de liaison entre le radical et la terminaison",
      "instruction": "Le radical et la terminaison sont écrits. Écris la lettre qui les relie dans la case, ou laisse-la vide, puis écris le mot entier."
    },
    "G2-330": {
      "title": "Retrouve le radical : coupe le mot en deux",
      "instruction": "Le mot est écrit dans des cases, à côté de son image. Trace un trait entre le radical et ce qu'on lui a ajouté."
    },
    "G2-331": {
      "title": "Relie le radical au mot de sa famille",
      "instruction": "Relie chaque image de gauche au mot de sa famille à droite, puis écris ce mot sur la ligne."
    },
    "G2-332": {
      "title": "Mot simple ou mot construit ?",
      "instruction": "Douze mots : six sont construits à partir d'un radical. Entoure-les et écris le radical et la terminaison sur les lignes."
    },
    "G2-333": {
      "title": "Une famille de mots autour d'un même radical",
      "instruction": "Un mot est au milieu. Chaque image autour forme un mot de sa famille. Écris les quatre mots sur les lignes."
    }
  }
}
