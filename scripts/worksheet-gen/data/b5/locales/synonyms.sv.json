      "sentences": [
        {
          "id": "f1",
          "text": "”Sch, bebisen sover”, {gap} {name} alldeles tyst.",
          "plainVerbOK": true,
          "fit": {
            "viskade": true,
            "ropade": false,
            "frågade": false,
            "svarade": false,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f2",
          "text": "”Jag har en hemlighet till dig”, {gap} {name} tyst i mormors öra.",
          "plainVerbOK": true,
          "fit": {
            "viskade": true,
            "ropade": false,
            "frågade": false,
            "svarade": false,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f3",
          "text": "Bussen skulle just åka, därför {gap} {name}: ”Vänta på mig!”",
          "plainVerbOK": true,
          "fit": {
            "viskade": false,
            "ropade": true,
            "frågade": false,
            "svarade": false,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f4",
          "text": "”Kom och lek!” {gap} {name} över hela skolgården.",
          "plainVerbOK": true,
          "fit": {
            "viskade": false,
            "ropade": true,
            "frågade": false,
            "svarade": false,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f5",
          "text": "”Var är min röda mössa?” {gap} {name}.",
          "plainVerbOK": true,
          "fit": {
            "viskade": false,
            "ropade": false,
            "frågade": true,
            "svarade": false,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f6",
          "text": "”Sju och tre är tio”, {gap} {name} med ett stort leende.",
          "plainVerbOK": true,
          "fit": {
            "viskade": false,
            "ropade": false,
            "frågade": false,
            "svarade": true,
            "förklarade": false,
            "lovade": false
          }
        },
        {
          "id": "f7",
          "text": "”Först gräver man en grop, sedan lägger man i fröet”, {gap} {name}.",
          "plainVerbOK": true,
          "fit": {
            "viskade": false,
            "ropade": false,
            "frågade": false,
            "svarade": false,
            "förklarade": true,
            "lovade": false
          }
        },
