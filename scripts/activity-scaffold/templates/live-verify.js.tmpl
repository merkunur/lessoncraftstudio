#!/usr/bin/env node
/* =====================================================================
   live-verify-__KEY__.js — drives new activity #__NUM__ (__TITLE__) ON
   PRODUCTION: the real activity page in each locale asked for, the real
   iframe, real taps; the wrapper version; one round through the whole miss
   ladder to the celebration; the iframe grows with the card; a screenshot.
   ⚠ SCAFFOLD: rewrite the round walk against the invention.
   Usage: node scripts/live-verify-__KEY__.js [--locales=en,sv,fi] [--out=<dir>]
   ===================================================================== */
'use strict';
const fs = require('fs'), path = require('path');
const arg = (k, d) => { const m = process.argv.find(a => a.startsWith('--' + k + '=')); return m ? m.slice(k.length + 3) : d; };
const LOCALES = arg('locales', 'en,sv,fi').split(',');
const OUT = arg('out', path.join(__dirname, '..', 'docs', 'audit-results', 'activities-rebuild', 'new-__NUM__-__KEY__', 'live'));
const MT = path.join(__dirname, '..', 'mini tools');
const ROW = JSON.parse(fs.readFileSync(path.join(MT, '__KEY__-activities.json'), 'utf8'))[0];
const STR = require(path.join(MT, '__KEY__-activity.js')).strings;
const CORE = require(path.join(MT, '__KEY__-core.js'));
const WRAPPER = (fs.readFileSync(path.join(__dirname, '..', 'frontend', 'app', '[locale]', 'activities', '[slug]', 'page.tsx'), 'utf8').match(/ACTIVITY_WRAPPER_VERSION = '([\d.]+)'/) || [])[1];
const interp = (s, a) => String(s).replace(/\{(\w+)\}/g, (m, k) => (k in a ? a[k] : m));
let PASS = 0, FAIL = 0;
const is = (c, m) => { if (c) PASS++; else { FAIL++; console.error('   FAIL: ' + m); } };
const wait = (ms) => new Promise(r => setTimeout(r, ms));
(async () => {
  fs.mkdirSync(OUT, { recursive: true });
  const puppeteer = require('puppeteer');
  const browser = await puppeteer.launch({ headless: 'new', args: ['--no-sandbox', '--disable-dev-shm-usage'] });
  for (const loc of LOCALES) {
    const url = `https://www.lessoncraftstudio.com/${loc}/activities/${ROW.slug[loc]}`;
    for (const w of [1366, 390]) {
      const page = await browser.newPage();
      await page.setViewport({ width: w, height: w > 500 ? 1000 : 844 });
      const res = await page.goto(url, { waitUntil: 'networkidle2', timeout: 90000 });
      is(res && (res.status() === 200 || res.status() === 304), `[${loc} @${w}] ${url} → ${res && res.status()}`);
      const frameEl = await page.waitForSelector('iframe[src*="__KEY__-activity.html"]', { timeout: 30000 }).catch(() => null);
      is(!!frameEl, `[${loc} @${w}] the page embeds __KEY__-activity.html`);
      if (!frameEl) { await page.close(); continue; }
      is((await page.evaluate(f => f.getAttribute('src'), frameEl)).includes('v=' + WRAPPER), `[${loc} @${w}] wrapper version ${WRAPPER}`);
      const frame = await frameEl.contentFrame();
      await frame.waitForFunction(() => window.__ACT__ && window.__ACT__.st, { timeout: 30000 });
      await wait(400);
      const off = () => page.evaluate(f => { const r = f.getBoundingClientRect(); return { x: r.left, y: r.top }; }, frameEl);
      const tap = async (sel, k, ms) => {
        await frame.evaluate((s, k) => { document.querySelectorAll(s)[k].scrollIntoView({ block: 'center', behavior: 'instant' }); }, sel, k);
        await wait(200); const o = await off();
        const c = await frame.evaluate((s, k) => { const r = document.querySelectorAll(s)[k].getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }, sel, k);
        await page.mouse.click(o.x + c.x, o.y + c.y); await wait(ms || 450);
      };
      const bubble = () => frame.evaluate(() => document.querySelector('.lcs-activity-bubble').textContent);
      await frame.evaluate(() => { const t = window.__ACT__; t._order = t._pool.map((r, i) => i); t._curPass = 0; window.LCS_reloadFirstTask(); });
      await wait(600);
      const r = CORE.rounds('full', '__PFX__')[0], wrong = (r.answer + 1) % r.options.length;
      await tap('.__PFX__-card', wrong); await tap('.lcs-activity-check', 0);
      is((await bubble()) === STR.hintLook[loc], `[${loc} @${w}] wrong → "${await bubble()}"`);
      await tap('.__PFX__-card', r.answer); await tap('.lcs-activity-check', 0, 800);
      const ok = await frame.evaluate(() => ({ cel: document.querySelector('.lcs-activity-prompt').classList.contains('celebrate'), txt: document.querySelector('.lcs-activity-bubble').textContent }));
      is(ok.cel && ok.txt === interp(STR.celebrate[loc], { n: r.target }), `[${loc} @${w}] right → "${ok.txt}"`);
      const fit = await page.evaluate(f => { const fr = f.getBoundingClientRect(); const card = f.contentDocument.querySelector('.lcs-app').getBoundingClientRect(); return { frameH: fr.height, cardH: card.height }; }, frameEl);
      is(fit.frameH >= fit.cardH - 8, `[${loc} @${w}] iframe grows with the card`);
      await page.screenshot({ path: path.join(OUT, `live-${loc}-${w}-done.png`), fullPage: w < 500 });
      await page.close();
    }
  }
  await browser.close();
  console.log(`live-verify-__KEY__: ${PASS} pass, ${FAIL} fail → ${OUT}`);
  process.exit(FAIL ? 1 : 0);
})().catch(e => { console.error(e); process.exit(1); });
