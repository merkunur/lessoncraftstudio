  "blankTitle": "Leeg paspoort",
  "strings": {
    "G2-318": {
      "title": "Dierenpaspoort: {U}",
      "instruction": "Zoek uit wat je over dit dier weet. Schrijf in elke rij van het paspoort één weetje en vul de rest van het blad met je eigen tekening of woorden."
    },
    "G2-339": {
      "title": "Dierenpaspoort {U}: kies de juiste weetjes",
      "instruction": "Lees in elke rij de keuzes en omcirkel de keuze die klopt voor dit dier. Teken daarna waar het leeft en maak de zin af."
    },
    "G2-340": {
      "title": "Dierenpaspoort {U} met woordenbank",
      "instruction": "Zoek elk juist weetje in de woordenbank en schrijf het over in de goede rij van het paspoort. Maak daarna de zin onderaan af."
    },
    "G2-341": {
      "title": "Dierenpaspoort {U}: schrijf drie zinnen",
      "instruction": "Lees het paspoort. Maak de drie zinnen af met weetjes uit het paspoort en schrijf op de laatste lijn nog één weetje van jezelf."
    },
    "G2-342": {
      "title": "Vergelijk twee dieren: hetzelfde en anders",
      "instruction": "Lees beide paspoorten. Omcirkel bij elk weetje hetzelfde of anders. Schrijf daarna twee dingen die hetzelfde zijn en twee die anders zijn."
    },
    "G2-343": {
      "title": "Wie ben ik? Raad het dier",
      "instruction": "Lees de vijf aanwijzingen op elke kaart. Zoek het dier in de plaatjesbank, schrijf zijn naam op de lijn en teken het in het vak."
    }
  }
