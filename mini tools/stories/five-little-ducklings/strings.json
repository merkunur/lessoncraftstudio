  "p01-l01": {
    "en": "The sun was setting over the meadow, and the pond glowed like warm honey.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l02": {
    "en": "It was bedtime for Willa's five little ducklings.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l03": {
    "en": "But when Willa counted her babies, the nest was empty!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l04": {
    "en": "\"Oh no,\" quacked Willa. \"My ducklings are hiding again!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l05": {
    "en": "\"Don't worry,\" said Pip, taking her wing. \"We'll find every single one.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l01": {
    "en": "Down by the water, the tall reeds began to rustle and swish.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l02": {
    "en": "Something small was wiggling deep in the reeds.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l03": {
    "en": "\"I can see tail feathers!\" whispered Pip.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l04": {
    "en": "Can you find the little duckling hiding in the reeds?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l01": {
    "en": "Just then, a tiny giggle floated out from somewhere in the garden.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l02": {
    "en": "Was it the berry bush, or was it the old gray stone?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l03": {
    "en": "\"Listen carefully,\" said Willa. \"My babies always giggle when they hide.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l04": {
    "en": "Where is that little quack coming from? Tap what you hear!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l01": {
    "en": "Farther up the path, the old watering can began to wobble.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l02": {
    "en": "It tipped left, it tipped right — but cans cannot wobble by themselves!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l03": {
    "en": "\"Aha,\" smiled Pip. \"Someone is hiding back there.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l04": {
    "en": "Peek behind the watering can. Do you see her?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l01": {
    "en": "A wiggly line of muddy footprints ran all the way down the hill.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l02": {
    "en": "At the bottom, duckling four was paddling round and round the pond.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l03": {
    "en": "\"He always swims at bedtime,\" sighed Willa.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l04": {
    "en": "Follow the wiggly path with your finger to bring him home.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l01": {
    "en": "By now the sky had grown dark and quiet.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l02": {
    "en": "Little Pep, the sleepiest duckling of all, was still missing.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l03": {
    "en": "\"Pep!\" called Willa softly. \"Where are you, little one?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l04": {
    "en": "Then came a tiny, sleepy quack, soft as a feather.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l05": {
    "en": "\"Listen again,\" whispered Pip. \"Where is Pep hiding?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l01": {
    "en": "Pep was far too sleepy to walk home by himself.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l02": {
    "en": "\"Carry him ever so gently,\" whispered Willa.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l03": {
    "en": "His brothers and sisters were already waiting in the cozy nest.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l04": {
    "en": "Can you bring little Pep home to the nest?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l01": {
    "en": "The nest was full and warm at last.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l02": {
    "en": "\"Let me be sure,\" said Willa. \"I must count my babies.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l03": {
    "en": "\"Count with me!\" said Pip. \"One, two, three...\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l04": {
    "en": "Tap each sleepy duckling and count them all the way to five.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l01": {
    "en": "The stars came out over the quiet meadow, one by one.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l02": {
    "en": "Five little ducklings slept in a row, all safe and warm.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l03": {
    "en": "\"Thank you, Pip,\" whispered Willa. \"And thank you, little friend.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l04": {
    "en": "\"Good night, little ones,\" said Pip softly. \"Good night, everyone.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-bravo": {
    "en": "Out she waddled, shaking pond water from her wings — one duckling found!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-bravo": {
    "en": "Duckling two tumbled out of the berry bush, giggling all over.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-bravo": {
    "en": "There she was! Three little ducklings safe, and two still to find.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-bravo": {
    "en": "Up he hopped, shaking his feathers — splish, splash — four found!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-bravo": {
    "en": "There he was, curled up fast asleep under the willow tree.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-bravo": {
    "en": "Willa tucked him in beside the others — five ducklings, home at last!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-bravo": {
    "en": "One, two, three, four, five — every single duckling home!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  }
}