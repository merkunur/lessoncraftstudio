# ============================================
# WORKSHEET GENERATORS & CONTENT MANAGERS
# ============================================
# Architecture:
# - REFERENCE folders (REFERENCE APPS, REFERENCE CONTENT MANAGERS) = SOURCE OF TRUTH in git
# - Deployed versions (frontend/public/) = NOT in git, deployed manually from REFERENCE folders
# See DEPLOYMENT.md for complete documentation

# Worksheet Generators - ALL HTML files in worksheet-generators (NOT tracked by git)
# These are deployed manually from REFERENCE APPS and REFERENCE CONTENT MANAGERS folders
frontend/public/worksheet-generators/*.html

# Translation Files - NOT tracked by git
# Deployed manually from REFERENCE TRANSLATIONS folder
frontend/public/worksheet-generators/js/translations-*.js
frontend/public/worksheet-generators/translations-*.js
frontend/public/worksheet-generators/js/translations.js

# Content Managers in public root - DEPLOYED VERSIONS (NOT tracked by git)
# These are deployed manually from REFERENCE CONTENT MANAGERS folder
frontend/public/homepage-content-manager.html

# Admin content managers in public/admin - DEPLOYED VERSIONS (NOT tracked by git)
# These are deployed manually from REFERENCE CONTENT MANAGERS folder
frontend/public/admin/*.html

# Content managers folder - DEPLOYED VERSIONS (NOT tracked by git)
# These are deployed manually from REFERENCE CONTENT MANAGERS folder
frontend/public/content-managers/*.html

# Note: REFERENCE APPS/ and REFERENCE CONTENT MANAGERS/ folders ARE tracked by git (source of truth)

# ============================================
# MINI TOOLS (embeddable K-3 micro-tools)
# ============================================
# Architecture (mirrors worksheet-generators):
# - "mini tools/" = SOURCE OF TRUTH in git
# - frontend/public/mini-tools/ = local dev mirror, populated by scripts/master-sync.{bat,sh}
# - /var/www/lcs-media/mini-tools/ = server immutable storage (NOT in git)
# See "mini tools/SERVER-SETUP.md" for one-time Hetzner setup commands.
frontend/public/mini-tools/*

# Test files under "mini tools/" are devtools (Puppeteer smoke tests),
# not source-of-truth tool files. They never get served and never get
# synced into frontend/public/mini-tools/. Excluded from git too.
mini tools/*.test.js

# ============================================
# SAMPLE FILES (images/PDFs for homepage gallery)
# ============================================
# These are large binary files (10GB+) that should NOT be in git
# They are uploaded directly to the server via pscp
frontend/public/samples/
samples/
scripts/sample-inventory.json

# All local working copies and variations (NOT tracked by git)
*-MODIFIED.html
*-CURRENT-PRODUCTION.html
*-CURRENTLY-DEPLOYED.html
*-VERIFY*.html
*-FIX*.html
*-production.html
*-deployed.html
*-current.html

# ============================================
# TEMPORARY DIRECTORIES & ARCHIVES
# ============================================
# Claude Code temporary working directories
tmpclaude-*/
tmpclaude-*-cwd/
**/tmpclaude-*/
**/tmpclaude-*-cwd/

# Analysis and archive folders (local only)
ANALYSIS/
ARCHIVE/

# Sample archives (deployed to server, not in git)
*-samples.tar.gz
frontend/public/*-samples.tar.gz
tmpclaude-*-cwd
**/tmpclaude-*-cwd
*.tar.gz
bfg.jar
backups/
C:temp*
C:Users*
image library/
image-library-webp/

# Stripe product creation (contains internal IDs, one-time use)
scripts/stripe-products-map.json
scripts/create-stripe-products.js

# ============================================
# ASSET DIRECTORIES (local only, not in git)
# ============================================
blog thumbnails/
pinterest-pins/
tpt-thumbnails/

# Design Elements library — extracted SVG artifacts (regenerate via extract-design-elements.js)
# Source of truth: DESIGN_ELEMENTS object inside REFERENCE APPS/coloring.html
# Server storage: /var/www/lcs-media/design-elements/
design-elements-library/
design-elements-sampler.html

# publish-cli (Brief B) dry-run staging output. Per Phase 2 brief Q4:
# default staging dir at repo root, configurable via --staging-dir.
.publish-cli-staging/

# Pillar 1 lesson-plan drafts (operator-authored content; out-of-tree per
# CLAUDE.md §10.4 spirit). Recursive glob covers nested locale-dirs
# (lesson-plan-drafts/{en,de,es,nl}/{slug}.md). Only the template is tracked.
lesson-plan-drafts/**/*.md
!lesson-plan-drafts/_TEMPLATE.md
