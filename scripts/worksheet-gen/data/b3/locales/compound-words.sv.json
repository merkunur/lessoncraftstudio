  "strings": {
    "G2-316": {
      "title": "Sammansatta ord",
      "instruction": "Säg vad de två bilderna heter, sätt ihop orden och skriv det nya ordet på raden."
    },
    "G2-329": {
      "title": "Vad hamnar i mitten? Sammansatta ord med foge-s",
      "instruction": "Båda orden står skrivna. Skriv bokstaven som binder ihop dem i rutan, eller låt rutan vara tom. Skriv sedan hela ordet på raden."
    },
    "G2-330": {
      "title": "Dela det sammansatta ordet i två ord",
      "instruction": "Hela ordet står i bokstavsrutor bredvid bilden. Dra ett streck där det andra ordet börjar."
    },
    "G2-331": {
      "title": "Para ihop halvorna: två bilder, ett ord",
      "instruction": "Dra ett streck från varje första bild till den bild som gör ordet färdigt. Skriv sedan det nya ordet på raden bredvid den första bilden."
    },
    "G2-332": {
      "title": "Orddetektiven: vilka ord är sammansatta?",
      "instruction": "Tolv ord, sex av dem är sammansatta av två ord. Ringa in de sex sammansatta orden och skriv deras två delar på raderna."
    },
    "G2-333": {
      "title": "Ordspindel: ett ord, många sammansättningar",
      "instruction": "Ett ord sitter i mitten. Varje bild runt omkring bildar ett nytt ord med det. Skriv de fyra nya orden på raderna."
    }
  }
