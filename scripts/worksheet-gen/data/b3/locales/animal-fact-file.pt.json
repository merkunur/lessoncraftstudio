    "G2-318": {
      "title": "Tudo sobre o animal: {U}",
      "instruction": "Pesquise sobre este animal. Escreva um fato em cada linha do quadro e depois complete o resto da página com desenhos ou palavras suas."
    },
    "G2-339": {
      "title": "{U}: marque os fatos certos",
      "instruction": "Leia as opções de cada linha e circule a que é verdadeira para este animal. Depois desenhe onde ele vive e complete a frase."
    },
    "G2-340": {
      "title": "{U}: complete com o banco de palavras",
      "instruction": "Ache cada fato verdadeiro no banco de palavras e copie na linha certa do quadro. Depois complete a frase de baixo."
    },
    "G2-341": {
      "title": "{U}: escreva três frases",
      "instruction": "Leia o quadro do animal. Complete as três frases com fatos dele e depois escreva mais um fato seu na última linha."
    },
    "G2-342": {
      "title": "Compare dois animais: igual e diferente",
      "instruction": "Leia os dois quadros. Em cada fato, circule igual ou diferente. Depois escreva duas coisas iguais e duas diferentes."
    },
    "G2-343": {
      "title": "Quem sou eu? Animal misterioso",
      "instruction": "Leia as cinco pistas de cada cartão. Ache o animal no banco de figuras, escreva o nome dele na linha e desenhe no quadro."
