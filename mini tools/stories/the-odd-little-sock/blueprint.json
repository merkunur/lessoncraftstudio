      "narration": [
        {
          "text": "Snow was falling softly on the morning of the Warm Winter Walk."
        },
        {
          "text": "Milo's washing line hung full of cozy pairs: two mittens, two hats, two socks."
        },
        {
          "characterId": "milo",
          "text": "\"Everything I own comes in twos,\" said Milo proudly."
        },
        {
          "text": "Then a big gust of wind came by. WHOOSH! Everything flew everywhere!"
        },
        {
          "characterId": "pip",
          "text": "\"Oh dear,\" said Pip. \"Let's put every pair back together.\""
        }
      ],
      "success": {
        "celebration": "none",
        "holdMs": 600
      }
    },
