  "strings": {
    "G2-317": {
      "title": "Udsagnsord: nutid og datid",
      "instruction": "Se på billedet, og læs udsagnsordet. Skriv dets nutid og datid i de stiplede kasser, og gør så sætningerne færdige."
    },
    "F2": {
      "title": "Forbind udsagnsordet med dets datid",
      "instruction": "Læs hvert udsagnsord til venstre. Tegn en streg til dets datid til højre, én streg til hvert ord."
    },
    "F3": {
      "title": "Udsagnsord i sætninger med billeder",
      "instruction": "Se på billedet, og læs udsagnsordet i brikken. Skriv den form, der passer i sætningen, i den stiplede kasse."
    },
    "F4": {
      "title": "De uregelmæssige udsagnsord: være, have, gå, få, se",
      "instruction": "Disse udsagnsord bøjes helt anderledes. Skriv nutid og datid af hvert af dem i de stiplede kasser."
    },
    "F5": {
      "title": "Vælg den rigtige form af udsagnsordet",
      "instruction": "Læs sætningen. Tre former af udsagnsordet står under den. Sæt ring om den, der passer."
    },
    "F6": {
      "title": "Find udsagnsordet, og skriv navnemåden",
      "instruction": "Sæt streg under udsagnsordet i hver sætning. Skriv så dets navnemåde i den stiplede kasse."
    }
  }
}
