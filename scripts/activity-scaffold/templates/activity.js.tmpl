    var target = api.el('div', '__PFX__-target'); target.setAttribute('aria-hidden', 'true'); this._target = target;
    var row = api.el('div', '__PFX__-row'); this._row = row;
    wrap.appendChild(target); wrap.appendChild(row);
    api.stage.appendChild(wrap);
    this._layout();
    this._paint();
    this._watchWidth();
    void self;
  },
  _layout: function () {
    var L = this._L = __CORE__.layout(this._width()), w = this._wrap;
    ['wide', 'stack'].forEach(function (m) { w.classList.toggle('is-' + m, L.mode === m); });
    w.style.setProperty('--__PFX__-card', L.card + 'px');
    w.style.setProperty('--__PFX__-gap', L.gap + 'px');
  },
  _watchWidth: function () {
    var self = this;
    if (this._ro) { try { this._ro.disconnect(); } catch (e) {} }
    if (typeof ResizeObserver === 'undefined') return;
    var last = this._width();
    this._ro = new ResizeObserver(function () {
      var w = self._width();
      if (Math.abs(w - last) < 8 || !self._wrap || !self._wrap.isConnected) return;
      last = w; self._layout(); self._paint();
    });
    this._ro.observe(this.api.stage);
  },
  _paint: function () {
    var st = this.st, C = __CORE__, self = this, api = this.api, glow = C.revealed(st);
    this._wrap.classList.toggle('is-done', st.done);
    this._target.textContent = String(st.target);
    this._row.innerHTML = '';
    st.options.forEach(function (v, i) {
      var b = api.el('button', '__PFX__-card' + (st.choice === i ? ' is-on' : '') + (glow === i ? ' is-glow' : '')); b.type = 'button';
      b.textContent = String(v);
      b.setAttribute('aria-label', self._t('cardAria', { n: v }));
      b.setAttribute('aria-pressed', String(st.choice === i));
      b.disabled = st.done;
      b.addEventListener('click', function () { self._choose(i); });
      self._row.appendChild(b);
    });
  },

  /* ---------------- the hand ---------------- */
  _choose: function (i) {
    if (!__CORE__.choose(this.st, i)) return;
    this.api.sound(500);
    this._paint();
    this.api.track('choose', { i: i });
  },
  _afterCheck: function (res) {
    this._paint();
    if (res.slip === 'none') return;
    this.api.sound(res.ok ? 660 : 280);
    this.api.track('check', { id: this.st.id, ok: res.ok, misses: this.st.misses });
  }
};

var __PFX__CssDone = false;
