  "strings": {
    "K-323": {
      "title": "Mi presento",
      "instruction": "Scrivi il tuo nome e la tua età, disegna te e la tua famiglia, poi disegna le tue tre cose preferite."
    },
    "K-342": {
      "title": "Le mie cose preferite: cerchia e scrivi",
      "instruction": "In ogni fila cerchia il tuo disegno preferito e copia la sua parola sulla riga."
    },
    "K-343": {
      "title": "La mia famiglia: disegna e conta",
      "instruction": "Disegna la tua famiglia. Poi mostra sulle tabelle del dieci quante persone, fratelli, sorelle e animali ci sono e scrivi il numero."
    },
    "K-344": {
      "title": "Sono io: le parti del viso",
      "instruction": "Copia ogni parola della lista sulla riga che indica quella parte del viso. Poi disegna la tua faccia."
    },
    "K-345": {
      "title": "So fare: metti una crocetta",
      "instruction": "Leggi ogni frase e metti una crocetta sulle cose che sai fare. Poi scrivi una cosa che vuoi imparare."
    },
    "K-346": {
      "title": "Il mio nome: scrivi, conta e confronta",
      "instruction": "Scrivi il tuo nome con una lettera in ogni casella e conta le lettere. Fai lo stesso con il nome di un amico e cerchia chi ne ha di più."
    }
  },
