  "p01-l01": {
    "en": "One sunny morning, Bo the beaver pulled his little cart up the lane.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l02": {
    "en": "Bump! The cart hopped over a stone, and the round wheel popped right off.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l03": {
    "en": "It bounced twice, then rolled away down the hill, spinning as it went.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l04": {
    "en": "\"My wheel!\" cried Bo. \"Come back, little wheel!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l05": {
    "en": "\"Come on, Bo,\" said Pip. \"Let's follow it together!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l01": {
    "en": "Bo dragged the big square crate under the cart to try it as a wheel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l02": {
    "en": "Bump, bump, bump — the crate would not roll at all.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l03": {
    "en": "\"Square things just sit flat,\" puffed Bo.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l04": {
    "en": "\"Round things roll,\" said Pip. \"Which shape is round, like the wheel?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l01": {
    "en": "The wheel had left a long, curvy trail in the soft dust.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l02": {
    "en": "It wound down the lane, past the grass, and out of sight.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l03": {
    "en": "\"It went that way!\" said Bo.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l04": {
    "en": "Follow the rolling trail with your finger!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l01": {
    "en": "The trail ended right in the middle of the pumpkin patch.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l02": {
    "en": "Everywhere they looked, something round was smiling back at them.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l03": {
    "en": "\"Pumpkins are round too!\" laughed Bo. \"Where is my wheel?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l04": {
    "en": "Look closely and find the wheel hiding among the pumpkins!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l01": {
    "en": "Then, all at once, everything went very quiet.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l02": {
    "en": "\"Shhh,\" whispered Pip. \"I can hear it rolling somewhere.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l03": {
    "en": "From behind came a deep, rumbly sound: rumble, rumble, rumble.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l04": {
    "en": "\"Listen!\" said Bo. \"Which one is the wheel hiding in?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l01": {
    "en": "Bo rolled the wheel out into the light. It was covered in mud!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l02": {
    "en": "\"Is it still perfectly round?\" asked Bo, squinting hard.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l03": {
    "en": "Tap all the way around the wheel to make sure!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l01": {
    "en": "Together they pushed the wheel all the way home to the cart.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l02": {
    "en": "\"It fits the round hole,\" said Bo, \"not the square one.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l03": {
    "en": "Can you put the wheel back where it fits?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l01": {
    "en": "Now the little cart needed all its things back in their places.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l02": {
    "en": "\"The square crate sits flat on top,\" said Bo. \"And the triangle flag stands tall!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l03": {
    "en": "Find the square and the triangle and load them up!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l01": {
    "en": "Down the lane they rolled, all the way home in the golden light.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l02": {
    "en": "The round wheel spun and spun, singing its rolling song.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l03": {
    "en": "\"Thank you, little friend,\" said Bo. \"Tap, tap!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l04": {
    "en": "\"What a rolling, rolling day,\" smiled Pip. \"Goodbye!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-bravo": {
    "en": "The circle rolls and rolls — just like the runaway wheel!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-bravo": {
    "en": "The trail rolled on and on, faster and faster, down the hill.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-bravo": {
    "en": "There it was! But off it rolled again, out of the patch.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-bravo": {
    "en": "It had rolled right inside the big round barrel!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-bravo": {
    "en": "Perfectly round, all the way around — good as new!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-bravo": {
    "en": "Click! The wheel slid onto the round axle, and the cart stood tall.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-bravo": {
    "en": "Square sits flat, triangle stands tall, and the circle rolls — all aboard!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  }
}