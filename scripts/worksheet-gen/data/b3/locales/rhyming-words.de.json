  "strings": {
    "G1-309": {
      "title": "Reimwörter: Reimen und schreiben",
      "instruction": "Sprich das erste Bild. Kreise das Bild ein, das sich darauf reimt, und schreibe sein Wort auf die Linie."
    },
    "K-352": {
      "title": "Reimt sich das?",
      "instruction": "Sprich beide Bilder laut. Wenn sich die zwei Wörter reimen, kreise den Haken ein. Wenn nicht, kreise das Kreuz ein."
    },
    "G1-343": {
      "title": "Reimwörter sortieren",
      "instruction": "Sprich jedes Bild in der Wortliste. Finde das große Bild, auf das es sich reimt, und schreibe sein Wort auf eine Linie darunter."
    },
    "G1-344": {
      "title": "Reime vervollständigen",
      "instruction": "Lies die zwei Zeilen laut. Schau das Bild an, höre den Reim und schreibe das fehlende Reimwort auf die Linie."
    },
    "G1-345": {
      "title": "Reimketten",
      "instruction": "Sprich jedes Bild. Finde die zwei Wörter in der Wortliste, die sich darauf reimen, und schreibe sie auf seine Linien. Manche passen nirgends."
    },
    "G1-346": {
      "title": "Eigene Reimwörter schreiben",
      "instruction": "Lies das Wort neben jedem Bild. Überlege dir zwei Wörter, die sich darauf reimen, und schreibe auf jede Linie eines."
    }
  }
}
