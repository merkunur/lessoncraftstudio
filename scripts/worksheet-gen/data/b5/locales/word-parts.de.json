  "strings": {
    "base": {
      "title": "Wortfamilien: nach dem Wortstamm sortieren",
      "instruction": "Lies jedes Wort oben und schreibe es auf eine Linie der Mauer, die auf seinem Wortstamm steht."
    },
    "picture-family": {
      "title": "Wortfamilien mit Bildern: das passende Wort finden",
      "instruction": "Sag, was du auf jedem Bild siehst, und kreise darüber das eine Wort ein, das aus diesem Bildwort gebaut ist."
    },
    "root-word": {
      "title": "Den Wortstamm finden",
      "instruction": "Kreise den Teil ein, den die drei Wörter gemeinsam haben, und schreibe den Wortstamm in den leeren Stein."
    },
    "prefix-key": {
      "title": "Vorsilben ein-, aus- und um-: nach Bedeutung wählen",
      "instruction": "Lies, was jedes neue Wort bedeutet, finde seine Vorsilbe im Schlüssel und schreibe sie in das leere Stück."
    },
    "who-does-it": {
      "title": "Wer macht das? Personenwörter bilden",
      "instruction": "Schau dir jede Person an, lies das Wort daneben und schreibe das Personenwort mit -er oder -erin in das gestrichelte Kästchen."
    },
    "family-in-sentence": {
      "title": "Wortfamilien im Satz",
      "instruction": "Schreibe jedes Wort von den vier Karten in den Satz, in den es passt."
    }
  }
