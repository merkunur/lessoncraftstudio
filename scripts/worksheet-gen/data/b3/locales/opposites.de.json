  "strings": {
    "G1-307": {
      "title": "Gegenteile: Schreibe das Gegenteil",
      "instruction": "Lies das Wort auf jeder Karte. Suche sein Gegenteil in der Wortliste und schreibe es auf die Linie."
    },
    "K-351": {
      "title": "Gegensatzpaare mit Bildern verbinden",
      "instruction": "Verbinde jedes Bild mit dem Bild und dem Wort, die sein Gegenteil zeigen."
    },
    "G1-335": {
      "title": "Gegenteile im Satz",
      "instruction": "Lies jeden Satz. Schreibe das Gegenteil des Wortes nach „nicht“ auf die Linie. Die Wortliste hilft dir."
    },
    "G1-336": {
      "title": "Gegensatzpaare finden",
      "instruction": "Suche die zwei Wörter, die Gegenteile sind. Schreibe jedes Paar auf eine Linie, ein Wort auf jede Seite des Pfeils."
    },
    "G1-337": {
      "title": "Gegenteil oder gleiche Bedeutung?",
      "instruction": "Lies das Wort. Eines der drei Wörter darunter bedeutet das Gegenteil. Kreise es ein, nicht das Wort mit der gleichen Bedeutung."
    },
    "G2-320": {
      "title": "Gegenteile mit der Vorsilbe un-",
      "instruction": "Setze die Vorsilbe vor jedes Wort und schreibe das neue Gegenteil auf die Linie."
    }
  }
