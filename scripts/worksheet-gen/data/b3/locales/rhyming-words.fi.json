  "strings": {
    "G1-309": {
      "title": "Riimisanat: rimmaa ja kirjoita",
      "instruction": "Sano ensimmäinen kuva ääneen. Ympyröi kuva, joka rimmaa sen kanssa, ja kirjoita sitten sen sana viivalle."
    },
    "K-352": {
      "title": "Rimmaako vai ei?",
      "instruction": "Sano molemmat kuvat ääneen. Jos sanat rimmaavat, ympyröi väkänen. Jos ne eivät rimmaa, ympyröi ruksi."
    },
    "G1-343": {
      "title": "Lajittele riimisanat",
      "instruction": "Sano jokainen sanapankin kuva. Etsi iso kuva, jonka kanssa se rimmaa, ja kirjoita sana viivalle sen kuvan alle."
    },
    "G1-344": {
      "title": "Täydennä loru: puuttuva riimisana",
      "instruction": "Lue lorun kaksi riviä ääneen. Katso kuvaa, kuuntele riimi ja kirjoita puuttuva riimisana viivalle."
    },
    "G1-345": {
      "title": "Riimiketjut",
      "instruction": "Sano jokainen kuva. Etsi sanapankista kaksi sanaa, jotka rimmaavat sen kanssa, ja kirjoita ne viivoille. Osa sanoista ei sovi mihinkään."
    },
    "G1-346": {
      "title": "Keksi omat riimisanat",
      "instruction": "Lue kuvan vieressä oleva sana. Keksi kaksi sanaa, jotka rimmaavat sen kanssa, ja kirjoita yksi kummallekin viivalle."
    }
  }
}
