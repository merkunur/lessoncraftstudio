  "_panelOpened": "sv-panel-sheet-rhyme-*.png",
  "strings": {
    "G1-309": {
      "title": "Rimord: rimma och skriv",
      "instruction": "Säg den första bilden. Ringa in bilden som rimmar på den och skriv sedan ordet på raden."
    },
    "K-352": {
      "title": "Rimmar det? Ja eller nej",
      "instruction": "Säg båda bilderna högt. Om orden rimmar ringar du in bocken. Om de inte rimmar ringar du in krysset."
    },
    "G1-343": {
      "title": "Sortera rimorden",
      "instruction": "Säg varje bild i banken. Hitta den stora bild den rimmar på och skriv ordet på en rad under den bilden."
    },
    "G1-344": {
      "title": "Gör rimmet färdigt",
      "instruction": "Läs de två raderna högt. Titta på bilden, hör rimmet och skriv rimordet som saknas på raden."
    },
    "G1-345": {
      "title": "Rimkedjor: tre ord som rimmar",
      "instruction": "Säg varje bild. Hitta de två ord i banken som rimmar på den och skriv dem på raderna. Några ord passar ingenstans."
    },
    "G1-346": {
      "title": "Hitta på egna rimord",
      "instruction": "Läs ordet bredvid varje bild. Kom på två ord som rimmar på det och skriv ett på varje rad."
    }
  }
}
