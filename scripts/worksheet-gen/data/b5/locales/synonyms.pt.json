  "strings": {
    "base": {
      "title": "Sinônimos: circule a palavra com o mesmo significado",
      "instruction": "Leia a palavra grande de cada cartão e circule a palavra embaixo dela que tem o mesmo significado."
    },
    "pictures": {
      "title": "Sinônimos com figuras: duas palavras para uma figura",
      "instruction": "Observe cada figura e circule as duas palavras embaixo dela que têm o mesmo significado e combinam com a figura."
    },
    "pairs": {
      "title": "Pares de sinônimos: ligue as palavras de mesmo significado",
      "instruction": "Ligue cada palavra da esquerda à palavra da direita que tem o mesmo significado."
    },
    "shades": {
      "title": "Graus de intensidade: do mais fraco ao mais forte",
      "instruction": "Leia as três palavras de cada fileira e escreva 1, 2 e 3 nos quadrinhos, da palavra mais fraca para a mais forte."
    },
    "say": {
      "title": "Sinônimos de disse: verbos de elocução",
      "instruction": "Leia cada frase e escreva no quadrinho a palavra do balão que combina melhor no lugar de disse."
    },
    "fields": {
      "title": "Campo semântico: palavras para ir e para olhar",
      "instruction": "Leia as dez palavras e escreva cada uma no campo da palavra que tem quase o mesmo significado."
    }
  }
