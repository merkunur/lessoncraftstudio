  "strings": {
    "base": {
      "title": "I sinonimi: cerchia la parola che vuol dire la stessa cosa",
      "instruction": "Leggi la parola grande su ogni cartellino e cerchia, sotto, la parola che vuol dire la stessa cosa."
    },
    "pictures": {
      "title": "I sinonimi con le immagini: due parole per un’immagine",
      "instruction": "Guarda ogni immagine e cerchia, sotto, le due parole che vogliono dire la stessa cosa e descrivono l’immagine."
    },
    "pairs": {
      "title": "Collega le coppie di sinonimi",
      "instruction": "Traccia una linea per collegare ogni parola a sinistra con la parola a destra che vuol dire la stessa cosa."
    },
    "shades": {
      "title": "Le sfumature di significato: dalla più debole alla più forte",
      "instruction": "Leggi le tre parole di ogni riga e scrivi 1, 2 e 3 nei riquadri, dalla parola più debole alla più forte."
    },
    "say": {
      "title": "I sinonimi di dire: scegli la parola giusta",
      "instruction": "Leggi ogni frase e scrivi nel riquadro la parola del fumetto che sta meglio al posto di «dice»."
    },
    "fields": {
      "title": "Il campo semantico di andare e di guardare",
      "instruction": "Leggi le dieci parole e scrivi ognuna nel campo del verbo a cui è più vicina per significato."
    }
  }
