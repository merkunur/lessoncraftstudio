    "K-323": {
      "title": "Todo sobre mí",
      "instruction": "Escribe tu nombre y tu edad, dibújate a ti y a tu familia y después dibuja tus tres cosas favoritas."
    },
    "K-342": {
      "title": "Mis cosas favoritas: rodea y escribe",
      "instruction": "En cada fila, rodea tu dibujo favorito y copia su palabra en la línea."
    },
    "K-343": {
      "title": "Mi familia: dibuja y cuenta",
      "instruction": "Dibuja a tu familia. Luego muestra en los marcos de diez cuántas personas, hermanos, hermanas y mascotas hay y escribe el número."
    },
    "K-344": {
      "title": "Así soy yo: las partes de la cara",
      "instruction": "Copia cada palabra del banco en la línea que apunta a esa parte de la cara. Después dibuja tu propia cara."
    },
    "K-345": {
      "title": "Yo puedo: marca lo que sabes hacer",
      "instruction": "Lee cada oración y marca las cosas que sabes hacer. Luego escribe una cosa que quieres aprender."
    },
    "K-346": {
      "title": "Mi nombre: escribe, cuenta y compara",
      "instruction": "Escribe tu nombre con una letra en cada casilla y cuenta las letras. Haz lo mismo con el nombre de un amigo y rodea quién tiene más."
    }
