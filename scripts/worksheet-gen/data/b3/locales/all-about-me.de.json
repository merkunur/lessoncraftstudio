  "strings": {
    "K-323": {
      "title": "Das bin ich",
      "instruction": "Schreibe deinen Namen und dein Alter, zeichne dich und deine Familie und dann deine drei Lieblingsdinge."
    },
    "K-342": {
      "title": "Meine Lieblingsdinge: Einkreisen und abschreiben",
      "instruction": "Kreise in jeder Reihe dein Lieblingsbild ein und schreibe sein Wort auf die Linie."
    },
    "K-343": {
      "title": "Meine Familie: Zeichnen und zählen",
      "instruction": "Zeichne deine Familie. Zeige dann auf den Zehnerfeldern, wie viele Personen, Brüder, Schwestern und Haustiere es sind, und schreibe die Zahl."
    },
    "K-344": {
      "title": "Mein Gesicht: Beschrifte die Teile",
      "instruction": "Schreibe jedes Wort aus der Wortliste auf die Linie, die zu diesem Teil des Gesichts zeigt. Zeichne dann dein eigenes Gesicht."
    },
    "K-345": {
      "title": "Ich kann das schon: Hake ab, was du kannst",
      "instruction": "Lies jeden Satz und hake ab, was du schon kannst. Schreibe dann eine Sache auf, die du noch lernen möchtest."
    },
    "K-346": {
      "title": "Mein Name: Schreiben, zählen und vergleichen",
      "instruction": "Schreibe deinen Namen mit einem Buchstaben pro Kästchen und zähle die Buchstaben. Mach dasselbe für einen Freund und kreise ein, wer mehr hat."
    }
  },
