  "strings": {
    "G2-316": {
      "title": "Sammensatte ord: Bilde + bilde",
      "instruction": "Si navnet på de to bildene, sett de to ordene sammen og skriv det nye ordet på linja."
    },
    "G2-329": {
      "title": "Binde-e eller ikke? Sammensatte ord",
      "instruction": "Begge ordene står der allerede. Skriv bokstaven som binder dem sammen i ruten, eller la den stå tom. Skriv så hele ordet."
    },
    "G2-330": {
      "title": "Del opp det sammensatte ordet",
      "instruction": "Hele ordet står i bokstavruter ved siden av bildet sitt. Tegn en strek der det andre ordet begynner."
    },
    "G2-331": {
      "title": "Koble orddelene: To bilder, ett ord",
      "instruction": "Tegn en strek fra hvert første bilde til bildet som fullfører ordet. Skriv så det nye ordet på linja ved det første bildet."
    },
    "G2-332": {
      "title": "Orddetektiv: Sammensatt eller ikke?",
      "instruction": "Tolv ord, seks av dem er satt sammen av to ord. Sett ring rundt de seks sammensatte ordene og skriv de to delene på linjene."
    },
    "G2-333": {
      "title": "Ordstjerne: Ett ord, mange ord",
      "instruction": "Ett ord står i midten. Hvert bilde rundt danner et nytt ord sammen med det. Skriv de fire nye ordene på linjene."
    }
  }
}
