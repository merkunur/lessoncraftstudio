  "strings": {
    "G2-317": {
      "title": "Verbformen: ich, du, er, wir, ihr, sie",
      "instruction": "Schau das Bild an und lies das Verb. Schreibe seine Personalformen in die gestrichelten Kästchen und vervollständige dann die Sätze."
    },
    "F2": {
      "title": "Verbformen zuordnen: Wer macht was?",
      "instruction": "Lies jedes Personalwort links. Verbinde es mit der passenden Verbform rechts, eine Linie für jedes Wort."
    },
    "F3": {
      "title": "Verbformen im Satz mit Bildern",
      "instruction": "Schau das Bild an und lies das Verb im Kästchen. Schreibe die Form, die in den Satz passt, in das gestrichelte Kästchen."
    },
    "F4": {
      "title": "Die Hilfsverben sein und haben",
      "instruction": "Diese Verben verändern sich stark. Schreibe zu jeder Person die richtige Form in das gestrichelte Kästchen."
    },
    "F5": {
      "title": "Wähle die richtige Verbform",
      "instruction": "Lies den Satz. Darunter stehen drei Formen des Verbs. Kreise die Form ein, die passt."
    },
    "F6": {
      "title": "Finde das Verb und schreibe die Grundform",
      "instruction": "Unterstreiche das Verb in jedem Satz. Schreibe dann seine Grundform in das gestrichelte Kästchen."
    }
  }
}
