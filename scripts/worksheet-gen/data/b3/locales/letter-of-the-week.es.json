  "refuse": {},
  "strings": {
    "K-317": {
      "title": "La letra {U}{L}: repasa, busca y escribe",
      "instruction": "Repasa la letra mayúscula y la minúscula, rodea los cuatro dibujos que empiezan con {U} y escribe una fila de cada una."
    },
    "K-325": {
      "title": "Palabras con {U}: el sonido en cualquier lugar",
      "instruction": "Repasa la letra y rodea los cuatro dibujos que tienen el sonido {U} dentro de la palabra, no al principio."
    },
    "K-326": {
      "title": "¿Al principio, en medio o al final? La letra {U}",
      "instruction": "Di el nombre de cada dibujo. Colorea la casilla que muestra dónde suena la {U}: al principio, en medio o al final."
    },
    "K-327": {
      "title": "Rodea la {U} en las palabras y cuenta",
      "instruction": "Busca todas las {U} y {L} de cada palabra y rodéalas. Después escribe en la casilla cuántas encontraste."
    },
    "G1-311": {
      "title": "Dos letras, un solo sonido: {U}",
      "instruction": "Repasa {L}, rodea los cuatro dibujos que tienen el sonido {L} y escribe una fila."
    },
    "K-328": {
      "title": "¿L o R? Escucha la diferencia",
      "instruction": "Di el nombre de cada dibujo. Rodea la letra con la que empieza: l o r."
    }
  }
}
