  "strings": {
    "base": {
      "title": "Personalpronomen: er, sie oder es",
      "instruction": "Schau dir das Bild an und lies das Wort darunter. Kreise das Wort ein, das wir stattdessen sagen können."
    },
    "replace": {
      "title": "Personalpronomen einsetzen",
      "instruction": "Lies den Satz. Schreibe das Wort aus dem Kasten, das im zweiten Satz den Namen ersetzt, in das Kästchen.",
      "bankWord": "Kasten"
    },
    "anaphora": {
      "title": "Wer ist gemeint? Pronomen im Satz",
      "instruction": "Lies die Sätze. Ziehe eine Linie von jedem Wort im Rahmen zu dem Namen, für den es steht."
    },
    "possessive": {
      "title": "Possessivpronomen: sein oder ihr?",
      "instruction": "Schau, wem das Ding gehört. Kreise das Wort ein, das zu dieser Person passt."
    },
    "sort": {
      "title": "Namen sortieren: er, sie oder es?",
      "instruction": "Lies jede Karte. Schreibe das Wort auf der Karte unter das Wort, das wir dafür sagen."
    },
    "rewrite": {
      "title": "Sätze mit Pronomen umschreiben",
      "instruction": "Lies den Satz. Schreibe ihn noch einmal auf die Linien, aber setze für den Namen ein Pronomen ein."
    }
  }
}
