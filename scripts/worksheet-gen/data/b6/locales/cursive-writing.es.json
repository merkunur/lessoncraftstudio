  "strings": {
    "G2-377": {
      "title": "Letra cursiva: las vocales a, e, i, o, u",
      "instruction": "Repasa las letras grises y sigue escribiendo cada letra ligada por tu cuenta hasta el final del renglón y en el renglón vacío de abajo."
    },
    "G2-384": {
      "title": "Mayúsculas en letra cursiva: escribe los nombres",
      "instruction": "Repasa cada letra mayúscula gris y cada nombre, y luego escríbelos en el renglón vacío de abajo."
    },
    "G2-385": {
      "title": "Letra cursiva: cómo unir dos letras",
      "instruction": "Repasa cada par de letras grises unidas y la palabra, y luego escríbelos en el renglón vacío de abajo."
    },
    "G2-386": {
      "title": "Palabras en letra cursiva con dibujos",
      "instruction": "Repasa cada palabra gris, luego escríbela en el renglón de abajo y al final agrega los puntos, la rayita de la t y los acentos."
    },
    "G2-387": {
      "title": "Lectura en letra cursiva: une cada palabra con su dibujo",
      "instruction": "Lee cada palabra en letra cursiva y únela con una línea a su dibujo."
    },
    "G3-401": {
      "title": "Oraciones para copiar en letra cursiva",
      "instruction": "Repasa la oración gris y luego copia cada oración en letra cursiva en los dos renglones de abajo."
    }
  }
