    "K-323": {
      "title": "C'est moi : mon prénom, mon âge, ma famille",
      "instruction": "Écris ton prénom et ton âge, dessine-toi avec ta famille, puis dessine tes trois choses préférées."
    },
    "K-342": {
      "title": "Mes choses préférées : entoure et écris",
      "instruction": "Dans chaque ligne, entoure ton image préférée et recopie son mot sur la ligne."
    },
    "K-343": {
      "title": "Ma famille : dessine et compte",
      "instruction": "Dessine ta famille. Montre sur les cartes à dix le nombre de personnes, de frères, de sœurs et d'animaux, puis écris-le."
    },
    "K-344": {
      "title": "C'est moi : les parties du visage",
      "instruction": "Recopie chaque mot de la liste sur la ligne qui montre cette partie du visage. Puis dessine ton propre visage."
    },
    "K-345": {
      "title": "Je sais : coche ce que tu sais faire",
      "instruction": "Lis chaque phrase et coche ce que tu sais faire. Puis écris une chose que tu veux apprendre."
    },
