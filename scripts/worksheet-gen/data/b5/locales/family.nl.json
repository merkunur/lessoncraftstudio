  "strings": {
    "base": {
      "title": "Familieleden: wie is wie in de stamboom?",
      "instruction": "Zoek elke persoon in de stamboom en schrijf het nummer in het vakje naast het goede familiewoord."
    },
    "generations": {
      "title": "Generaties in de familie: van oud naar jong",
      "instruction": "Schrijf in elke rij 1, 2 en 3 in de vakjes, van de oudste generatie naar de jongste."
    },
    "trace-words": {
      "title": "Familiewoorden overtrekken en schrijven",
      "instruction": "Zoek de persoon met hetzelfde nummer in de stamboom, trek het familiewoord over en schrijf het nog een keer op de lijn."
    },
    "tree-clues": {
      "title": "Stamboom invullen met aanwijzingen",
      "instruction": "Lees de aanwijzingen en schrijf elke naam in het goede naamvak van de stamboom."
    },
    "relation-riddles": {
      "title": "Raadsels over familie: wie is het?",
      "instruction": "Lees elk raadsel en schrijf het goede familiewoord uit het kader op de lijn; een woord kan bij meer raadsels horen."
    },
    "tree-template": {
      "title": "Lege stamboom om zelf in te vullen",
      "instruction": "Teken de mensen die belangrijk voor je zijn in de lijstjes en schrijf hun namen op de lijnen."
    }
  }
