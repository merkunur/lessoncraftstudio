{
  "schemaVersion": "sb-1",
  "id": "pips-picnic",
  "title": "@story.title",
  "locales": ["en"],
  "theme": { "letterboxColor": "#FBF3E4", "transition": "crossfade" },

  "cast": [
    {
      "id": "pip",
      "name": "@cast.pip.name",
      "role": "guide",
      "atlasBase": "atlas.pip.base",
      "atlasClips": "atlas.pip.clips",
      "poses": ["neutral", "talk", "happy", "point"],
      "clips": { "celebrate": { "fallbackPose": "happy" } }
    }
  ],

  "assets": {
    "atlas.pip.base":  { "kind": "atlas", "src": "/mini-tools/stories/pips-picnic/cast/pip/pip.base.json" },
    "atlas.pip.clips": { "kind": "atlas", "src": "/mini-tools/stories/pips-picnic/cast/pip/pip.clips.json" },
    "scene.meadow":  { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-01.webp", "size": { "w": 1600, "h": 1000 } },
    "scene.blanket": { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-02.webp", "size": { "w": 1600, "h": 1000 } },
    "scene.stream":  { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-03.webp", "size": { "w": 1600, "h": 1000 } },
    "scene.sunset":  { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-04.webp", "size": { "w": 1600, "h": 1000 } },
    "img.apple":  { "kind": "image", "src": "/image-library-webp/themes/fruits/apple@2x.webp", "vocab": "apple" },
    "img.banana": { "kind": "image", "src": "/image-library-webp/themes/fruits/banana@2x.webp", "vocab": "banana" },
    "img.boots":  { "kind": "image", "src": "/image-library-webp/themes/clothing/boots@2x.webp", "vocab": "boots" },
    "img.hat":    { "kind": "image", "src": "/image-library-webp/themes/clothing/hat@2x.webp", "vocab": "hat" },
    "img.ball":   { "kind": "image", "src": "/image-library-webp/themes/toys/ball@2x.webp", "vocab": "ball" },
    "img.cat":    { "kind": "image", "src": "/image-library-webp/themes/animals/cat@2x.webp", "vocab": "cat" }
  },

  "reward": {
    "id": "story.pips-picnic",
    "label": { "en": "Pip's picnic basket" },
    "emoji": "🧺"
  },

  "pages": [
