  "strings": {
    "G2-317": {
      "title": "Verb: Presens og preteritum",
      "instruction": "Se på bildet og les verbet. Skriv formen for nå og formen for i går i de stiplede rutene, og fullfør så setningene."
    },
    "F2": {
      "title": "Koble verbet til preteritumsformen",
      "instruction": "Les hvert verb til venstre. Tegn en strek til formen for i går til høyre, én strek for hvert verb."
    },
    "F3": {
      "title": "Verbformer i setninger med bilder",
      "instruction": "Se på bildet og les verbet i brikken. Skriv formen som passer i setningen, i den stiplede ruten."
    },
    "F4": {
      "title": "De uregelrette verbene: være, ha, gå, få, se",
      "instruction": "Disse verbene forandrer seg mye. Skriv formen for nå og formen for i går for hvert av dem i de stiplede rutene."
    },
    "F5": {
      "title": "Velg riktig verbform",
      "instruction": "Les setningen. Under står tre former av verbet. Sett ring rundt den som passer."
    },
    "F6": {
      "title": "Finn verbet og skriv infinitiven",
