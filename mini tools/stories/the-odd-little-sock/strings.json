  "cast.milo.name": {
    "en": "Milo",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l01": {
    "en": "Snow was falling softly on the morning of the Warm Winter Walk.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l02": {
    "en": "Milo's washing line hung full of cozy pairs: two mittens, two hats, two socks.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l03": {
    "en": "\"Everything I own comes in twos,\" said Milo proudly.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l04": {
    "en": "Then a big gust of wind came by. WHOOSH! Everything flew everywhere!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l05": {
    "en": "\"Oh dear,\" said Pip. \"Let's put every pair back together.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l01": {
    "en": "One red mitten sat all alone in the snow, cold and quiet.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l02": {
    "en": "\"Its twin looks just the same,\" said Milo. \"Red, with a snowflake.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l03": {
    "en": "Two mittens peeked out of the snowdrift. Only one was truly the same.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l04": {
    "en": "Can you find the mitten that looks just the same?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l01": {
    "en": "Next they found a bobble hat, dusted with snow.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l02": {
    "en": "\"Its twin is already on the line!\" said Milo.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l03": {
    "en": "Same belongs beside same, snug as can be.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l04": {
    "en": "Can you hang the hat next to its twin?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l01": {
    "en": "Then came a sock with bold blue stripes.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l02": {
    "en": "Three socks lay in the snow, and they were almost the same.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l03": {
    "en": "\"Almost is not the same!\" laughed Milo. \"Look very carefully.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l04": {
    "en": "Which sock is truly the same as the striped one?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l01": {
    "en": "At the very bottom of the basket lay one small yellow sock.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l02": {
    "en": "They looked and looked, but it matched nothing at all.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l03": {
    "en": "\"It is different from everything,\" said Milo sadly.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l04": {
    "en": "Then, from somewhere above, came a tiny sound: cheep, cheep!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l05": {
    "en": "\"Listen!\" whispered Pip. \"Where is that little cheep coming from?\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l01": {
    "en": "Up in the birdhouse sat a little snowbird, fluffed against the cold.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l02": {
    "en": "And tucked in her nest was the OTHER yellow sock!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l03": {
    "en": "\"The odd sock has a twin after all,\" said Milo. \"It belongs to a new friend!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l04": {
    "en": "Can you bring the yellow sock up to her nest?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l01": {
    "en": "The washing line was full again, pair after cozy pair.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l02": {
    "en": "\"Wait,\" said Milo, squinting. \"One of these is playing a trick on us.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l03": {
    "en": "One thing on the line did not match its partner at all.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l04": {
    "en": "Can you find the one that is different?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l01": {
    "en": "Then it was time for the Warm Winter Walk at last.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l02": {
    "en": "Everyone wore their warm and cozy twos.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l03": {
    "en": "The little snowbird came too, wearing her yellow socks like tiny boots.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l04": {
    "en": "\"Wheee!\" laughed Milo. \"Best walk ever!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l01": {
    "en": "The snow fell softly all the way home.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l02": {
    "en": "\"Same keeps you warm,\" said Pip.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l03": {
    "en": "\"And different makes a friend,\" said Milo.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l04": {
    "en": "High in her birdhouse, the little snowbird cheeped good night.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-bravo": {
    "en": "The two red mittens sat together again, warm as toast!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-bravo": {
    "en": "The twin hats swung side by side on the line.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-bravo": {
    "en": "Stripes with stripes! The socks curled up together happily.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-bravo": {
    "en": "The cheep was coming from the little birdhouse!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-bravo": {
    "en": "The snowbird tucked the two yellow socks together and cheeped with joy!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-bravo": {
    "en": "The dotty sock hopped back to its true twin. All matched!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
