      "title": "Vastakohdat: kirjoita vastakohta",
      "instruction": "Lue kortin sana. Etsi sen vastakohta sanapankista ja kirjoita se viivalle."
    },
    "K-351": {
      "title": "Vastakohdat kuvina: yhdistä parit",
      "instruction": "Piirrä viiva jokaisesta kuvasta siihen kuvaan ja sanaan, joka on sen vastakohta."
    },
    "G1-335": {
      "title": "Vastakohdat lauseessa",
      "instruction": "Lue lause. Kirjoita viivalle sen sanan vastakohta, joka tulee sanan \"ei\" jälkeen. Sanapankki auttaa."
    },
    "G1-336": {
      "title": "Etsi vastakohtaparit",
      "instruction": "Etsi sanoista kaksi, jotka ovat toistensa vastakohtia. Kirjoita jokainen pari viivalle nuolen molemmin puolin."
    },
    "G1-337": {
      "title": "Vastakohta vai sama? Ympyröi vastakohta",
      "instruction": "Lue sana. Yksi kolmesta sanasta sen alla tarkoittaa vastakohtaa. Ympyröi se, älä sanaa, joka tarkoittaa samaa."
    },
    "G2-320": {
      "title": "Vastakohta etuliitteellä epä-",
      "instruction": "Lisää sanan eteen etuliite epä- ja kirjoita uusi vastakohtasana viivalle."
