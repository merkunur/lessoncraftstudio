  "strings": {
    "G1-307": {
      "title": "Tegenstellingen: schrijf het tegenovergestelde woord",
      "instruction": "Lees het woord op elke kaart. Zoek het tegenovergestelde in de woordenbank en schrijf het op de lijn."
    },
    "K-351": {
      "title": "Tegenstellingen met plaatjes: verbind de tegenpolen",
      "instruction": "Trek een lijn van elk plaatje naar het plaatje en het woord die het tegenovergestelde laten zien."
    },
    "G1-335": {
      "title": "Tegenstellingen in een zin",
      "instruction": "Lees elke zin. Schrijf het tegenovergestelde van het woord na \"niet\" op de lijn. De woordenbank helpt je."
    },
    "G1-336": {
      "title": "Zoek de paren: welke woorden zijn tegenstellingen?",
      "instruction": "Zoek de twee woorden die tegenstellingen zijn. Schrijf elk paar op een lijn, één woord aan elke kant van de pijl."
    },
    "G1-337": {
      "title": "Tegengesteld of hetzelfde? Omcirkel het tegenovergestelde",
      "instruction": "Lees het woord. Eén van de drie woorden eronder betekent het tegenovergestelde. Omcirkel dat woord, niet het woord dat hetzelfde betekent."
    },
    "G2-320": {
      "title": "Tegenstellingen met on-",
      "instruction": "Zet on- voor elk woord en schrijf het nieuwe tegenovergestelde woord op de lijn."
    }
  }
