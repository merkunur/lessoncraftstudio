  "strings": {
    "K-320": {
      "title": "Numeri ordinali: trova il posto",
      "instruction": "Parti dalla bandierina. Conta fino al numero di ogni gettone e fai il segno che mostra."
    },
    "F1": {
      "title": "Scrivi i numeri ordinali che mancano",
      "instruction": "Alcuni posti sono già scritti. Scrivi i numeri ordinali che mancano nelle caselle vuote, contando dalla bandierina."
    },
    "F2": {
      "title": "Ordinali in parole: collega alla figura",
      "instruction": "Leggi ogni parola ordinale e collega con una linea la figura che sta in quel posto, contando dalla bandierina."
    },
    "F3": {
      "title": "In che posto è? Scrivi il numero ordinale",
      "instruction": "Cerca ogni figura piccola nella sua fila e scrivi in che posto sta, contando dalla bandierina."
    },
    "F4": {
      "title": "Ordinali dai due lati: parti dalla bandierina",
      "instruction": "Cerca prima la bandierina: può stare a un capo o all'altro della fila. Parti da lì, conta fino al numero di ogni gettone e fai il segno."
    },
    "F5": {
      "title": "Chi vince la gara? Scrivi il posto",
      "instruction": "Guarda quanto è vicino al traguardo ogni corridore. Il più vicino è 1º. Scrivi 1º, 2º, 3º, 4º, 5º e 6º."
    }
  }
