  "strings": {
    "K-320": {
      "title": "Järjestysluvut: etsi paikka jonossa",
      "instruction": "Aloita lipun kohdalta. Laske jonossa nappulan lukuun asti ja tee siihen kuvaan nappulan merkki."
    },
    "F1": {
      "title": "Kirjoita puuttuvat järjestysluvut",
      "instruction": "Osa paikoista on jo kirjoitettu. Kirjoita puuttuvat järjestysluvut tyhjiin ruutuihin. Laske lipusta alkaen."
    },
    "F2": {
      "title": "Lue järjestysluku ja yhdistä kuvaan",
      "instruction": "Lue jokainen järjestyslukusana ja piirrä viiva siihen kuvaan, joka on sillä paikalla jonossa. Laske lipusta alkaen."
    },
    "F3": {
      "title": "Monesko? Kirjoita järjestysluku",
      "instruction": "Etsi jokainen pieni kuva omasta jonostaan ja kirjoita, monesko se on. Laske lipusta alkaen."
    },
    "F4": {
      "title": "Aloita lipusta: laske kummastakin päästä",
      "instruction": "Etsi ensin lippu: se voi olla kummassa päässä tahansa. Aloita siitä, laske nappulan lukuun asti ja tee nappulan merkki."
    },
    "F5": {
      "title": "Kuka voittaa kilpailun? Kirjoita sijoitus",
      "instruction": "Katso, kuinka lähellä maaliviivaa jokainen kilpailija on. Lähin on 1. Kirjoita 1., 2., 3., 4., 5. ja 6."
    }
  }
