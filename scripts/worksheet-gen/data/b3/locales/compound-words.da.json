  "strings": {
    "G2-316": {
      "title": "Sammensatte ord: billede + billede",
      "instruction": "Sig navnet på de to billeder, sæt de to ord sammen, og skriv det nye ord på linjen."
    },
    "F1": {
      "title": "Hvad skal ind i midten? Binde-s og binde-e",
      "instruction": "Begge ord står skrevet. Skriv det bogstav, der binder dem sammen, i kassen, eller lad den stå tom. Skriv så hele ordet på linjen."
    },
    "F2": {
      "title": "Del det sammensatte ord: find de to ord",
      "instruction": "Hele ordet står i bogstavkasser ved sit billede. Tegn én streg dér, hvor det andet ord begynder."
    },
    "F3": {
      "title": "Find halvdelene: to billeder, ét ord",
      "instruction": "Tegn en streg fra hvert første billede til det billede, der gør ordet færdigt. Skriv så det nye ord på linjen ved det første billede."
    },
    "F4": {
      "title": "Detektiv for sammensatte ord",
      "instruction": "Tolv ord, og seks af dem er sat sammen af to ord. Sæt ring om de seks sammensatte ord, og skriv deres to dele på linjerne."
    },
    "F5": {
      "title": "Ordnet: ét ord, mange sammensatte ord",
      "instruction": "Ét ord står i midten. Hvert billede rundt om det danner et nyt ord sammen med det. Skriv de fire nye ord på linjerne."
    }
  }
