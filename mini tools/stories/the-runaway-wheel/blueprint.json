        {
          "text": "The wheel had left a long, curvy trail in the soft dust."
        },
        {
          "text": "It wound down the lane, past the grass, and out of sight."
        },
        {
          "characterId": "bo",
          "text": "\"It went that way!\" said Bo."
        },
        {
          "text": "Follow the rolling trail with your finger!"
        }
      ],
