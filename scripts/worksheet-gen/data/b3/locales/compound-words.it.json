  "strings": {
    "G2-316": {
      "title": "Nomi alterati: parola base + suffisso",
      "instruction": "Guarda il disegno e leggi il suffisso. Unisci la parola base al suffisso e scrivi sulla riga il nome alterato."
    },
    "G2-329": {
      "title": "La lettera in mezzo: unisci le due parti",
      "instruction": "Leggi le due parti. Scrivi nella casella la lettera che le unisce, oppure lasciala vuota, poi scrivi la parola intera."
    },
    "G2-330": {
      "title": "Trova la parola base: dividi alterati e derivati",
      "instruction": "Leggi la parola. Traccia una riga dove finisce la parola base e comincia il suffisso."
    },
    "G2-331": {
      "title": "Unisci le due metà della parola",
      "instruction": "Collega ogni disegno di sinistra al disegno di destra che completa la parola, poi scrivila sulla riga."
    },
    "G2-332": {
      "title": "Derivati e alterati: scopri i falsi alterati",
      "instruction": "Cerchia le parole fatte da una parola base più un suffisso e scrivi le due parti. Attenzione: alcune sembrano alterate ma non lo sono!"
    },
    "G2-333": {
      "title": "Grande o piccolo? Scrivi il nome alterato",
      "instruction": "Guarda quanto è grande il disegno. Se è piccolo scrivi il nome con -ino/-ina o -etto/-etta, se è grande con -one."
    }
  }
}
