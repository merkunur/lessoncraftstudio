  "strings": {
    "G2-317": {
      "title": "Conjugar verbos en presente",
      "instruction": "Mira el dibujo y lee el verbo. Escribe en las cajas punteadas la forma que va con cada persona y completa las oraciones."
    },
    "F2": {
      "title": "Une el pronombre con la forma del verbo",
      "instruction": "Lee cada pronombre de la izquierda. Traza una línea hasta la forma del verbo que le corresponde, una línea por pronombre."
    },
    "F3": {
      "title": "Verbos en oraciones con dibujos",
      "instruction": "Mira el dibujo y lee el verbo de la ficha. Escribe en la caja punteada la forma que completa la oración."
    },
    "F4": {
      "title": "Los verbos irregulares: ser, estar, tener e ir",
      "instruction": "Estos verbos cambian mucho. Escribe en las cajas punteadas la forma que va con cada persona."
    },
    "F5": {
      "title": "Elige la forma correcta del verbo",
      "instruction": "Lee la oración. Debajo hay tres formas del mismo verbo. Rodea la que completa la oración."
    },
    "F6": {
      "title": "Encuentra el verbo y escribe su infinitivo",
      "instruction": "Subraya el verbo de cada oración. Luego escribe su infinitivo en la caja punteada."
    }
  }
}
