  "strings": {
    "base": {
      "title": "Les pronoms personnels sujets",
      "instruction": "Regarde la personne et lis le prénom. Entoure le mot que l'on emploie à la place du prénom."
    },
    "replace": {
      "title": "Remplace le prénom par un pronom",
      "instruction": "Lis la phrase. Écris le mot de la liste qui remplace le prénom dans la deuxième phrase.",
      "bankWord": "liste"
    },
    "anaphora": {
      "title": "De qui parle-t-on ? Les pronoms dans les phrases",
      "instruction": "Lis les phrases. Trace un trait de chaque mot encadré jusqu'au prénom qu'il remplace."
    },
    "possessive": {
      "title": "Son, sa ou leur ?",
      "instruction": "Entoure le bon mot. Son ou sa s'accorde avec l'objet, pas avec la personne. Leur s'emploie pour plusieurs personnes."
    },
    "sort": {
      "title": "Classe les prénoms : il, elle, ils ou elles",
      "instruction": "Lis chaque carte prénom. Écris le prénom sous le mot que l'on emploie pour cette personne."
    },
    "rewrite": {
      "title": "Récris la phrase avec un pronom",
      "instruction": "Lis la phrase. Récris-la sur les lignes en employant un pronom à la place du prénom."
    }
  }
