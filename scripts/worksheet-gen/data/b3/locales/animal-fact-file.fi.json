  "strings": {
    "G2-318": {
      "title": "Eläinkortti: {U}",
      "instruction": "Ota selvää eläimestä. Kirjoita eläinkortin jokaiselle riville yksi tieto ja täytä sitten sivun loppu omalla piirroksella tai omilla sanoilla."
    },
    "G2-339": {
      "title": "{U}: rastita oikeat tiedot",
      "instruction": "Lue jokaisen rivin vaihtoehdot ja ympyröi se, joka pitää paikkansa tästä eläimestä. Piirrä sitten, missä se elää, ja täydennä lause."
    },
    "G2-340": {
      "title": "{U}: eläinkortti sanapankin avulla",
      "instruction": "Etsi sanapankista jokainen oikea tieto ja kirjoita se eläinkortin oikealle riville. Täydennä lopuksi lause sivun alalaidassa."
    },
    "G2-341": {
      "title": "{U}: kirjoita kolme lausetta",
      "instruction": "Lue eläinkortti. Täydennä kolme lausetta kortin tiedoilla ja kirjoita sitten viimeiselle riville yksi oma tieto."
    },
    "G2-342": {
      "title": "Vertaile kahta eläintä: samaa vai erilaista?",
      "instruction": "Lue molemmat eläinkortit. Ympyröi jokaisen tiedon kohdalla samaa tai erilaista. Kirjoita sitten kaksi samaa ja kaksi erilaista asiaa."
    },
    "G2-343": {
      "title": "Kuka minä olen? Arvaa eläin",
      "instruction": "Lue kortin viisi vihjettä. Etsi eläin kuvapankista, kirjoita sen nimi viivalle ja piirrä se laatikkoon."
    }
  }
