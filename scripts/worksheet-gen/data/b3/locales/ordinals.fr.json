  "strings": {
    "K-320": {
      "title": "Les nombres ordinaux : 1er, 2e, 3e… trouve le rang",
      "instruction": "Pars du drapeau. Compte jusqu'au nombre de chaque étiquette et fais la marque qu'elle montre."
    },
    "F1": {
      "title": "Écris les nombres ordinaux manquants",
      "instruction": "Certains rangs sont déjà écrits. Écris les nombres ordinaux qui manquent, en comptant depuis le drapeau."
    },
    "F2": {
      "title": "Les mots ordinaux : relie chaque mot à l'image",
      "instruction": "Lis chaque mot ordinal et relie-le à l'image qui occupe ce rang, en comptant depuis le drapeau."
    },
    "F3": {
      "title": "À quel rang ? Écris le nombre ordinal",
      "instruction": "Retrouve chaque petite image de sa ligne et écris le rang qu'elle occupe, en comptant depuis le drapeau."
    },
    "F4": {
      "title": "Nombres ordinaux : le drapeau change de côté",
      "instruction": "Cherche d'abord le drapeau : il peut être à un bout ou à l'autre. Pars de là, compte jusqu'au nombre de l'étiquette et fais la marque."
    },
    "F5": {
      "title": "Qui gagne la course ? Écris le rang",
      "instruction": "Regarde qui est le plus près de l'arrivée : c'est le 1er. Écris 1er, 2e, 3e, 4e, 5e et 6e."
    }
  }
