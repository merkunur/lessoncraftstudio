  "strings": {
    "K-320": {
      "title": "Ordnungszahlen: Finde den Platz",
      "instruction": "Beginne bei der Fahne. Zähle bis zur Zahl auf dem Plättchen und mache das Zeichen, das darauf steht."
    },
    "F1": {
      "title": "Fehlende Ordnungszahlen eintragen",
      "instruction": "Einige Plätze stehen schon da. Schreibe die fehlenden Ordnungszahlen in die leeren Kästchen. Zähle von der Fahne aus."
    },
    "F2": {
      "title": "Ordnungszahl-Wörter mit dem Bild verbinden",
      "instruction": "Lies jedes Zahlwort und verbinde es mit dem Bild, das an diesem Platz steht. Zähle von der Fahne aus."
    },
    "F3": {
      "title": "An welcher Stelle? Schreibe die Ordnungszahl",
      "instruction": "Suche jedes kleine Bild in seiner Reihe und schreibe auf, an welcher Stelle es steht. Zähle von der Fahne aus."
    },
    "F4": {
      "title": "Ordnungszahlen von links und von rechts",
      "instruction": "Suche zuerst die Fahne: Sie kann links oder rechts stehen. Beginne dort, zähle bis zur Zahl auf dem Plättchen und mache das Zeichen."
    },
    "F5": {
      "title": "Wer gewinnt das Rennen? Schreibe den Platz",
      "instruction": "Schau, wie nah jeder Läufer am Ziel ist. Wer dem Ziel am nächsten ist, wird 1. Schreibe die Plätze 1. bis 6. auf."
    }
  }
}
