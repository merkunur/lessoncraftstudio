  "strings": {
    "G2-315": {
      "title": "Spellingregel van de week: {UNIT}",
      "instruction": "Lees de regel in het kader. Zeg het woord bij elk plaatje en schrijf de ontbrekende letters van de regel in de stippelvakjes."
    },
    "G2-324": {
      "title": "Welke is het? {UNIT}",
      "instruction": "Kijk naar het plaatje en lees het woord. Omcirkel de goede letters eronder en schrijf ze daarna in het stippelvakje."
    },
    "G2-325": {
      "title": "Spellingdetective: {UNIT}",
      "instruction": "Lees elk woord. Zoek de letters van de regel, omcirkel ze in het woord en schrijf ze dan over in het kleine vakje."
    },
    "G2-326": {
      "title": "Sorteer op spellingregel: {UNIT}",
      "instruction": "Zeg het woord bij elk plaatje. Schrijf het in de bak van zijn spelling, één woord per lijn."
    },
    "G2-327": {
      "title": "Schrijf het hele woord: {UNIT}",
      "instruction": "De letters van de regel staan al in het oranje. Zeg het woord bij het plaatje en schrijf alle andere letters in de hokjes."
    }
  }
