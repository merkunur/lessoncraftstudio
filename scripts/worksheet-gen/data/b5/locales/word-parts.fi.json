      "title": "Kantasana: lajittele sanat vartalon mukaan",
      "instruction": "Lue jokainen ylhäällä oleva sana ja kirjoita se sen muurin riville, jonka kivessä on sanan kantasana."
    },
    "picture-family": {
      "title": "Kantasana kuvasta: rengasta oikea sana",
      "instruction": "Sano, mitä kuva esittää, ja rengasta sen yläpuolelta se ainoa sana, joka on tehty kuvan sanasta."
    },
    "root-word": {
      "title": "Etsi kantasana",
      "instruction": "Rengasta osa, joka on kaikissa kolmessa sanassa, ja kirjoita kantasana tyhjään kiveen."
    },
    "who-does-it": {
      "title": "Kuka tekee? Tekijää tarkoittava sana",
      "instruction": "Katso jokaista työssä olevaa ihmistä, lue sana hänen vieressään ja kirjoita tekijän nimi tyhjään tiileen."
    },
    "family-in-sentence": {
      "title": "Johdokset lauseissa",
      "instruction": "Kirjoita jokainen kiven neljästä sanasta siihen lauseeseen, johon se sopii."
    }
