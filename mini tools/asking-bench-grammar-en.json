  "_recipeDoc": [
    "A recipe is a LIST OF OPS over a closed vocabulary. The four claim",
    "descriptors are DERIVED from these ops and never authored twice:",
    "  front   -> 'a word jumps to the front'",
    "  insert  -> 'a new word comes in'",
    "  reshape -> 'a word changes its shape'",
    "  suffix  -> 'a word changes its shape' (fi -ko, sv/da/no none)",
    "  wrap    -> the end mark; NEVER a claim (every asking gets one, so",
    "             it would light on every case and say nothing)",
    "  (no front/insert/reshape/suffix at all) -> 'nothing moves'",
    "",
    "`capFront` names the token whose capitalisation moves to the front of",
    "the asking; the base form is authored on the token itself, so this is",
    "a SELECTION, never a string operation."
  ],
  "recipes": {
    "S-V|lexPres|plain": {
      "ops": [
        {
          "op": "insert",
          "slot": "helper",
          "at": 0
        },
        {
          "op": "reshape",
          "slot": "verb",
          "to": "base"
        }
      ],
      "wrap": "?",
      "capFront": "helper",
      "decap": "subject"
    },
    "S-V|lexPast|plain": {
      "ops": [
        {
          "op": "insert",
          "slot": "helper",
          "at": 0
        },
        {
          "op": "reshape",
          "slot": "verb",
          "to": "base"
        }
      ],
      "wrap": "?",
      "capFront": "helper",
      "decap": "subject"
    },
    "S-be-ADJ|beSg|plain": {
      "ops": [
        {
          "op": "front",
          "slot": "verb",
          "to": "front"
        }
      ],
      "wrap": "?",
      "capFront": "verb",
      "decap": "subject"
    },
    "S-V-OBJ|lexPres|plain": {
      "ops": [
        {
          "op": "insert",
          "slot": "helper",
          "at": 0
        },
        {
          "op": "reshape",
          "slot": "verb",
          "to": "base"
        }
      ],
      "wrap": "?",
      "capFront": "helper",
      "decap": "subject"
    },
    "S-V-OBJ|lexPast|plain": {
      "ops": [
        {
          "op": "insert",
          "slot": "helper",
          "at": 0
        },
        {
          "op": "reshape",
          "slot": "verb",
          "to": "base"
        }
      ],
      "wrap": "?",
      "capFront": "helper",
      "decap": "subject"
    },
    "S-modal-V|modal|plain": {
      "ops": [
        {
          "op": "front",
          "slot": "verb",
          "to": "front"
        }
      ],
      "wrap": "?",
      "capFront": "verb",
      "decap": "subject"
    }
  },
