  "strings": {
    "K-320": {
      "title": "Números ordinais: encontre o lugar",
      "instruction": "Comece na bandeira. Conte até o número de cada cartão e faça a marca que ele mostra."
    },
    "F1": {
      "title": "Escreva os números ordinais que faltam",
      "instruction": "Alguns lugares já estão escritos. Escreva os ordinais que faltam nos quadradinhos vazios, contando a partir da bandeira."
    },
    "F2": {
      "title": "Ordinais por extenso: ligue à figura",
      "instruction": "Leia cada ordinal por extenso e ligue à figura que está nesse lugar, contando a partir da bandeira."
    },
    "F3": {
      "title": "Em que lugar está? Escreva o número ordinal",
      "instruction": "Encontre cada figura pequena na sua fileira e escreva em que lugar ela está, contando a partir da bandeira."
    },
    "F4": {
      "title": "Ordinais dos dois lados: comece na bandeira",
      "instruction": "Procure primeiro a bandeira: ela pode estar em qualquer ponta. Comece por ela, conte até o número de cada cartão e faça a marca."
    },
    "F5": {
      "title": "Quem ganha a corrida? Escreva a colocação",
      "instruction": "Veja quem está mais perto da linha de chegada. O mais perto é o 1º. Escreva 1º, 2º, 3º, 4º, 5º e 6º."
    }
  }
