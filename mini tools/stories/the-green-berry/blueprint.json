      "narration": [
        {
          "text": "The Meadow Fair was coming, and Bramble the bear was making jam."
        },
        {
          "text": "Three jars with bright lids waited on his table: red, blue, and yellow."
        },
        {
          "characterId": "bramble",
          "text": "\"One jar for every color,\" said Bramble proudly."
        },
        {
          "text": "Then his big foot caught a root. BUMP! The fruit basket tumbled everywhere!"
        },
        {
          "characterId": "pip",
          "text": "\"Oh my,\" said Pip. \"Colors will help us. Every fruit has a color home.\""
        }
      ],
      "success": {
        "celebration": "none",
        "holdMs": 600
