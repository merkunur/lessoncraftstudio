  "strings": {
    "K-323": {
      "title": "Dit ben ik",
      "instruction": "Schrijf je naam en je leeftijd, teken jezelf en je gezin en teken daarna je drie lievelingsdingen."
    },
    "K-342": {
      "title": "Mijn lievelingsdingen: omcirkel en schrijf",
      "instruction": "Omcirkel in elke rij je lievelingsplaatje en schrijf het woord over op de lijn."
    },
    "K-343": {
      "title": "Mijn gezin: teken en tel",
      "instruction": "Teken je gezin. Laat dan in de tienvelden zien hoeveel mensen, broers, zussen en huisdieren er zijn en schrijf het getal."
    },
    "K-344": {
      "title": "Dit is mijn gezicht: schrijf de woorden erbij",
      "instruction": "Schrijf elk woord uit de woordenbank over op de lijn die naar dat deel van het gezicht wijst. Teken daarna je eigen gezicht."
    },
    "K-345": {
      "title": "Ik kan: zet een vinkje bij wat je al kunt",
      "instruction": "Lees elke zin en zet een vinkje bij de dingen die je al kunt. Schrijf daarna één ding dat je nog wilt leren."
    },
    "K-346": {
      "title": "Mijn naam: schrijf, tel en vergelijk",
      "instruction": "Schrijf je naam met één letter per hokje en tel de letters. Doe hetzelfde voor een vriend of vriendin en omcirkel wie er meer letters heeft."
    }
