  "strings": {
    "G2-316": {
      "title": "Yhdyssanat: kuva + kuva = sana",
      "instruction": "Sano molempien kuvien sanat. Yhdistä ne yhdeksi sanaksi ja kirjoita uusi sana viivalle."
    },
    "G2-329": {
      "title": "Mitä tulee väliin?",
      "instruction": "Molemmat osat on kirjoitettu. Kirjoita laatikkoon osien väliin tuleva kirjain tai jätä se tyhjäksi ja kirjoita koko sana viivalle."
    },
    "G2-330": {
      "title": "Jaa yhdyssana osiin",
      "instruction": "Koko sana on kirjoitettu kuvan viereen kirjainruutuihin. Piirrä yksi viiva siihen kohtaan, josta toinen sana alkaa."
    },
    "G2-331": {
      "title": "Yhdistä sanan osat: kaksi kuvaa, yksi sana",
      "instruction": "Piirrä viiva kuvasta siihen kuvaan, joka täydentää sanan. Kirjoita sitten uusi sana ensimmäisen kuvan viereen."
    },
    "G2-332": {
      "title": "Yhdyssanaetsivä: yhdyssana vai ei?",
      "instruction": "Kaksitoista sanaa, joista kuusi on yhdyssanoja. Ympyröi yhdyssanat ja kirjoita niiden kaksi osaa viivoille."
    },
    "G2-333": {
      "title": "Sanatähti: yksi sana, monta yhdyssanaa",
      "instruction": "Keskellä on yksi sana. Jokainen kuva sen ympärillä tekee sen kanssa uuden sanan. Kirjoita neljä uutta sanaa viivoille."
    }
  }
