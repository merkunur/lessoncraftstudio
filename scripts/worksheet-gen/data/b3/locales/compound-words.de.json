  "strings": {
    "G2-316": {
      "title": "Zusammengesetzte Nomen: Bild + Bild",
      "instruction": "Benenne die zwei Bilder, setze die zwei Wörter zusammen und schreibe das neue Wort auf die Linie."
    },
    "G2-329": {
      "title": "Fugen-n oder nicht? Zusammengesetzte Nomen",
      "instruction": "Beide Wörter stehen schon da. Schreibe den Buchstaben, der sie verbindet, in das Kästchen, oder lass es leer. Schreibe dann das ganze Wort."
    },
    "G2-330": {
      "title": "Zusammengesetzte Nomen trennen",
      "instruction": "Das ganze Wort steht in Buchstabenkästchen neben seinem Bild. Male einen Strich dort, wo das zweite Wort beginnt."
    },
    "G2-331": {
      "title": "Wortteile verbinden: Zwei Bilder, ein Wort",
      "instruction": "Verbinde jedes erste Bild mit dem Bild, das das Wort vollendet. Schreibe dann das neue Wort auf die Linie neben dem ersten Bild."
    },
    "G2-332": {
      "title": "Wort-Detektiv: zusammengesetzt oder nicht?",
      "instruction": "Zwölf Wörter, sechs davon bestehen aus zwei Wörtern. Kreise die sechs zusammengesetzten Nomen ein und schreibe ihre zwei Teile auf die Linien."
    },
    "G2-333": {
      "title": "Wortstern: Ein Wort, viele Wörter",
      "instruction": "Ein Wort steht in der Mitte. Jedes Bild darum herum bildet mit ihm ein neues Wort. Schreibe die vier neuen Wörter auf die Linien."
    }
  }
}
