  "strings": {
    "K-320": {
      "title": "Rangtelwoorden: op welke plaats?",
      "instruction": "Begin bij de vlag. Tel tot het getal op elk fiche en zet het teken dat erop staat."
    },
    "F1": {
      "title": "Vul de ontbrekende rangtelwoorden in",
      "instruction": "Sommige plaatsen zijn al ingevuld. Schrijf de ontbrekende rangtelwoorden in de lege vakjes. Tel vanaf de vlag."
    },
    "F2": {
      "title": "Rangtelwoorden lezen: trek een lijn naar het plaatje",
      "instruction": "Lees elk rangtelwoord en trek een lijn naar het plaatje dat op die plaats staat. Tel vanaf de vlag."
    },
    "F3": {
      "title": "Welke plaats? Schrijf het rangtelwoord",
      "instruction": "Zoek elk klein plaatje in zijn rij en schrijf op welke plaats het staat. Tel vanaf de vlag."
    },
    "F4": {
      "title": "Rangtelwoorden vanaf de andere kant: begin bij de vlag",
      "instruction": "Zoek eerst de vlag: die kan aan beide kanten staan. Begin daar, tel tot het getal op het fiche en zet het teken dat erop staat."
    },
    "F5": {
      "title": "Wie wint de race? Schrijf de plaats",
      "instruction": "Kijk hoe dicht elke renner bij de finish is. De dichtstbijzijnde is 1e. Schrijf 1e, 2e, 3e, 4e, 5e en 6e."
    }
  }
