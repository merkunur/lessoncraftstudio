  "strings": {
    "G2-377": {
      "title": "Corsivo classe prima: le vocali a, e, i, o, u",
      "instruction": "Ripassa le lettere grigie, poi scrivi tu ogni lettera legata fino alla fine della riga e sulla riga vuota qui sotto."
    },
    "G2-384": {
      "title": "Corsivo maiuscolo classe seconda: scrivi i nomi",
      "instruction": "Ripassa ogni lettera maiuscola grigia e il nome, poi scrivili sulla riga vuota qui sotto."
    },
    "G2-385": {
      "title": "Corsivo classe prima: legare le lettere a due a due",
      "instruction": "Ripassa ogni coppia di lettere grigie legate e la parola, poi scrivile sulla riga vuota qui sotto."
    },
    "G2-386": {
      "title": "Parole in corsivo da scrivere con le figure",
      "instruction": "Ripassa ogni parola grigia legando prima le lettere e mettendo alla fine puntini e taglietti, poi scrivila allo stesso modo sulla riga qui sotto."
    },
    "G2-387": {
      "title": "Leggere il corsivo: collega la parola alla figura",
      "instruction": "Leggi ogni parola in corsivo e collegala con una linea alla sua figura."
    },
    "G3-401": {
      "title": "Frasi in corsivo da ricopiare",
      "instruction": "Prima ripassa la frase grigia, poi ricopia in corsivo ogni frase in stampato sulle due righe qui sotto."
    }
  }
