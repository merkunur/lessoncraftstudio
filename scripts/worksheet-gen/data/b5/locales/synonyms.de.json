  "strings": {
    "base": {
      "title": "Synonyme: Wörter mit gleicher Bedeutung finden",
      "instruction": "Lies das große Wort auf jeder Karte und kreise darunter das Wort ein, das dasselbe bedeutet."
    },
    "pictures": {
      "title": "Synonyme mit Bildern: zwei Wörter, ein Bild",
      "instruction": "Schau dir jedes Bild an und kreise darunter die zwei Wörter ein, die dasselbe bedeuten und zum Bild passen."
    },
    "pairs": {
      "title": "Synonyme zuordnen: Wortpaare verbinden",
      "instruction": "Jedes Wort hängt an einer Socke: Verbinde jede Socke links mit einer Linie mit der Socke rechts, deren Wort dasselbe bedeutet."
    },
    "shades": {
      "title": "Wörter nach Stärke ordnen: von ein bisschen bis sehr",
      "instruction": "Lies die drei Wörter in jeder Reihe und schreibe 1, 2 und 3 in die Kästchen, vom schwächsten bis zum stärksten Wort."
    },
    "say": {
      "title": "Wortfeld „sagen“: das passende Verb einsetzen",
      "instruction": "Lies jeden Satz und schreibe statt „sagt“ das Wort aus der Sprechblase in das Kästchen, das am besten passt."
    },
    "fields": {
      "title": "Wortfelder „gehen“ und „sehen“: Verben sortieren",
      "instruction": "Lies die zehn Wörter und schreibe jedes in das Wortfeld des Verbs, zu dem es gehört."
    }
  }
}
