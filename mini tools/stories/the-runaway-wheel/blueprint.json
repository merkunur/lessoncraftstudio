            "x": 1410,
            "y": 915
          },
          "scale": 0.56,
          "flip": true
        }
      ],
      "narration": [
        {
          "text": "One sunny morning, Bo the beaver pulled his little cart up the lane."
        },
        {
          "text": "Bump! The cart hopped over a stone, and the round wheel popped right off."
        },
        {
          "text": "It bounced twice, then rolled away down the hill, spinning as it went."
        },
        {
          "characterId": "bo",
          "text": "\"My wheel!\" cried Bo. \"Come back, little wheel!\""
        },
        {
          "characterId": "pip",
          "text": "\"Come on, Bo,\" said Pip. \"Let's follow it together!\""
        }
      ],
      "success": {
        "celebration": "none",
        "holdMs": 600
      }
    },
