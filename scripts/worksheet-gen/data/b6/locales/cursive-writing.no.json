  "strings": {
    "G2-377": {
      "title": "Sammenhengende skrift: små bokstaver i, u og t",
      "instruction": "Skriv over de grå bokstavene, og skriv videre selv med bokstavene bundet sammen til enden av linjen og på den tomme linjen under."
    },
    "G2-384": {
      "title": "Store bokstaver i sammenhengende skrift: skriv navnene",
      "instruction": "Skriv over hver grå stor bokstav og hvert navn, og skriv dem så på den tomme linjen under."
    },
    "G2-385": {
      "title": "Sammenhengende skrift: bind bokstavene sammen",
      "instruction": "Skriv over hvert grå bokstavpar og ordet, og skriv dem så på den tomme linjen under."
    },
    "G2-386": {
      "title": "Skriv ord med sammenhengende skrift",
      "instruction": "Skriv over hvert grå ord, skriv det så på linjen under, og sett på prikker og tverrstreker til slutt."
    },
    "G2-387": {
      "title": "Les sammenhengende skrift: ord og bilde",
      "instruction": "Les hvert ord i sammenhengende skrift, og trekk en strek til bildet som passer."
    },
    "G3-401": {
      "title": "Skriv av setninger med sammenhengende skrift",
      "instruction": "Skriv over den grå setningen, og skriv så av hver trykt setning med sammenhengende skrift på de to linjene under."
    }
  }
