{
  "schemaVersion": "sb-1",
  "id": "pk-trial",
  "title": "@story.title",
  "locales": ["en"],
  "alignment": { "grade": "PK" },
  "theme": { "letterboxColor": "#FBF3E4", "transition": "crossfade" },

  "cast": [
    {
      "id": "pip",
      "name": "@cast.pip.name",
      "role": "guide",
      "atlasBase": "atlas.pip.base",
      "poses": ["neutral", "talk", "happy", "point"]
    }
  ],

  "assets": {
    "atlas.pip.base": { "kind": "atlas", "src": "/mini-tools/stories/pips-picnic/cast/pip/pip.base.json" },
    "scene.meadow": { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-01.webp", "size": { "w": 1600, "h": 1000 } },
    "scene.blanket": { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-02.webp", "size": { "w": 1600, "h": 1000 } },
    "scene.stream": { "kind": "image", "src": "/mini-tools/stories/pips-picnic/scenes/page-03.webp", "size": { "w": 1600, "h": 1000 } },
    "img.cat": { "kind": "image", "src": "/image-library-webp/themes/animals/cat@2x.webp", "vocab": "cat" },
    "img.dog": { "kind": "image", "src": "/image-library-webp/themes/animals/dog@2x.webp", "vocab": "dog" },
    "img.rabbit": { "kind": "image", "src": "/image-library-webp/themes/animals/rabbit@2x.webp", "vocab": "rabbit" },
    "img.table": { "kind": "image", "src": "/image-library-webp/themes/furniture/table@2x.webp", "vocab": "table" }
  },

  "reward": {
    "id": "story.pk-trial",
    "label": { "en": "Explorer star" },
    "emoji": "⭐"
  },

  "pages": [
    {
      "id": "tr01",
      "scene": { "image": "scene.meadow" },
      "characters": [{ "characterId": "pip", "pose": "point", "anchor": { "x": 200, "y": 895 }, "scale": 0.8, "flip": false }],
      "narration": { "gate": "end", "cues": [{ "id": "tr01-l01", "characterId": "pip" }] },
      "interaction": {
        "moduleType": "sb-dot-stamp",
        "zone": { "x": 400, "y": 160, "w": 800, "h": 680 },
        "completionMode": "auto",
        "hintKey": "tr01-hint",
        "taskData": {
          "dots": [{ "x": 200, "y": 250 }, { "x": 600, "y": 250 }, { "x": 400, "y": 530 }],
          "stampColor": "#F2784B"
        }
      },
      "success": { "celebration": "burst", "holdMs": 1200 }
    },
    {
      "id": "tr02",
      "scene": { "image": "scene.blanket" },
      "characters": [{ "characterId": "pip", "pose": "talk", "anchor": { "x": 200, "y": 895 }, "scale": 0.8, "flip": false }],
      "narration": { "gate": "end", "cues": [{ "id": "tr02-l01", "characterId": "pip" }] },
      "interaction": {
        "moduleType": "sb-shape-fit",
        "zone": { "x": 380, "y": 150, "w": 840, "h": 700 },
        "completionMode": "auto",
        "hintKey": "tr02-hint",
        "taskData": {
          "slots": [
            { "shape": "circle", "color": "#F2784B", "at": { "x": 300, "y": 280 } },
            { "shape": "square", "color": "#146B5E", "at": { "x": 700, "y": 420 } }
          ]
        }
      },
      "success": { "celebration": "burst", "holdMs": 1200 }
    },
    {
      "id": "tr03",
      "scene": { "image": "scene.stream" },
      "characters": [{ "characterId": "pip", "pose": "happy", "anchor": { "x": 200, "y": 895 }, "scale": 0.8, "flip": false }],
      "narration": { "gate": "end", "cues": [{ "id": "tr03-l01", "characterId": "pip" }] },
      "interaction": {
        "moduleType": "sb-listen-place",
        "zone": { "x": 380, "y": 140, "w": 840, "h": 720 },
        "completionMode": "auto",
        "hintKey": "tr03-hint",
        "taskData": {
          "object": { "image": "img.cat", "alt": "@tr03.obj.cat" },
          "reference": { "image": "img.table", "at": { "x": 500, "y": 340 } },
          "slots": [
            { "key": "under", "at": { "x": 500, "y": 560 }, "correct": true },
            { "key": "beside", "at": { "x": 300, "y": 340 } }
          ]
        }
      },
      "success": { "celebration": "burst", "holdMs": 1400 }
    }
  ]
}
