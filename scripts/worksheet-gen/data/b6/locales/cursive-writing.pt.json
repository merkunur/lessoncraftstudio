  "strings": {
    "G2-377": {
      "title": "Letra cursiva para o 1º ano: as letras a, e, i, o",
      "instruction": "Cubra as letras cinza e continue escrevendo cada letra ligada, sozinho, até o fim da linha e na linha vazia de baixo."
    },
    "G2-384": {
      "title": "Alfabeto cursivo maiúsculo: escreva os nomes",
      "instruction": "Cubra cada letra maiúscula e cada nome em cinza e depois escreva tudo na linha vazia de baixo."
    },
    "G2-385": {
      "title": "Letra cursiva: ligando as letras de duas em duas",
      "instruction": "Cubra cada par de letras ligadas e a palavra em cinza e depois escreva na linha vazia de baixo."
    },
    "G2-386": {
      "title": "Palavras em letra cursiva para o 1º ano",
      "instruction": "Cubra cada palavra cinza num traço contínuo, depois escreva na linha de baixo e coloque os pingos, os cortes e os acentos por último."
    },
    "G2-387": {
      "title": "Leitura em letra cursiva: ligue a palavra à figura",
      "instruction": "Leia cada palavra em letra cursiva e ligue-a à sua figura com um traço."
    },
    "G3-401": {
      "title": "Da letra de forma para a cursiva: copie as frases",
      "instruction": "Cubra a frase cinza e depois copie cada frase impressa em letra cursiva nas duas linhas de baixo."
    }
  }
