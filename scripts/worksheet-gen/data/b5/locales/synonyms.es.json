  "strings": {
    "base": {
      "title": "Sinónimos: rodea la palabra que significa lo mismo",
      "instruction": "Lee la palabra grande de cada tarjeta y rodea la palabra de abajo que significa lo mismo."
    },
    "pictures": {
      "title": "Sinónimos con imágenes: dos palabras para un dibujo",
      "instruction": "Mira cada dibujo y rodea las dos palabras de abajo que significan lo mismo y describen el dibujo."
    },
    "pairs": {
      "title": "Sinónimos: une las parejas de palabras",
      "instruction": "Une con una línea cada palabra de la izquierda con la palabra de la derecha que significa lo mismo."
    },
    "shades": {
      "title": "Intensidad de las palabras: de poco a mucho",
      "instruction": "Lee las tres palabras de cada fila y escribe 1, 2 y 3 en los cuadros, de la más suave a la más fuerte."
    },
    "say": {
      "title": "Sinónimos de dice: elige la palabra que va mejor",
      "instruction": "Lee cada oración y escribe en el cuadro la palabra de la burbuja que va mejor en lugar de dice."
    },
    "fields": {
      "title": "Campos semánticos: palabras para ir y para mirar",
      "instruction": "Lee las diez palabras y escribe cada una en el campo de la palabra a la que más se parece en significado."
    }
  }
