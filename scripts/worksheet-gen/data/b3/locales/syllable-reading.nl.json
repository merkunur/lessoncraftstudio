  "strings": {
    "G1-306": {
      "title": "Mkm-woorden lezen en schrijven",
      "instruction": "Lees alle woorden op de leesmat hardop. Zeg het woord bij elk plaatje, zoek het op de leesmat en schrijf het op de lijn."
    },
    "G1-330": {
      "title": "Mkm-woorden: lees en omcirkel",
      "instruction": "Lees de woorden op de leesmat hardop. Zeg het woord bij elk plaatje en omcirkel het ene woord eronder dat erbij hoort."
    },
    "G1-331": {
      "title": "Plak de lettergrepen en schrijf het woord",
      "instruction": "Lees de twee lettergrepen op elk kaartje op volgorde. Zeg ze achter elkaar en schrijf het hele woord op de lijn."
    },
    "G1-332": {
      "title": "Leesmat met mkm-woorden: lees en kleur",
      "instruction": "Lees alle woorden op de leesmat hardop. Zoek dan het woord van elk plaatje op de leesmat en kleur dat woord in de kleur van het plaatje."
    },
    "G1-333": {
      "title": "Woorden met twee medeklinkers: mmkm en mkmm",
      "instruction": "Lees alle woorden op de leesmat hardop. Zeg het woord bij elk plaatje, zoek het op de leesmat en schrijf het op de lijn."
    },
    "G1-334": {
      "title": "Lees de lettergrepen en zoek het plaatje",
      "instruction": "Lees elk woord lettergreep voor lettergreep. Zoek het plaatje in de bank bovenaan en schrijf het nummer van het plaatje in het vakje."
    }
  }
