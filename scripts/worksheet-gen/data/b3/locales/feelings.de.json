  "strings": {
    "K-319": {
      "title": "Gefühle erkennen: Gesicht und Wort verbinden",
      "instruction": "Verbinde jedes Gesicht mit dem Gefühlswort, das sagt, wie es sich fühlt."
    },
    "K-331": {
      "title": "Wie fühlst du dich? Kreise das Gesicht ein",
      "instruction": "Schau das Bild an, überlege, wie du dich fühlen würdest, und kreise das passende Gesicht ein."
    },
    "K-332": {
      "title": "Zeichne das Gefühlsgesicht",
      "instruction": "Lies das Gefühlswort und zeichne in den leeren Kreis ein Gesicht, das dieses Gefühl zeigt."
    },
    "K-333": {
      "title": "Angenehm oder unangenehm? Gesichter sortieren",
      "instruction": "Verbinde jedes Gesicht mit dem Kasten, der sagt, ob sich das Gefühl angenehm oder unangenehm anfühlt."
    },
    "K-334": {
      "title": "Welches Gesicht zeigt das Gefühl?",
      "instruction": "Lies das Gefühlswort und kreise in der Reihe das eine Gesicht ein, das es zeigt."
    },
    "K-335": {
      "title": "Wie fühle ich mich heute?",
      "instruction": "Kreise das Gesicht ein, das zeigt, wie du dich heute fühlst. Zeichne dann dein eigenes Gesicht."
    }
  }
