  "strings": {
    "K-319": {
      "title": "Følelser: Koble ansiktet til ordet",
      "instruction": "Tegn en strek fra hvert ansikt til følelsesordet som sier hvordan det har det."
    },
    "K-331": {
      "title": "Hvordan føler du deg? Sett ring rundt ansiktet",
      "instruction": "Se på bildet, tenk på hvordan du ville følt deg, og sett ring rundt ansiktet som passer."
    },
    "K-332": {
      "title": "Tegn følelsen som et ansikt",
      "instruction": "Les følelsesordet og tegn et ansikt som viser det i den tomme sirkelen."
    },
    "K-333": {
      "title": "Kjennes det godt eller vondt? Sorter ansiktene",
      "instruction": "Tegn en strek fra hvert ansikt til boksen som sier om følelsen kjennes godt eller vondt."
    },
    "K-334": {
      "title": "Hvilket ansikt viser følelsen?",
      "instruction": "Les følelsesordet og sett ring rundt det ene ansiktet i raden som viser det."
    },
    "K-335": {
      "title": "Hvordan føler jeg meg i dag?",
      "instruction": "Sett ring rundt ansiktet som viser hvordan du føler deg i dag. Tegn så ditt eget ansikt."
    }
  }
