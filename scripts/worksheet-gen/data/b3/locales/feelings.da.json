  "strings": {
    "K-319": {
      "title": "Følelser: forbind ansigt og ord",
      "instruction": "Tegn en streg fra hvert ansigt til det ord, der fortæller, hvordan det har det."
    },
    "K-331": {
      "title": "Hvordan har du det? Sæt ring om ansigtet",
      "instruction": "Se på billedet, og tænk over, hvordan du ville have det. Sæt en ring om det ansigt, der passer."
    },
    "K-332": {
      "title": "Tegn følelsen som et ansigt",
      "instruction": "Læs ordet, og tegn et ansigt, der viser følelsen, i den tomme cirkel."
    },
    "K-333": {
      "title": "Rar eller ikke rar? Sortér følelserne",
      "instruction": "Tegn en streg fra hvert ansigt til den kasse, der fortæller, om følelsen er rar eller ikke rar."
    },
    "K-334": {
      "title": "Hvilket ansigt viser følelsen?",
      "instruction": "Læs ordet, og sæt en ring om det ene ansigt i rækken, der viser følelsen."
    },
    "K-335": {
      "title": "Sådan har jeg det i dag",
      "instruction": "Sæt en ring om det ansigt, der viser, hvordan du har det i dag. Tegn så dit eget ansigt."
    }
  }
