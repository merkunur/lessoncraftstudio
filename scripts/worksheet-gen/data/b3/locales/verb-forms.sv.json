  "strings": {
    "G2-317": {
      "title": "Verb i presens och preteritum: nu och i går",
      "instruction": "Titta på bilden och läs verbet. Skriv hur det heter nu och hur det hette i går i de streckade rutorna. Gör sedan meningarna färdiga."
    },
    "F2": {
      "title": "Para ihop verbet med preteritum",
      "instruction": "Läs varje verb till vänster. Dra ett streck till dess dåtidsform, den som säger vad som hände i går, ett streck för varje verb."
    },
    "F3": {
      "title": "Verbformer i meningar med bilder",
      "instruction": "Titta på bilden och läs verbet i bubblan. Skriv den form som passar i meningen i den streckade rutan."
    },
    "F4": {
      "title": "Starka verb: vara, ha, gå, få",
      "instruction": "De här verben ändrar sig mycket. Skriv formen för nu och formen för i går i de streckade rutorna."
    },
    "F5": {
      "title": "Välj rätt verbform",
      "instruction": "Läs meningen. Tre former av verbet står under den. Ringa in den som passar."
    },
    "F6": {
      "title": "Hitta verbet och skriv grundformen",
      "instruction": "Stryk under verbet i varje mening. Skriv sedan verbets grundform, som efter \"att\", i den streckade rutan."
    }
  }
}
