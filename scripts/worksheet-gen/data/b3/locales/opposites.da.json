    "G1-307": {
      "title": "Modsætninger: skriv det modsatte ord",
      "instruction": "Læs ordet på hvert kort. Find det modsatte ord i ordbanken, og skriv det på linjen."
    },
    "K-351": {
      "title": "Modsætninger med billeder: find par",
      "instruction": "Tegn en streg fra hvert billede til det billede og ord, der viser det modsatte."
    },
    "G1-335": {
      "title": "Modsætninger i en sætning",
      "instruction": "Læs hver sætning. Skriv det modsatte af ordet efter \"ikke\" på linjen. Ordbanken hjælper dig."
    },
    "G1-336": {
      "title": "Find modsætningsparrene",
      "instruction": "Find de to ord, der er modsætninger. Skriv hvert par på en linje, ét ord på hver side af pilen."
    },
    "G1-337": {
      "title": "Modsat eller det samme? Sæt ring om det modsatte",
      "instruction": "Læs ordet. Ét af de tre ord under det betyder det modsatte. Sæt ring om det, ikke om det, der betyder det samme."
    },
    "G2-320": {
      "title": "Modsætninger med forstavelsen u-",
      "instruction": "Sæt forstavelsen foran hvert ord, og skriv det nye, modsatte ord på linjen."
    }
