  "strings": {
    "K-319": {
      "title": "Tunteet: yhdistä ilme ja sana",
      "instruction": "Piirrä viiva jokaisesta ilmeestä siihen tunnesanaan, joka sopii ilmeeseen."
    },
    "K-331": {
      "title": "Miltä sinusta tuntuisi? Ympyröi ilme",
      "instruction": "Katso kuvaa ja mieti, miltä sinusta tuntuisi. Ympyröi ilme, joka sopii siihen."
    },
    "K-332": {
      "title": "Piirrä tunneilme",
      "instruction": "Lue tunnesana ja piirrä tyhjään ympyrään kasvot, jotka näyttävät sen tunteen."
    },
    "K-333": {
      "title": "Mukava vai ikävä tunne? Lajittele ilmeet",
      "instruction": "Piirrä viiva jokaisesta ilmeestä siihen laatikkoon, joka kertoo, onko tunne mukava vai ikävä."
    },
    "K-334": {
      "title": "Mikä ilme näyttää tunteen?",
      "instruction": "Lue tunnesana ja ympyröi rivistä se yksi ilme, joka näyttää tunteen."
    },
    "K-335": {
      "title": "Miltä minusta tuntuu tänään?",
      "instruction": "Ympyröi ilme, joka näyttää, miltä sinusta tuntuu tänään. Piirrä sitten omat kasvosi."
    }
  }
