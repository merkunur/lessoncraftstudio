#!/usr/bin/env node
/* =====================================================================
   mutate-__KEY__.js — does verify-__KEY__-core.js BITE?
   Every mutation must be KILLED; a missed needle is a harness fault, never
   a skip. CRLF collapsed. 30 s cap — a gate loop never depends on the tool.
   ⚠ SCAFFOLD: these needles hit the skeleton core. When the invention
   replaces it, write one mutation per rule the design sheet states (every
   number, every hint step, every layout floor), and keep them single-line.
   ===================================================================== */
'use strict';
const fs = require('fs'), path = require('path'), os = require('os');
const { spawnSync } = require('child_process');
const ROOT = path.join(__dirname, '..');
const SRC = fs.readFileSync(path.join(ROOT, 'mini tools', '__KEY__-core.js'), 'utf8').replace(/\r\n/g, '\n');
const GATE = path.join(__dirname, 'verify-__KEY__-core.js');
const MUTATIONS = [
  ['two right answers', "{ target: 4, options: [2, 4, 6] }", "{ target: 4, options: [4, 4, 6] }"],
  ['a 0 card', "{ target: 1, options: [2, 1, 3] }", "{ target: 1, options: [0, 1, 3] }"],
  ['a pool of six', "{ target: 3, options: [6, 1, 3] }, { target: 5, options: [1, 3, 5] }]", "]"],
  ['a wrong choice is no miss', "else if (slip === 'wrong') st.misses++;", "else if (false) st.misses++;"],
  ['a new choice keeps the verdict', "st.choice = i; st.checked = null; return true;", "st.choice = i; return true;"],
  ['revealed at miss 1', "function helpLevel(st) { return st.done ? 0 : Math.min(2, st.misses); }", "function helpLevel(st) { return st.done ? 0 : Math.min(2, st.misses + 1); }"],
  ['a finished round can change', "if (!st || st.done || !(i >= 0", "if (!st || !(i >= 0"],
  ['tiny desktop cards', "Math.min(150, Math.floor((W - 80) / 3))", "Math.min(60, Math.floor((W - 80) / 3))"]
];
let killed = 0, survived = 0, faults = 0;
for (const [name, needle, repl] of MUTATIONS) {
  const n = SRC.split(needle).length - 1;
  if (n !== 1) { faults++; console.log(`FAULT  needle found ${n}× — "${name}"`); continue; }
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), '__PFX__-mut-'));
  fs.writeFileSync(path.join(dir, '__KEY__-core.js'), SRC.replace(needle, repl));
  const r = spawnSync(process.execPath, [GATE], { env: Object.assign({}, process.env, { __ENV___CORE_DIR: dir }), timeout: 30000, encoding: 'utf8' });
  const timedOut = r.error && r.error.code === 'ETIMEDOUT';
  /* a gate that fails ONLY on [D]/[E] (unauthored strings or prose) does not count as a kill */
  const coreFails = (r.stdout + r.stderr).split('\n').filter(l => /FAIL:/.test(l) && !/locales authored|narrow no-break|placeholder|page prose|prose number/.test(l));
  if (!timedOut && r.status !== 0 && coreFails.length) { killed++; console.log(`killed    ${name}`); } else { survived++; console.log(`SURVIVED  ${name}${timedOut ? ' (timed out)' : ''}`); }
  fs.rmSync(dir, { recursive: true, force: true });
}
console.log(`mutate-__KEY__: ${killed} killed, ${survived} survived, ${faults} harness faults of ${MUTATIONS.length}`);
process.exit(survived || faults ? 1 : 0);
