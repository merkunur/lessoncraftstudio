  "strings": {
    "G1-309": {
      "title": "Rimord: Finn rimet og skriv ordet",
      "instruction": "Si det første bildet. Sett ring rundt bildet som rimer på det, og skriv ordet på linja."
    },
    "K-352": {
      "title": "Rimer det?",
      "instruction": "Si begge bildene høyt. Hvis de to ordene rimer, setter du ring rundt haken. Hvis ikke, setter du ring rundt krysset."
    },
    "G1-343": {
      "title": "Sorter rimordene",
      "instruction": "Si hvert bilde i ordbanken. Finn det store bildet det rimer på, og skriv ordet på en linje under."
    },
    "G1-344": {
      "title": "Fullfør rimet",
      "instruction": "Les de to linjene høyt. Se på bildet, hør rimet og skriv rimordet som mangler på linja."
    },
    "G1-345": {
      "title": "Rimrekker",
      "instruction": "Si hvert bilde. Finn de to ordene i ordbanken som rimer på det, og skriv dem på linjene. Noen ord passer ingen steder."
    },
    "G1-346": {
      "title": "Skriv dine egne rimord",
      "instruction": "Les ordet ved siden av hvert bilde. Finn på to ord som rimer på det, og skriv ett på hver linje."
    }
  }
}
