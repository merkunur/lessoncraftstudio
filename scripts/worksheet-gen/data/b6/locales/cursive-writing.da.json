  "strings": {
    "G2-377": {
      "title": "Sammenhængende skrift: små bogstaver i, u og t",
      "instruction": "Skriv oven i de grå bogstaver, og skriv så selv hvert bogstav sammenhængende til enden af linjen og på de tomme linjer nedenfor."
    },
    "G2-384": {
      "title": "Store bogstaver i sammenhængende skrift: skriv navnene",
      "instruction": "Skriv oven i de grå store bogstaver og navne, og skriv dem så selv på den tomme linje nedenfor."
    },
    "G2-385": {
      "title": "Sammenhængende skrift: bind bogstaverne sammen",
      "instruction": "Skriv oven i hvert gråt bogstavpar og ord, og skriv dem så selv på den tomme linje nedenfor."
    },
    "G2-386": {
      "title": "Skriv ord med sammenhængende skrift til billederne",
      "instruction": "Skriv oven i hvert gråt ord, skriv det så selv på linjen nedenfor, og sæt prikker og streger til sidst."
    },
    "G2-387": {
      "title": "Læs sammenhængende skrift: find billedet til ordet",
      "instruction": "Læs hvert ord i sammenhængende skrift, og tegn en streg fra ordet til dets billede."
    },
    "G3-401": {
      "title": "Håndskrift 3. klasse: skriv sætninger af med sammenhængende skrift",
      "instruction": "Skriv først oven i den grå sætning, og skriv så hver trykt sætning af med sammenhængende skrift på de to linjer under den."
    }
  }
