  "p01-l01": {
    "en": "Deep in the forest stood the old oak tree, taller than tall.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l02": {
    "en": "Down among its roots, Hazel found a tiny little door.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l03": {
    "en": "\"Look!\" gasped Hazel. \"And up on the hill — a great big door!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l04": {
    "en": "Two doors meant two new neighbors, one big and one tiny.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p01-l05": {
    "en": "\"Let's say hello!\" said Hazel, clapping her paws.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l01": {
    "en": "Hazel packed a welcome basket with warm cookies for the neighbors.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l02": {
    "en": "\"A tiny door needs a tiny cookie,\" said Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l03": {
    "en": "\"The big cookie would never fit through,\" agreed Pip.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-l04": {
    "en": "Which cookie fits through the tiny little door?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l01": {
    "en": "Tiny footprints wound away through the roots, small as raindrops.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l02": {
    "en": "\"So small!\" whispered Hazel. \"Our tiny neighbor came this way.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-l03": {
    "en": "Follow the tiny footprints with your finger!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l01": {
    "en": "But wait — there were more footprints by the path!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l02": {
    "en": "\"Some are big,\" said Pip, \"and some are tiny.\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l03": {
    "en": "\"Our two neighbors walked here together!\" said Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-l04": {
    "en": "Find a big footprint and a tiny footprint!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l01": {
    "en": "Suddenly, a knock boomed across the forest: BOOM, boom, boom!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l02": {
    "en": "\"What a big, deep knock!\" said Pip.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l03": {
    "en": "\"Only a big door could boom like that,\" said Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-l04": {
    "en": "Listen again! Which door made that big sound?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l01": {
    "en": "The neighbors were waiting for their parcels now.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l02": {
    "en": "\"The big parcel goes to the big door,\" said Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l03": {
    "en": "It was heavy and wide — much too big for the tiny door.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-l04": {
    "en": "Can you take the big parcel to the big door?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l01": {
    "en": "One parcel was left — the tiny one, light as a leaf.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l02": {
    "en": "\"It fits the tiny door, of course!\" giggled Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-l03": {
    "en": "Can you bring the tiny parcel to the tiny door?",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l01": {
    "en": "Then, slowly, both doors opened wide at the very same time.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l02": {
    "en": "Out came a big badger and a tiny little mouse!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l03": {
    "en": "\"Hello, big friend! Hello, tiny friend!\" sang Hazel.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p08-l04": {
    "en": "\"Warm cookies for all of you!\" said Pip.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l01": {
    "en": "They all had tea together under the old oak tree.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l02": {
    "en": "There was a big cup for the badger and a tiny cup for the mouse.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l03": {
    "en": "\"Big or tiny,\" said Hazel, \"neighbors are the best!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p09-l04": {
    "en": "\"What a wonderful day,\" said Pip. \"Goodbye!\"",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p02-bravo": {
    "en": "The small cookie slid through the tiny door, just right!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p03-bravo": {
    "en": "The little trail led right back to the tiny door.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p04-bravo": {
    "en": "Big feet and tiny feet, side by side — what good friends!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p05-bravo": {
    "en": "The big door on the hill — what a big, booming knock!",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p06-bravo": {
    "en": "Just right! The big door creaked open, a little bit.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
  "p07-bravo": {
    "en": "It slipped through the tiny door without a single squeeze.",
    "de": "",
    "fr": "",
    "it": "",
    "es": "",
    "pt": "",
    "nl": "",
    "sv": "",
    "da": "",
    "no": "",
    "fi": ""
  },
