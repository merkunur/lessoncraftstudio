  "strings": {
    "K-320": {
      "title": "Ordenstall: Finn plassen i rekka",
      "instruction": "Start ved flagget. Tell til tallet på hver brikke og lag merket som står på den."
    },
    "F1": {
      "title": "Skriv ordenstallene som mangler",
      "instruction": "Noen plasser er skrevet inn. Skriv ordenstallene som mangler i de tomme rutene. Tell fra flagget."
    },
    "F2": {
      "title": "Ordenstall med bokstaver: Tegn strek til bildet",
      "instruction": "Les hvert ordenstall og tegn en strek til bildet som står på den plassen. Tell fra flagget."
    },
    "F3": {
      "title": "Hvilken plass? Skriv ordenstallet",
      "instruction": "Finn hvert lille bilde i rekka si og skriv hvilken plass det står på. Tell fra flagget."
    },
    "F4": {
      "title": "Ordenstall fra begge sider: Start ved flagget",
      "instruction": "Se etter flagget først: Det kan stå på begge sider. Start der, tell til tallet på hver brikke og lag merket."
    },
    "F5": {
      "title": "Hvem vinner løpet? Skriv plassen",
      "instruction": "Se hvor nær mål hver løper er. Den som er nærmest, blir 1. Skriv 1., 2., 3., 4., 5. og 6."
    }
  }
