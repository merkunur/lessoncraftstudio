  "strings": {
    "G1-305": {
      "title": "Tavuta sanat: taputa ja merkitse tavut",
      "instruction": "Sano kuvan sana ja taputa tavut. Piirrä sanaan tavuviiva jokaisen tavun väliin."
    },
    "G1-325": {
      "title": "Tavuta ja kirjoita sana",
      "instruction": "Lue sana kuvan vierestä. Kirjoita se viivalle ja merkitse tavujen väliin tavuviiva."
    },
    "G1-326": {
      "title": "Puuttuva tavu",
      "instruction": "Sano kuvan sana. Yksi tavu puuttuu. Kirjoita puuttuva tavu laatikkoon."
    },
    "G1-327": {
      "title": "Tavusekoitus: järjestä tavut sanaksi",
      "instruction": "Kuvan sanan tavut ovat sekaisin. Lue tavut, laita ne oikeaan järjestykseen ja kirjoita sana viivalle."
    },
    "G1-328": {
      "title": "Kaksi vai kolme tavua? Tavuta ja lajittele",
      "instruction": "Taputa jokaisen sanapankin sanan tavut. Kirjoita sana tavuviivoineen kahden tai kolmen tavun sarakkeeseen."
    },
    "G1-329": {
      "title": "Tavun vokaali: jokaisessa tavussa yksi",
      "instruction": "Jokaisessa tavussa on yksi vokaaliäänne. Katso malli ja piirrä piste vokaalin kohdalle jokaisen tavukaaren sisään."
    }
  }
