  "strings": {
    "G2-318": {
      "title": "Faktaark om dyr: {U}",
      "instruction": "Finn ut hva du vet om dette dyret. Skriv ett faktum i hver rad på faktaarket, og fyll resten av siden med tegning eller ord."
    },
    "G2-339": {
      "title": "Faktaark om {U}: Kryss av det som stemmer",
      "instruction": "Les valgene i hver rad og sett ring rundt det som stemmer for dette dyret. Tegn så hvor det lever, og fullfør setningen."
    },
    "G2-340": {
      "title": "Faktaark om {U} med ordbank",
      "instruction": "Finn hvert riktige faktum i ordbanken og skriv det i riktig rad på faktaarket. Fullfør så setningen nederst."
    },
    "G2-341": {
      "title": "Faktaark om {U}: Skriv tre setninger",
      "instruction": "Les faktaarket. Fullfør de tre setningene med fakta fra det, og skriv ett faktum til på den siste linja."
    },
    "G2-342": {
      "title": "Sammenlign to dyr: Likt og ulikt",
      "instruction": "Les begge faktaarkene. Sett ring rundt likt eller ulikt for hvert faktum. Skriv så to ting som er like, og to som er ulike."
    },
    "G2-343": {
      "title": "Hvem er jeg? Mystisk dyr",
      "instruction": "Les de fem ledetrådene på hvert kort. Finn dyret i bildebanken, skriv navnet på linja og tegn det i boksen."
    }
  }
