  "strings": {
    "base": {
      "title": "Synonymer: find ordet, der betyder det samme",
      "instruction": "Læs det store ord på hvert kort, og sæt ring om det ord under det, der betyder det samme."
    },
    "pictures": {
      "title": "Synonymer med billeder: to ord, ét billede",
      "instruction": "Se på hvert billede, og sæt ring om de to ord under det, som betyder det samme og passer til billedet."
    },
    "pairs": {
      "title": "Synonymer: forbind ordparrene",
      "instruction": "Tegn en streg fra hvert ord til venstre til det ord til højre, der betyder det samme."
    },
    "shades": {
      "title": "Ord efter styrke: fra lidt til meget",
      "instruction": "Læs de tre ord i hver række, og skriv 1, 2 og 3 i felterne, fra det svageste ord til det stærkeste."
    },
    "say": {
      "title": "Andre ord for »siger«: vælg det ord, der passer",
      "instruction": "Læs hver sætning, og skriv det ord fra taleboblen, der passer bedst, i feltet i stedet for »siger«."
    },
    "fields": {
      "title": "Ordfelter: ord for »gå« og »se«",
      "instruction": "Læs de ti ord, og skriv hvert ord i feltet for det ord, det betyder næsten det samme som."
    }
  }
