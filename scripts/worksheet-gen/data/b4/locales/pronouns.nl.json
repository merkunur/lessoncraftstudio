  "strings": {
    "base": {
      "title": "Hij, zij of het: persoonlijke voornaamwoorden",
      "instruction": "Kijk naar het plaatje en lees het woord eronder. Omcirkel het woord dat we in plaats daarvan zeggen."
    },
    "replace": {
      "title": "Vervang de naam door een voornaamwoord",
      "instruction": "Lees de zin. Schrijf het woord uit het kader dat in de tweede zin de naam vervangt in het vakje.",
      "bankWord": "kader"
    },
    "possessive": {
      "title": "Bezittelijke voornaamwoorden: zijn, haar of hun",
      "instruction": "Kijk van wie het ding is. Omcirkel het woord dat bij die persoon hoort."
    },
    "anaphora": {
      "title": "Wie wordt bedoeld? Voornaamwoorden in de zin",
      "instruction": "Lees de zinnen. Trek een lijn van elk woord in het vak naar de naam waarvoor het staat."
    },
    "sort": {
      "title": "Namen sorteren: hij, zij of het",
      "instruction": "Lees elke kaart. Schrijf het woord van de kaart onder het woord dat we ervoor zeggen."
    },
    "rewrite": {
      "title": "Schrijf de zin opnieuw met een voornaamwoord",
      "instruction": "Lees de zin. Schrijf hem opnieuw op de lijnen, maar zet een voornaamwoord in plaats van de naam."
    }
  }
