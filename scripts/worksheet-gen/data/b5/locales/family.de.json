  "strings": {
    "base": {
      "title": "Familienmitglieder: Wer ist wer?",
      "instruction": "Finde jede Person im Stammbaum und schreibe ihre Zahl in das Kästchen neben ihrem Familienwort."
    },
    "generations": {
      "title": "Generationen in der Familie: von Alt nach Jung",
      "instruction": "Schreibe in jeder Reihe 1, 2 und 3 in die Kästchen, von der ältesten Generation bis zur jüngsten."
    },
    "trace-words": {
      "title": "Familienwörter nachspuren und schreiben",
      "instruction": "Spure jedes Familienwort nach und schreibe es auf die Linie mit der Zahl der passenden Person im Stammbaum."
    },
    "tree-clues": {
      "title": "Stammbaum ausfüllen: Namen mit Hinweisen eintragen",
      "instruction": "Lies die Hinweise und schreibe jeden Namen in das richtige Namensfeld im Stammbaum."
    },
    "relation-riddles": {
      "title": "Verwandtschaft in der Familie: Rätsel",
      "instruction": "Lies jedes Rätsel und schreibe das passende Familienwort aus dem Kasten auf die Linie, ein Wort kann zu mehreren Rätseln passen."
    },
    "tree-template": {
      "title": "Stammbaum-Vorlage für Kinder zum Ausfüllen",
      "instruction": "Zeichne die Menschen, die dir wichtig sind, in die Rahmen und schreibe ihre Namen auf die Linien."
    }
  }
