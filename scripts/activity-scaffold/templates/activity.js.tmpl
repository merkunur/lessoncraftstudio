    hintStart:   {en:'TODO hintStart',de:'TODO',fr:'TODO',es:'TODO',pt:'TODO',it:'TODO',nl:'TODO',sv:'TODO',da:'TODO',no:'TODO',fi:'TODO'},
    hintLook:    {en:'TODO hintLook (miss 1)',de:'TODO',fr:'TODO',es:'TODO',pt:'TODO',it:'TODO',nl:'TODO',sv:'TODO',da:'TODO',no:'TODO',fi:'TODO'},
    hintShow:    {en:'TODO hintShow (miss 2)',de:'TODO',fr:'TODO',es:'TODO',pt:'TODO',it:'TODO',nl:'TODO',sv:'TODO',da:'TODO',no:'TODO',fi:'TODO'},
