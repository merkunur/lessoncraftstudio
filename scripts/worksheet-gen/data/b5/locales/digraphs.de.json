      "title": "Buchstabengruppen sch, ch, au: Welche hörst du?",
      "instruction": "Sprich den Namen jedes Bildes und kreise die Buchstabengruppe ein, die du hörst."
    },
    "sort-two": {
      "title": "Buchstabengruppen sortieren: sch oder au",
      "instruction": "Sprich den Namen jedes Bildes und verbinde es mit einer Linie mit der Buchstabengruppe, die du hörst."
    },
    "gap": {
      "title": "Fehlende Buchstabengruppe einsetzen: sch, ch oder au",
      "instruction": "Sprich jedes Bildwort und schreibe die fehlende Buchstabengruppe von oben in das gestrichelte Feld."
    },
    "match": {
      "title": "Wörter mit sch, ch und au lesen und zuordnen",
      "instruction": "Lies jedes Wort, die Buchstabengruppe ist markiert, und verbinde es mit einer Linie mit dem passenden Bild."
    },
    "position": {
      "title": "Wo hörst du sch, ch oder au im Wort?",
      "instruction": "Sprich jedes Bildwort und male das Feld an, wo du die Buchstabengruppe hörst: am Anfang, in der Mitte oder am Ende."
    },
    "text": {
      "title": "Wörter mit sch in Sätzen finden und zählen",
      "instruction": "Lies die Sätze, kreise jedes sch ein und schreibe in das Kästchen, wie oft es im Satz vorkommt."
