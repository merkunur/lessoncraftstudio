    "base": {
      "title": "Pitkä vokaali aa, uu vai ää: mikä kuuluu sanassa?",
      "instruction": "Sano jokaisen kuvan nimi ja rengasta se pitkä vokaali, jonka kuulet."
    },
    "sort-two": {
      "title": "Pitkä vokaali: lajittele kuvat, aa vai uu?",
      "instruction": "Sano jokaisen kuvan nimi ja yhdistä se viivalla siihen pitkään vokaaliin, jonka kuulet."
    },
    "gap": {
      "title": "Kirjoita puuttuva pitkä vokaali: aa, uu vai ää",
      "instruction": "Sano jokaisen kuvan sana ja kirjoita ylhäältä puuttuva pitkä vokaali katkoviivalla merkittyyn kohtaan."
    },
    "match": {
      "title": "Pitkä vokaali: lue sanat ja yhdistä kuviin",
      "instruction": "Lue jokainen sana, jonka pitkä vokaali on merkitty, ja yhdistä se viivalla oikeaan kuvaan."
    },
    "position": {
      "title": "Missä kohdassa pitkä vokaali kuuluu?",
      "instruction": "Sano kuvan sana ja väritä alku, jos sana alkaa pitkällä vokaalilla, loppu, jos se loppuu siihen, ja muuten keskikohta."
    },
    "text": {
      "title": "Pitkät vokaalit lauseissa: etsi ja laske aa",
      "instruction": "Lue lauseet, rengasta jokainen aa ja kirjoita ruutuun, montako niitä on kussakin lauseessa."
    }
