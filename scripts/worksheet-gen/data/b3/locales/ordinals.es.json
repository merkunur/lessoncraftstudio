  "strings": {
    "K-320": {
      "title": "Números ordinales: encuentra el lugar",
      "instruction": "Empieza en la bandera. Cuenta hasta el número de cada ficha y haz la marca que indica."
    },
    "F1": {
      "title": "Escribe los números ordinales que faltan",
      "instruction": "Algunos lugares ya están escritos. Escribe los ordinales que faltan en las casillas vacías, contando desde la bandera."
    },
    "F2": {
      "title": "Ordinales en palabras: une con el dibujo",
      "instruction": "Lee cada palabra ordinal y traza una línea hasta el dibujo que ocupa ese lugar, contando desde la bandera."
    },
    "F3": {
      "title": "¿En qué lugar está? Escribe el ordinal",
      "instruction": "Busca cada dibujo pequeño en su fila y escribe en qué lugar está, contando desde la bandera."
    },
    "F4": {
      "title": "Ordinales desde los dos lados: empieza en la bandera",
      "instruction": "Busca primero la bandera: puede estar en cualquiera de los dos extremos. Empieza ahí, cuenta hasta el número de cada ficha y haz la marca."
    },
    "F5": {
      "title": "¿Quién gana la carrera? Escribe el lugar",
      "instruction": "Mira qué tan cerca de la meta está cada corredor. El más cercano es el 1.º. Escribe 1.º, 2.º, 3.º, 4.º, 5.º y 6.º."
    }
  }
