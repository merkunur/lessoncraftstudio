  "blankTitle": "Tomt faktakort",
  "strings": {
    "G2-318": {
      "title": "Faktakort om dyr: {U}",
      "instruction": "Find ud af noget om dyret. Skriv én oplysning i hver række på faktakortet, og fyld resten af siden med din egen tegning eller dine egne ord."
    },
    "G2-339": {
      "title": "Faktakort om {U}: sæt ring om det rigtige",
      "instruction": "Læs mulighederne i hver række, og sæt ring om den, der passer på dyret. Tegn så, hvor det bor, og gør sætningen færdig."
    },
    "G2-340": {
      "title": "Faktakort med ordbank: {U}",
      "instruction": "Find hver rigtig oplysning i ordbanken, og skriv den i den rigtige række på faktakortet. Gør så sætningen nederst færdig."
    },
    "G2-341": {
      "title": "Faktakort: skriv tre sætninger om {U}",
      "instruction": "Læs faktakortet. Gør de tre sætninger færdige med oplysninger fra det, og skriv så én oplysning mere selv på den sidste linje."
    },
    "G2-342": {
      "title": "Sammenlign to dyr: ens og forskelligt",
      "instruction": "Læs begge faktakort. Sæt ring om ens eller forskelligt ved hver oplysning. Skriv så to ting, der er ens, og to, der er forskellige."
    },
    "G2-343": {
      "title": "Hvem er jeg? Det hemmelige dyr",
      "instruction": "Læs de fem spor på hvert kort. Find dyret i billedbanken, skriv dets navn på linjen, og tegn det i kassen."
    }
  }
