  "strings": {
    "G2-377": {
      "title": "Schreibschrift üben: i, u und t in {U}",
      "instruction": "Spure die grauen Buchstaben nach und schreibe dann jeden Buchstaben verbunden allein bis zum Ende der Zeile und in der leeren Zeile darunter."
    },
    "G2-384": {
      "title": "Großbuchstaben in {U}",
      "instruction": "Spure jeden grauen Großbuchstaben und den Namen nach und schreibe beides in die leere Zeile darunter."
    },
    "G2-385": {
      "title": "Buchstabenverbindungen in {U}",
      "instruction": "Spure jede graue Buchstabenverbindung und das Wort nach und schreibe beides in die leere Zeile darunter."
    },
    "G2-386": {
      "title": "Schreibschrift-Wörter zu Bildern in {U}",
      "instruction": "Spure jedes graue Wort nach, verbinde zuerst die Buchstaben und setze zum Schluss Punkte und Striche, dann schreibe es genauso auf die Zeile darunter."
    },
    "G2-387": {
      "title": "Schreibschrift lesen: Wörter in {U}",
      "instruction": "Lies jedes Wort in Schreibschrift und verbinde es mit seinem Bild."
    },
    "G3-401": {
      "title": "Sätze in {U} abschreiben",
      "instruction": "Spure den grauen Satz nach und schreibe dann jeden gedruckten Satz in Schreibschrift auf die zwei Zeilen darunter."
    }
  }
