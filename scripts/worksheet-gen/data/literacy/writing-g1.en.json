   {
    "key": "outside",
    "title": "Fun Outside",
    "s": [
     {
      "t": "We went out to play after lunch.",
      "cap": 1,
      "end": 1
     },
     {
      "t": "I found a bug by the fence.",
      "detail": 1,
      "q": "What color was the bug?",
      "a": "I found a green bug by the fence.",
      "also": "Any color word is right."
     },
     {
      "t": "Leo and I looked at it.",
      "i": 1
     },
     {
      "t": "The bug crawled under a leaf.",
      "cap": 1,
      "end": 1
     },
     {
      "t": "Then, we showed the leaf to Omar.",
      "name": "Omar"
     }
    ]
   },
   {
