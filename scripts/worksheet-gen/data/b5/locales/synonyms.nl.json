  "strings": {
    "base": {
      "title": "Synoniemen: omcirkel het woord dat hetzelfde betekent",
      "instruction": "Lees het grote woord op elke kaart en omcirkel daaronder het woord dat hetzelfde betekent."
    },
    "pictures": {
      "title": "Synoniemen met plaatjes: twee woorden, één plaatje",
      "instruction": "Kijk naar elk plaatje en omcirkel daaronder de twee woorden die hetzelfde betekenen en bij het plaatje passen."
    },
    "pairs": {
      "title": "Synoniemen koppelen: woordparen met dezelfde betekenis",
      "instruction": "Trek een lijn van elk woord links naar het woord rechts dat hetzelfde betekent."
    },
    "shades": {
      "title": "Woorden op sterkte zetten: van een beetje tot heel erg",
      "instruction": "Lees de drie woorden in elke rij en schrijf 1, 2 en 3 in de vakjes, van het zwakste naar het sterkste woord."
    },
    "say": {
      "title": "Andere woorden voor ‘zegt’: kies het woord dat past",
      "instruction": "Lees elke zin en schrijf in het vakje het woord uit het wolkje dat daar het best past in plaats van ‘zegt’."
    },
    "fields": {
      "title": "Woorden voor ‘gaan’ en ‘kijken’ sorteren",
      "instruction": "Lees de tien woorden en schrijf elk woord in het vak van het woord dat bijna hetzelfde betekent."
    }
  }
}
