  "strings": {
    "G1-307": {
      "title": "I contrari: scrivi la parola contraria",
      "instruction": "Leggi la parola su ogni cartellino. Cerca il suo contrario nella scatola delle parole e scrivilo sulla riga."
    },
    "K-351": {
      "title": "I contrari con i disegni: collega gli opposti",
      "instruction": "Traccia una linea da ogni disegno al disegno e alla parola che mostrano il suo contrario."
    },
    "G1-335": {
      "title": "I contrari nella frase",
      "instruction": "Leggi ogni frase. Sulla riga scrivi il contrario della parola che viene dopo \"non\". La scatola delle parole ti aiuta."
    },
    "G1-336": {
      "title": "Forma le coppie di contrari",
      "instruction": "Trova le due parole che sono contrarie. Scrivi ogni coppia su una riga, una parola da ogni lato della freccia."
    },
    "G1-337": {
      "title": "Sinonimi e contrari: cerchia il contrario",
      "instruction": "Leggi la parola. Fra le tre parole sotto, una vuol dire il contrario. Cerchia quella, non quella che vuol dire la stessa cosa."
    },
    "G2-320": {
      "title": "I contrari con i prefissi in-, s- e dis-",
      "instruction": "Aggiungi il prefisso a ogni parola e scrivi sulla riga la nuova parola, che vuol dire il contrario."
    }
  }
