    "K-319": {
      "title": "Känslor: para ihop ansiktet med ordet",
      "instruction": "Dra ett streck från varje ansikte till det känsloord som visar hur det känner sig."
    },
    "K-331": {
      "title": "Hur känner du dig? Ringa in ansiktet",
      "instruction": "Titta på bilden. Tänk efter hur du skulle känna dig då och ringa in det ansikte som passar."
    },
    "K-332": {
      "title": "Rita känslan i ansiktet",
      "instruction": "Läs känsloordet och rita ett ansikte som visar den känslan i den tomma cirkeln."
    },
    "K-333": {
      "title": "Känns bra eller känns dåligt? Sortera ansiktena",
      "instruction": "Dra ett streck från varje ansikte till den ruta som visar om känslan känns bra eller dåligt."
    },
    "K-334": {
      "title": "Vilket ansikte visar känslan?",
      "instruction": "Läs känsloordet och ringa in det ansikte i raden som visar just den känslan."
    },
    "K-335": {
      "title": "Hur känner jag mig i dag?",
      "instruction": "Ringa in det ansikte som visar hur du känner dig i dag. Rita sedan ditt eget ansikte."
    }
